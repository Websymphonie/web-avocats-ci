{
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3",
    "ext-bcmath": "*",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-iconv": "*",
    "ext-pdo": "*",
    "beberlei/doctrineextensions": "^1.1",
    "doctrine/dbal": "^4.4.x-dev",
    "doctrine/doctrine-bundle": "^2.11",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^3.5",
    "dragonmantank/cron-expression": "^3.4",
    "gedmo/doctrine-extensions": "^3.14",
    "google/cloud-vision": "^2.1",
    "intervention/image": "^3.7",
    "jms/serializer-bundle": "^5.5",
    "kkiapay/kkiapay-php": "dev-master",
    "knplabs/doctrine-behaviors": "^3.1",
    "knplabs/knp-paginator-bundle": "^6.3",
    "knplabs/knp-time-bundle": "^2.4",
    "kornrunner/blurhash": "^1.2",
    "kwn/number-to-words": "*",
    "liip/imagine-bundle": "^2.12",
    "nucleos/dompdf-bundle": "*",
    "openspout/openspout": "^4.32",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpoffice/phpspreadsheet": "^2.2",
    "phpstan/phpdoc-parser": "^2.1",
    "stof/doctrine-extensions-bundle": "^1.10",
    "symfony/apache-pack": "^1.0",
    "symfony/asset": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/doctrine-messenger": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/expression-language": "7.4.*",
    "symfony/flex": "^2",
    "symfony/form": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/html-sanitizer": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/intl": "7.4.*",
    "symfony/joli-notif-notifier": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/mime": "7.4.*",
    "symfony/monolog-bundle": "^3.10",
    "symfony/notifier": "7.4.*",
    "symfony/process": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/scheduler": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/stimulus-bundle": "^2.18",
    "symfony/string": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/uid": "7.4.*",
    "symfony/ux-autocomplete": "^2.24",
    "symfony/ux-chartjs": "^2.18",
    "symfony/ux-icons": "^2.24",
    "symfony/ux-live-component": "^2.19",
    "symfony/ux-react": "^2.27",
    "symfony/ux-twig-component": "^2.17",
    "symfony/validator": "7.4.*",
    "symfony/web-link": "7.4.*",
    "symfony/webhook": "7.4.*",
    "symfony/webpack-encore-bundle": "^2.1",
    "symfony/workflow": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfonycasts/dynamic-forms": "^0.1.3",
    "symfonycasts/verify-email-bundle": "^1.17",
    "tales-from-a-dev/twig-tailwind-extra": "^1.0.0",
    "twig/extra-bundle": "^3.24",
    "twig/html-extra": "^3.12.0",
    "twig/intl-extra": "*",
    "twig/string-extra": "^3.8",
    "twig/twig": "^2.12|^3.0",
    "vich/uploader-bundle": "^2.3"
  },
  "config": {
    "process-timeout": 600,
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Websymphonie\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Websymphonie\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*"
  },
  "scripts": {
    "check": [
      "@check-container",
      "@check-twig",
      "@check-yaml",
      "@prepare"
    ],
    "phpstan": "phpstan analyse",
    "check-container": [
      "php bin/console lint:container"
    ],
    "check-twig": [
      "php bin/console lint:twig templates/"
    ],
    "check-yaml": [
      "php bin/console lint:yaml config/ --parse-tags"
    ],
    "prepare": [
      "php bin/console doctrine:schema:valid -n"
    ],
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "fakerphp/faker": "^1.24",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^9.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/debug-bundle": "7.4.*",
    "symfony/maker-bundle": "^1.0",
    "symfony/phpunit-bridge": "^7.0",
    "symfony/stopwatch": "7.4.*",
    "symfony/ux-toolkit": "^2.36",
    "symfony/web-profiler-bundle": "7.4.*"
  }
}
