{{ form_start(form, {'action': urlPath, 'attr': {'class': 'space-y-5', 'enctype': 'multipart/form-data', 'data-loading-label': 'Téléversement…'}}) }}
    <div class="rounded-xl border border-border bg-muted/40 p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Emplacement</p>
        <p class="mt-1 text-sm font-semibold">{{ command.label }}</p>
        <p class="mt-1 font-mono text-xs text-muted-foreground">{{ command.name }}</p>
    </div>
    <div class="space-y-2">
        {{ form_label(form.imageFile, 'Nouveau fichier', {'label_attr': {'class': 'text-sm font-medium'}}) }}
        {{ form_widget(form.imageFile, {'attr': {'class': 'block w-full rounded-lg border border-input bg-background text-sm file:mr-4 file:border-0 file:bg-muted file:px-4 file:py-2.5 file:text-sm file:font-medium hover:file:bg-muted/80', 'accept': 'image/jpeg,image/png,image/webp,image/svg+xml'}}) }}
        <p class="text-xs text-muted-foreground">JPEG, PNG, WebP ou SVG, jusqu’à 5 Mo.</p>
        <div class="text-sm text-destructive">{{ form_errors(form.imageFile) }}</div>
    </div>
    <div class="flex justify-end gap-2 border-t border-border pt-5">
        <button class="inline-flex h-10 items-center rounded-lg border border-border px-4 text-sm font-medium hover:bg-muted" type="button" data-action="click->modal#close">Annuler</button>
        <button class="inline-flex h-10 items-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Remplacer l’image</button>
    </div>
{{ form_end(form) }}
