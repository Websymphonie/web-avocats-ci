<div>
    {{ form_start(form, {
        attr: {
            class: 'space-y-6',
            'data-turbo': 'false',
            'data-loading-label': 'Enregistrement…'
        }
    }) }}

    {% set activeField = form.active %}

    <div class="flex items-center justify-between gap-6 rounded-lg border border-border p-4">
        <div class="space-y-1">
            <twig:Label for="{{ activeField.vars.id }}" class="text-sm font-medium">
                Activer le mode maintenance
            </twig:Label>

            <p class="text-sm leading-relaxed text-muted-foreground">
                Lorsque cette option est activée, les visiteurs ne peuvent plus
                accéder normalement à l’application.
            </p>

            {% if activeField.vars.errors|length > 0 %}
                <div class="text-sm text-destructive">
                    {{ form_errors(activeField) }}
                </div>
            {% endif %}
        </div>

        <div class="shrink-0">
            <twig:Switch
                    id="{{ activeField.vars.id }}"
                    name="{{ activeField.vars.full_name }}"
                    value="1"
                    :checked="activeField.vars.checked"
                    aria-label="Activer le mode maintenance"
            />
        </div>
    </div>

    {#
    Le champ active a été rendu manuellement avec le Switch.
    On empêche Symfony de générer une seconde checkbox.
    #}
    {% do activeField.setRendered %}

    {#
    form_rest génère notamment le token CSRF.
    #}
    {{ form_rest(form) }}

    <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <twig:Button
                type="button"
                variant="outline"
                data-action="click->modal#close"
        >
            Annuler
        </twig:Button>

        <twig:Button type="submit">
            Enregistrer
        </twig:Button>
    </div>

    {{ form_end(form, {
        render_rest: false
    }) }}
</div>
