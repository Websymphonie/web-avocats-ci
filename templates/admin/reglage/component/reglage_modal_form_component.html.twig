{{ form_start(form, {'action': urlPath, 'attr': {'class': 'space-y-5', 'data-loading-label': 'Enregistrement…'}}) }}
    <div class="rounded-xl border border-border bg-muted/40 p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Paramètre</p>
        <p class="mt-1 text-sm font-semibold">{{ command.label }}</p>
    </div>
    <div class="space-y-2">
        {{ form_label(form.value, command.label, {'label_attr': {'class': 'text-sm font-medium'}}) }}
        {{ form_widget(form.value, {'attr': {'class': 'flex min-h-10 w-full rounded-lg border border-input bg-background px-3 py-2 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}
        {{ form_help(form.value, {'help_attr': {'class': 'text-xs text-muted-foreground'}}) }}
        <div class="text-sm text-destructive">{{ form_errors(form.value) }}</div>
    </div>
    <div class="flex justify-end gap-2 border-t border-border pt-5">
        <button class="inline-flex h-10 items-center rounded-lg border border-border px-4 text-sm font-medium hover:bg-muted" type="button" data-action="click->modal#close">Annuler</button>
        <button class="inline-flex h-10 items-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Enregistrer</button>
    </div>
{{ form_end(form) }}
