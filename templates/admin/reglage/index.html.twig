{% extends 'layouts/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-7xl space-y-6">
        {{ component('Breadcrumbs', {'breadcrumbs': breadcrumbs}) }}
        <section class="rounded-2xl border border-border bg-card p-6 shadow-sm"><p class="text-sm font-medium text-muted-foreground">Configuration de l’installation</p><h1 class="mt-1 text-2xl font-semibold tracking-[-0.03em]">Réglages de l’application</h1><p class="mt-2 text-sm text-muted-foreground">Personnalisez les valeurs utilisées par cette instance cliente.</p></section>
        <details class="group rounded-2xl border border-border bg-card shadow-sm" {% if app.request.query.all|length > 0 %}open{% endif %}><summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-sm font-medium marker:hidden"><span>Rechercher un réglage</span><span class="text-muted-foreground">⌄</span></summary><div class="border-t border-border px-6 py-5">{{ form_start(form, {'attr': {'class': 'flex flex-col gap-3 sm:flex-row sm:items-end', 'data-loading-label': 'Recherche…'}}) }}<div class="flex-1 space-y-2">{{ form_label(form.value, null, {'label_attr': {'class': 'text-sm font-medium'}}) }}{{ form_widget(form.value, {'attr': {'class': 'flex h-10 w-full rounded-lg border border-input bg-background px-3 text-sm shadow-xs outline-none', 'placeholder': 'Rechercher par valeur'}}) }}</div><button class="inline-flex h-10 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Rechercher</button><a class="inline-flex h-10 items-center justify-center rounded-lg px-3 text-sm font-medium text-muted-foreground hover:bg-muted" href="{{ path('admin_reglages_index') }}">Réinitialiser</a>{{ form_end(form) }}</div></details>
        <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm"><div class="border-b border-border px-6 py-4"><h2 class="text-sm font-semibold">Paramètres disponibles</h2><p class="mt-1 text-sm text-muted-foreground">{{ reglages.totalItemCount }} réglage{{ reglages.totalItemCount > 1 ? 's' : '' }}</p></div><div class="divide-y divide-border">
        {% for reglage in reglages.items %}<div class="flex flex-col gap-4 px-6 py-5 transition-colors hover:bg-muted/40 sm:flex-row sm:items-center sm:justify-between"><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><h3 class="font-medium">{{ reglage.label }}</h3><span class="rounded-full bg-muted px-2 py-0.5 font-mono text-[11px] text-muted-foreground">{{ reglage.name }}</span></div><p class="mt-2 break-words text-sm text-muted-foreground">Valeur actuelle : <span class="font-medium text-foreground">{{ reglage.displayValue ?? 'Non renseignée' }}</span></p><p class="mt-1 text-xs text-muted-foreground">Mis à jour {{ reglage.updatedAt ? reglage.updatedAt|ago : 'à une date inconnue' }}</p></div>{% if is_granted('ROLE_EDIT') %}<twig:ActionDropdown><button type="button" data-action="click->modal#open" data-modal-id-param="edit-reglage-{{ reglage.id }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</button></twig:ActionDropdown>{% endif %}</div>{% else %}<div class="px-6 py-14 text-center text-muted-foreground">Aucun réglage ne correspond à votre recherche.</div>{% endfor %}
        </div>{% include 'shared/views/_list_pagination.html.twig' with {pager: reglages, route: 'admin_reglages_index'} only %}</section>
    </div></main>
    {% if is_granted('ROLE_EDIT') %}{% for reglage in reglages.items %}<twig:AppModal id="edit-reglage-{{ reglage.id }}" title="Modifier un réglage" description="La nouvelle valeur sera appliquée à cette installation.">{{ component('ReglagesModalFormComponent', {reglage: reglage, id: 'edit-reglage-' ~ reglage.id, title: reglage.label, urlPath: path('admin_reglages_update', {id: reglage.id})}) }}</twig:AppModal>{% endfor %}{% endif %}
{% endblock %}
