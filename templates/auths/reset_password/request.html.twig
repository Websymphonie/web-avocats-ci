{% extends 'layouts/auth.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block auth_content %}
    <section class="w-full max-w-md" aria-labelledby="request-title">
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
            <a class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground" href="{{ path('app_login') }}">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
                Retour à la connexion
            </a>

            <div class="mt-7">
                <span class="mb-5 flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16v10H4z"></path><path d="m4 8 8 5 8-5"></path></svg>
                </span>
                <p class="text-sm font-medium text-muted-foreground">Accès au compte</p>
                <h1 id="request-title" class="mt-2 text-2xl font-semibold tracking-[-0.03em]">Mot de passe oublié&nbsp;?</h1>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">Indiquez votre adresse e-mail. Nous vous enverrons un lien de réinitialisation si un compte lui est associé.</p>
            </div>

            {{ form_start(requestForm, {'attr': {'class': 'mt-7 space-y-5', 'data-loading-label': 'Envoi…'}}) }}
                <div class="space-y-2">
                    <label class="text-sm font-medium" for="{{ requestForm.email.vars.id }}">Adresse e-mail</label>
                    {{ form_widget(requestForm.email, {'attr': {
                        'class': 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm shadow-xs outline-none transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30',
                        'autocomplete': 'email',
                        'autofocus': 'autofocus'
                    }}) }}
                    {% for error in requestForm.email.vars.errors %}
                        <p class="text-sm text-destructive" role="alert">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <button class="inline-flex h-11 w-full items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50" type="submit">
                    Envoyer le lien de réinitialisation
                </button>
            {{ form_end(requestForm) }}

            <p class="mt-5 text-center text-xs leading-5 text-muted-foreground">Pour protéger les comptes, nous affichons toujours la même confirmation, que l’adresse soit enregistrée ou non.</p>
        </div>
    </section>
{% endblock %}
