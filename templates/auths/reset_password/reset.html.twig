{% extends 'layouts/auth.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block auth_content %}
    <section class="w-full max-w-md" aria-labelledby="reset-title">
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
            <div>
                <span class="mb-5 flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
                </span>
                <p class="text-sm font-medium text-muted-foreground">Sécurisez votre compte</p>
                <h1 id="reset-title" class="mt-2 text-2xl font-semibold tracking-[-0.03em]">Créez un nouveau mot de passe</h1>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">Choisissez un mot de passe unique que vous n’utilisez pas ailleurs.</p>
            </div>

            {{ form_start(resetForm, {'attr': {'class': 'mt-7 space-y-5', 'data-loading-label': 'Enregistrement…'}}) }}
                <div class="space-y-2">
                    <label class="text-sm font-medium" for="{{ resetForm.password.vars.id }}">Nouveau mot de passe</label>
                    <div class="toggle-password-container">
                        {{ form_widget(resetForm.password, {'attr': {
                            'class': 'flex h-11 w-full rounded-lg border border-input bg-background px-3 pr-24 text-sm shadow-xs outline-none transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30',
                            'autocomplete': 'new-password',
                            'autofocus': 'autofocus'
                        }}) }}
                    </div>
                    {% for error in resetForm.password.vars.errors %}
                        <p class="text-sm text-destructive" role="alert">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <div class="space-y-2">
                    <label class="text-sm font-medium" for="{{ resetForm.confirmPassword.vars.id }}">Confirmer le mot de passe</label>
                    <div class="toggle-password-container">
                        {{ form_widget(resetForm.confirmPassword, {'attr': {
                            'class': 'flex h-11 w-full rounded-lg border border-input bg-background px-3 pr-24 text-sm shadow-xs outline-none transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30',
                            'autocomplete': 'new-password'
                        }}) }}
                    </div>
                    {% for error in resetForm.confirmPassword.vars.errors %}
                        <p class="text-sm text-destructive" role="alert">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <button class="inline-flex h-11 w-full items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50" type="submit">
                    Enregistrer le nouveau mot de passe
                </button>
            {{ form_end(resetForm) }}

            <div class="mt-5 rounded-xl border border-border bg-muted/40 px-4 py-3">
                <p class="text-xs font-medium text-foreground">Un mot de passe robuste contient au moins 12 caractères.</p>
                <p class="mt-1 text-xs leading-5 text-muted-foreground">Utilisez une phrase unique et évitez les informations personnelles faciles à deviner.</p>
            </div>
        </div>
    </section>
{% endblock %}
