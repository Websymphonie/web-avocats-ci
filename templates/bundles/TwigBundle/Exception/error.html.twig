{% extends 'layouts/error.html.twig' %}

{% block title %}Erreur {{ statusCode|default(500) }}{% endblock %}

{% block error_content %}
    <section class="relative overflow-hidden rounded-3xl border border-border bg-card p-7 shadow-xl shadow-black/5 sm:p-10 lg:p-12">
        <span class="pointer-events-none absolute -right-4 -top-12 select-none text-[10rem] font-bold leading-none tracking-[-0.08em] text-muted/60 sm:text-[14rem]">{{ statusCode|default(500) }}</span>
        <div class="relative max-w-xl">
            <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-destructive/10 text-destructive">
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v6M12 17h.01"></path></svg>
            </span>
            <p class="mt-7 text-sm font-medium text-muted-foreground">Erreur {{ statusCode|default(500) }}</p>
            <h1 class="mt-2 text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">Un imprévu nous empêche d’afficher cette page.</h1>
            <p class="mt-5 max-w-lg text-sm leading-7 text-muted-foreground">L’incident a été interrompu proprement. Réessayez dans quelques instants ou revenez à votre espace de travail.</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a class="inline-flex h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground shadow-xs hover:bg-primary/90" href="{{ path(app.user ? 'app_admin' : 'app_login') }}">{{ app.user ? 'Retour au tableau de bord' : 'Retour à l’accueil' }}</a>
                <button class="inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-5 text-sm font-medium hover:bg-muted" type="button" onclick="window.location.reload()">Réessayer</button>
            </div>
        </div>
    </section>
{% endblock %}
