{% extends 'layouts/error.html.twig' %}

{% block title %}Page introuvable{% endblock %}

{% block error_content %}
    <section class="relative overflow-hidden rounded-3xl border border-border bg-card p-7 shadow-xl shadow-black/5 sm:p-10 lg:p-12">
        <span class="pointer-events-none absolute -right-4 -top-12 select-none text-[10rem] font-bold leading-none tracking-[-0.08em] text-muted/60 sm:text-[14rem]">404</span>
        <div class="relative max-w-xl">
            <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4M8.5 11h5M11 8.5v5"></path></svg>
            </span>
            <p class="mt-7 text-sm font-medium text-muted-foreground">Erreur 404</p>
            <h1 class="mt-2 text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">Cette adresse ne mène à aucune page.</h1>
            <p class="mt-5 max-w-lg text-sm leading-7 text-muted-foreground">Le contenu a peut-être été déplacé, supprimé ou l’adresse contient une erreur. Revenez à votre espace pour poursuivre votre travail.</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a class="inline-flex h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground shadow-xs hover:bg-primary/90" href="{{ path(app.user ? 'app_admin' : 'app_login') }}">{{ app.user ? 'Retour au tableau de bord' : 'Retour à l’accueil' }}</a>
                <button class="inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-5 text-sm font-medium hover:bg-muted" type="button" onclick="history.back()">Page précédente</button>
            </div>
        </div>
    </section>
{% endblock %}
