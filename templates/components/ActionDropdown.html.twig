{# @block content Menu items. Links and buttons receive consistent compact styling. #}
<details class="group relative inline-block text-left" data-controller="dropdown" data-action="toggle->dropdown#toggle click->dropdown#select">
    <summary class="flex size-9 cursor-pointer list-none items-center justify-center rounded-lg border border-border bg-background text-muted-foreground transition hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring marker:hidden" aria-label="Afficher les actions" aria-haspopup="menu" aria-expanded="false">
        <twig:ux:icon name="lucide:ellipsis-vertical" class="size-4" aria-hidden="true"/>
    </summary>
    <div class="fixed z-[100] min-w-48 rounded-xl border border-border bg-popover p-1.5 text-left shadow-lg [&_a]:flex [&_a]:w-full [&_a]:items-center [&_a]:gap-2 [&_a]:rounded-lg [&_a]:px-3 [&_a]:py-2 [&_a]:text-sm [&_a]:font-medium [&_a]:transition-colors [&_a:hover]:bg-muted [&_button]:flex [&_button]:w-full [&_button]:items-center [&_button]:gap-2 [&_button]:rounded-lg [&_button]:px-3 [&_button]:py-2 [&_button]:text-left [&_button]:text-sm [&_button]:font-medium [&_button]:transition-colors [&_button:hover]:bg-muted" role="menu" data-dropdown-menu hidden>
        {% block content %}{% endblock %}
    </div>
</details>
