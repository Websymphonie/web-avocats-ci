{% extends 'layouts/base.html.twig' %}

{% block title %}Messages de contact{% endblock %}

{% block body %}
    <main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <div class="mx-auto max-w-7xl space-y-6">
            <section class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm font-medium text-muted-foreground">Communication</p>
                    <h1 class="mt-1 text-2xl font-semibold tracking-[-0.03em]">Messages de contact</h1>
                    <p class="mt-2 text-sm text-muted-foreground">Consultez les demandes reçues depuis le formulaire public.</p>
                </div>
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <twig:ux:icon name="lucide:inbox" class="size-4" aria-hidden="true"/>
                    {{ messages.totalItemCount }} message{{ messages.totalItemCount > 1 ? 's' : '' }}
                </div>
            </section>

            <details class="group rounded-2xl border border-border bg-card shadow-sm" {% if app.request.query.all|length > 0 %}open{% endif %}>
                <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-sm font-medium marker:hidden">
                    <span class="flex items-center gap-2"><twig:ux:icon name="lucide:list-filter" class="size-4 text-muted-foreground" aria-hidden="true"/>Filtrer les messages</span>
                    <twig:ux:icon name="lucide:chevron-down" class="size-4 text-muted-foreground transition-transform group-open:rotate-180" aria-hidden="true"/>
                </summary>
                <div class="border-t border-border px-6 py-5">
                    {{ form_start(filterForm, {attr: {class: 'grid gap-4 sm:grid-cols-[minmax(0,280px)_auto]', novalidate: true}}) }}
                    <div class="space-y-2">
                        {{ form_label(filterForm.status, null, {label_attr: {class: 'text-sm font-medium'}}) }}
                        {{ form_widget(filterForm.status, {attr: {class: 'flex h-10 w-full rounded-lg border border-input bg-background px-3 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}
                    </div>
                    <div class="flex items-end gap-2">
                        <button class="inline-flex h-10 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90" type="submit">Appliquer</button>
                        <a class="inline-flex h-10 items-center justify-center rounded-lg px-3 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground" href="{{ path('contact_admin_message_list') }}">Réinitialiser</a>
                    </div>
                    {{ form_end(filterForm) }}
                </div>
            </details>

            <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm" aria-labelledby="contact-messages-list-title">
                <div class="border-b border-border px-5 py-4 sm:px-6">
                    <h2 id="contact-messages-list-title" class="text-sm font-semibold">Boîte de réception</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Les messages sont conservés tels qu’ils ont été soumis.</p>
                </div>

                <div class="divide-y divide-border md:hidden">
                    {% for message in messages.items %}
                        <article class="space-y-4 p-5">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="text-xs text-muted-foreground">{{ message.submittedAt|date('d/m/Y H:i') }}</p>
                                    <h3 class="mt-2 truncate font-medium">{{ message.subject }}</h3>
                                    <p class="mt-1 truncate text-sm text-muted-foreground">{{ message.fullName }} · {{ message.email }}</p>
                                </div>
                                <twig:Badge variant="{{ message.deliveryStatus.value == 'SENT' ? 'success' : (message.deliveryStatus.value == 'FAILED' ? 'danger' : 'warning') }}">{{ message.deliveryStatus.label }}</twig:Badge>
                            </div>
                            <div class="flex justify-end">
                                <twig:ActionDropdown>
                                    <a href="{{ path('contact_admin_message_show', {uuid: message.uuid}) }}"><twig:ux:icon name="lucide:eye" class="size-4" aria-hidden="true"/>Voir le message</a>
                                </twig:ActionDropdown>
                            </div>
                        </article>
                    {% else %}
                        <div class="px-6 py-14 text-center text-muted-foreground">Aucun message de contact.</div>
                    {% endfor %}
                </div>

                <div class="hidden overflow-x-auto md:block">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-muted/50 text-xs uppercase tracking-wide text-muted-foreground">
                        <tr>
                            <th class="px-5 py-3 font-medium">Date</th>
                            <th class="px-5 py-3 font-medium">Nom</th>
                            <th class="px-5 py-3 font-medium">Email</th>
                            <th class="px-5 py-3 font-medium">Sujet</th>
                            <th class="px-5 py-3 font-medium">Statut email</th>
                            <th class="px-5 py-3 text-right font-medium">Actions</th>
                        </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                        {% for message in messages.items %}
                            <tr class="transition-colors hover:bg-muted/40">
                                <td class="whitespace-nowrap px-5 py-4 text-muted-foreground">{{ message.submittedAt|date('d/m/Y H:i') }}</td>
                                <td class="px-5 py-4 font-medium">{{ message.fullName }}</td>
                                <td class="px-5 py-4 text-muted-foreground">{{ message.email }}</td>
                                <td class="max-w-sm px-5 py-4"><p class="truncate">{{ message.subject }}</p></td>
                                <td class="px-5 py-4"><twig:Badge variant="{{ message.deliveryStatus.value == 'SENT' ? 'success' : (message.deliveryStatus.value == 'FAILED' ? 'danger' : 'warning') }}">{{ message.deliveryStatus.label }}</twig:Badge></td>
                                <td class="px-5 py-4"><div class="flex justify-end"><twig:ActionDropdown><a href="{{ path('contact_admin_message_show', {uuid: message.uuid}) }}"><twig:ux:icon name="lucide:eye" class="size-4" aria-hidden="true"/>Voir le message</a></twig:ActionDropdown></div></td>
                            </tr>
                        {% else %}
                            <tr><td class="px-6 py-14 text-center text-muted-foreground" colspan="6">Aucun message de contact.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% include 'shared/views/_list_pagination.html.twig' with {pager: messages, route: 'contact_admin_message_list'} only %}
            </section>
        </div>
    </main>
{% endblock %}
