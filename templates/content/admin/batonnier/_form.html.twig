{{ form_start(form) }}
<div class="grid gap-5 md:grid-cols-2">
    <div class="space-y-2 md:col-span-2">{{ form_label(form.fullName, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.fullName, {attr: {class: 'flex h-10 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}{{ form_errors(form.fullName) }}</div>
    <div class="space-y-2">{{ form_label(form.mandateStartedAt, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.mandateStartedAt, {attr: {class: 'flex h-10 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}{{ form_errors(form.mandateStartedAt) }}</div>
    <div class="space-y-2">{{ form_label(form.mandateEndedAt, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.mandateEndedAt, {attr: {class: 'flex h-10 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}{{ form_errors(form.mandateEndedAt) }}</div>
    <div class="space-y-2 md:col-span-2">{{ form_label(form.portrait, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.portrait, {attr: {class: 'block w-full rounded-lg border border-input bg-background px-3 py-2 text-sm'}}) }}{{ form_errors(form.portrait) }}<p class="text-xs text-muted-foreground">JPEG, PNG ou WebP, 5 Mo maximum.</p>{% if portraitUrl|default(null) %}<img class="mt-3 h-32 w-24 rounded-xl object-cover" src="{{ portraitUrl }}" alt="Portrait actuel du Bâtonnier">{% endif %}</div>
    <div class="space-y-2 md:col-span-2">{{ form_label(form.summary, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.summary, {attr: {class: 'min-h-32 w-full rounded-lg border border-input bg-background px-3 py-2 text-sm'}}) }}{{ form_errors(form.summary) }}</div>
    {% if form.removePortrait is defined %}<div class="md:col-span-2">{{ form_widget(form.removePortrait, {attr: {class: 'size-4 accent-primary'}}) }} {{ form_label(form.removePortrait, null, {label_attr: {class: 'ml-2 text-sm'}}) }}</div>{% endif %}
    <div class="flex justify-end gap-3 md:col-span-2"><a class="inline-flex h-10 items-center rounded-lg px-4 text-sm font-medium text-muted-foreground hover:bg-muted" href="{{ path('content_admin_batonnier_list') }}">Annuler</a><button class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90" type="submit"><twig:ux:icon name="lucide:save" class="size-4"/>Enregistrer</button></div>
</div>
{{ form_end(form) }}
