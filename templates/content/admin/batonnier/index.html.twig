{% extends 'layouts/base.html.twig' %}
{% block title %}Le Bâtonnier{% endblock %}
{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-7xl space-y-6">
<section class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between"><div><p class="text-sm font-medium text-muted-foreground">Contenu institutionnel</p><h1 class="mt-1 text-2xl font-semibold">Le Bâtonnier</h1><p class="mt-2 text-sm text-muted-foreground">Conservez l’historique des mandats et la présentation publique actuelle.</p></div>{% if is_granted('BATONNIER_CREATE') %}<a class="inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" href="{{ path('content_admin_batonnier_new') }}"><twig:ux:icon name="lucide:plus" class="size-4"/>Nouveau mandat</a>{% endif %}</section>
<section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm"><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-muted/50 text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-5 py-3">Nom</th><th class="px-5 py-3">Début</th><th class="px-5 py-3">Fin</th><th class="px-5 py-3">État</th><th class="px-5 py-3 text-right">Actions</th></tr></thead><tbody class="divide-y divide-border">{% for mandate in mandates %}<tr class="hover:bg-muted/40"><td class="px-5 py-4 font-medium">{{ mandate.fullName }}</td><td class="px-5 py-4 text-muted-foreground">{{ mandate.mandateStartedAt|date('d/m/Y') }}</td><td class="px-5 py-4 text-muted-foreground">{{ mandate.mandateEndedAt ? mandate.mandateEndedAt|date('d/m/Y') : '—' }}</td><td class="px-5 py-4"><twig:Badge variant="{{ mandate.isCurrent ? 'success' : 'secondary' }}">{{ mandate.isCurrent ? 'En cours' : 'Terminé' }}</twig:Badge></td><td class="px-5 py-4"><div class="flex justify-end gap-2"><a class="inline-flex h-9 items-center gap-2 rounded-lg border border-input px-3 text-sm hover:bg-muted" href="{{ path('content_admin_batonnier_show', {id: mandate.id}) }}"><twig:ux:icon name="lucide:eye" class="size-4"/>Voir</a>{% if is_granted('BATONNIER_EDIT') %}<a class="inline-flex h-9 items-center gap-2 rounded-lg border border-input px-3 text-sm hover:bg-muted" href="{{ path('content_admin_batonnier_edit', {id: mandate.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}</div></td></tr>{% else %}<tr><td colspan="5" class="px-6 py-14 text-center text-muted-foreground">Aucun mandat enregistré.</td></tr>{% endfor %}</tbody></table></div></section>
</div></main>
{% endblock %}
