{% extends 'layouts/base.html.twig' %}
{% block title %}{{ mandate.fullName }}{% endblock %}
{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-4xl space-y-6"><div class="flex flex-wrap items-start justify-between gap-4"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_batonnier_list') }}">← Le Bâtonnier</a><div class="mt-3 flex flex-wrap items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">{{ mandate.fullName }}</h1><twig:Badge variant="{{ mandate.isCurrent ? 'success' : 'secondary' }}">{{ mandate.isCurrent ? 'En cours' : 'Terminé' }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">Du {{ mandate.mandateStartedAt|date('d/m/Y') }} au {{ mandate.mandateEndedAt ? mandate.mandateEndedAt|date('d/m/Y') : 'aujourd’hui' }}</p></div>{% if is_granted('BATONNIER_EDIT') %}<a class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('content_admin_batonnier_edit', {id: mandate.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}</div><article class="grid gap-6 rounded-2xl border border-border bg-card p-6 shadow-sm md:grid-cols-[12rem_1fr]">{% if portraitUrl %}<img class="h-48 w-36 rounded-2xl object-cover" src="{{ portraitUrl }}" alt="Portrait de {{ mandate.fullName }}">{% endif %}<div class="space-y-4"><p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Présentation</p>{% if mandate.summary %}<p class="whitespace-pre-line text-sm leading-7">{{ mandate.summary }}</p>{% else %}<p class="text-sm text-muted-foreground">Aucune présentation renseignée.</p>{% endif %}</div></article></div></main>{% endblock %}
