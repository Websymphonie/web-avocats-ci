{% extends 'layouts/base.html.twig' %}
{% block title %}{{ member.fullName }} — Conseil de l’Ordre{% endblock %}
{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-4xl space-y-6"><div class="flex flex-wrap items-start justify-between gap-4"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_council_member_list') }}">← Conseil de l’Ordre</a><div class="mt-3 flex flex-wrap items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">{{ member.fullName }}</h1><twig:Badge variant="{{ member.isCurrent ? 'success' : 'secondary' }}">{{ member.isCurrent ? 'En cours' : 'Terminé' }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">{{ member.function }}</p></div>{% if is_granted('COUNCIL_MEMBER_EDIT') %}<a class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('content_admin_council_member_edit', {id: member.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}</div><article class="grid gap-6 rounded-2xl border border-border bg-card p-6 shadow-sm md:grid-cols-[12rem_1fr]">{% if portraitUrl %}<img class="h-56 w-44 rounded-2xl object-cover" src="{{ portraitUrl }}" alt="Portrait de {{ member.fullName }}">{% endif %}<div class="space-y-4"><p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Informations</p><dl class="space-y-3 text-sm"><div><dt class="text-muted-foreground">Ordre d’affichage</dt><dd class="font-medium">{{ member.sortOrder }}</dd></div><div><dt class="text-muted-foreground">Mandat</dt><dd class="font-medium">{% if member.mandateStartedAt %}{{ member.mandateStartedAt|date('d/m/Y') }}{% else %}Non renseigné{% endif %} → {% if member.mandateEndedAt %}{{ member.mandateEndedAt|date('d/m/Y') }}{% else %}En cours{% endif %}</dd></div></dl></div></article></div></main>{% endblock %}
