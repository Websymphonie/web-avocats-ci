{{ form_start(form, {attr: {class: 'space-y-6', novalidate: true}}) }}
<div class="space-y-2">{{ form_label(form.title, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.title, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(form.title) }}</div>
<div class="space-y-2">{{ form_label(form.description, null, {label_attr: {class: 'text-sm font-medium'}}) }}<div {{ react_component('Content/RichTextEditor', {inputId: form.description.vars.id, label: 'Description', value: form.description.vars.value|default(''), placeholder: 'Présentez ce document…', invalid: form.description.vars.errors|length > 0}) }}></div>{{ form_widget(form.description, {attr: {class: 'sr-only', tabindex: '-1', 'aria-hidden': 'true'}}) }}{{ form_errors(form.description) }}</div>
<div class="grid gap-5 md:grid-cols-2"><div class="space-y-2">{{ form_label(form.accessLevel, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.accessLevel, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}{{ form_errors(form.accessLevel) }}<p class="text-xs text-muted-foreground">Le statut de publication reste piloté par les actions dédiées.</p></div><div class="space-y-2">{{ form_label(form.tags, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.tags) }}{{ form_errors(form.tags) }}</div></div>
{% if form.file is defined %}<div class="space-y-3" data-controller="document-upload"><div><h2 class="text-sm font-medium">{{ form.file.vars.label }}</h2><p class="mt-1 text-xs text-muted-foreground">PDF, DOCX, XLSX ou PPTX · 20 Mio maximum · validation MIME côté serveur.</p></div><div class="rounded-xl border-2 border-dashed border-border bg-muted/20 p-5 text-center"><p class="text-sm font-medium">Sélectionnez un fichier</p>{{ form_widget(form.file, {attr: {class: 'sr-only', 'data-document-upload-target': 'input', 'data-action': 'change->document-upload#changed'}}) }}<button type="button" class="mt-3 inline-flex h-9 items-center gap-2 rounded-lg border border-input bg-background px-3 text-sm font-medium hover:bg-muted" data-action="document-upload#choose"><twig:ux:icon name="lucide:upload" class="size-4"/>Choisir un fichier</button>{{ form_errors(form.file) }}</div><div data-document-upload-target="preview" aria-live="polite"></div></div>{% else %}<div class="rounded-xl border border-border bg-muted/20 px-4 py-3 text-sm"><span class="text-muted-foreground">Fichier actuel :</span> <strong>{{ document.fileOriginalName|default('fichier stocké') }}</strong><span class="ml-2 text-xs text-muted-foreground">Le remplacement sera traité dans une évolution dédiée.</span></div>{% endif %}
<div class="flex flex-wrap items-center justify-end gap-3 border-t border-border pt-5"><a class="inline-flex h-10 items-center justify-center rounded-lg px-4 text-sm font-medium text-muted-foreground hover:bg-muted" href="{{ path('content_admin_document_list') }}">Annuler</a><button class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90" type="submit"><twig:ux:icon name="lucide:save" class="size-4"/>Enregistrer le brouillon</button></div>
{{ form_end(form) }}
