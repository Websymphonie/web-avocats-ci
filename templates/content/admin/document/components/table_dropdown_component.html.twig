<twig:ActionDropdown>
    {% if is_granted('CONTENT_DOCUMENT_VIEW') %}<a href="{{ path('content_admin_document_show', {id: document.id}) }}"><twig:ux:icon name="lucide:eye" class="size-4"/>Voir</a><a href="{{ path('content_admin_document_download', {id: document.id}) }}"><twig:ux:icon name="lucide:download" class="size-4"/>Télécharger</a>{% endif %}
    {% if is_granted('CONTENT_DOCUMENT_MANAGE') %}<a href="{{ path('content_admin_document_edit', {id: document.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}
    {% if document.status.value == 'DRAFT' and is_granted('CONTENT_DOCUMENT_PUBLISH') %}<form method="post" action="{{ path('content_admin_document_publish', {id: document.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('document_publish_' ~ document.id) }}"><button type="submit"><twig:ux:icon name="lucide:send" class="size-4"/>Publier</button></form>{% elseif document.status.value == 'PUBLISHED' and is_granted('CONTENT_DOCUMENT_PUBLISH') %}<form method="post" action="{{ path('content_admin_document_archive', {id: document.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('document_archive_' ~ document.id) }}"><button type="submit"><twig:ux:icon name="lucide:archive" class="size-4"/>Archiver</button></form>{% endif %}
    {% if is_granted('CONTENT_DOCUMENT_DELETE') %}{{ component('DeleteFormComponent', {id: document.id, instanceId: instanceId, urlPath: path('content_admin_document_delete', {id: document.id}), csrfTokenId: 'delete', buttonLabel: 'Supprimer', description: 'La publication « ' ~ document.title ~ ' » sera supprimée. Le fichier privé sera nettoyé uniquement s’il est orphelin.'}) }}{% endif %}
</twig:ActionDropdown>
