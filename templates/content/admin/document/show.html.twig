{% extends 'layouts/base.html.twig' %}{% block title %}{{ document.title }}{% endblock %}{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-4xl space-y-6"><div class="flex flex-wrap items-start justify-between gap-4"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_document_list') }}">← Documents</a><div class="mt-3 flex items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">{{ document.title }}</h1><twig:Badge variant="{{ document.status.value == 'PUBLISHED' ? 'success' : (document.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ document.status.value }}</twig:Badge></div></div><a class="inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" href="{{ path('content_admin_document_download', {id: document.id}) }}"><twig:ux:icon name="lucide:download" class="size-4"/>Télécharger</a></div><section class="rounded-2xl border border-border bg-card p-6 shadow-sm"><dl class="grid gap-5 sm:grid-cols-2"><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Fichier</dt><dd class="mt-1 font-medium">{{ file.originalName }}</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Type / taille</dt><dd class="mt-1">{{ file.mimeType }} · {{ (file.size / 1024 / 1024)|number_format(2, ',', ' ') }} Mio</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Accès</dt><dd class="mt-1">{{ document.accessLevel.label }}</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Publication</dt><dd class="mt-1">{{ document.publishedAt ? document.publishedAt|date('d/m/Y H:i') : 'Brouillon' }}</dd></div></dl><div class="mt-6 border-t border-border pt-6 prose prose-sm max-w-none dark:prose-invert">{{ safeDescription|raw }}</div>{% if document.tags is not empty %}<div class="mt-6 flex flex-wrap gap-2">{% for tag in document.tags %}<twig:Badge variant="secondary">{{ tag.name }}</twig:Badge>{% endfor %}</div>{% endif %}</section></div></main>{% endblock %}
