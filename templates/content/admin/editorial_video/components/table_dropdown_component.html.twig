<twig:ActionDropdown>
    {% if is_granted('CONTENT_VIDEO_VIEW') %}<a href="{{ path('content_admin_video_show', {id: video.id}) }}"><twig:ux:icon name="lucide:eye" class="size-4"/>Voir</a>{% endif %}
    {% if is_granted('CONTENT_VIDEO_MANAGE') %}<a href="{{ path('content_admin_video_edit', {id: video.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}
    {% if video.status.value == 'DRAFT' and is_granted('CONTENT_VIDEO_PUBLISH') %}<form method="post" action="{{ path('content_admin_video_publish', {id: video.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('video_publish_' ~ video.id) }}"><button type="submit"><twig:ux:icon name="lucide:send" class="size-4"/>Publier</button></form>{% elseif video.status.value == 'PUBLISHED' and is_granted('CONTENT_VIDEO_PUBLISH') %}<form method="post" action="{{ path('content_admin_video_archive', {id: video.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('video_archive_' ~ video.id) }}"><button type="submit"><twig:ux:icon name="lucide:archive" class="size-4"/>Archiver</button></form>{% endif %}
    {% if is_granted('CONTENT_VIDEO_DELETE') %}{{ component('DeleteFormComponent', {id: video.id, instanceId: instanceId, urlPath: path('content_admin_video_delete', {id: video.id}), csrfTokenId: 'delete', buttonLabel: 'Supprimer', description: 'La vidéo « ' ~ video.title ~ ' » sera définitivement supprimée.'}) }}{% endif %}
</twig:ActionDropdown>
