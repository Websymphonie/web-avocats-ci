{% extends 'layouts/base.html.twig' %}{% block title %}{{ video.title }}{% endblock %}{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-4xl space-y-6"><div class="flex flex-wrap items-start justify-between gap-4"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_video_list') }}">← Vidéos</a><div class="mt-3 flex flex-wrap items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">{{ video.title }}</h1><twig:Badge variant="{{ video.status.value == 'PUBLISHED' ? 'success' : (video.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ video.status.label }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">{{ video.provider.label }} · /{{ video.slug }}</p></div>{% if is_granted('CONTENT_VIDEO_MANAGE') %}<a class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('content_admin_video_edit', {id: video.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}</div><article class="space-y-6 rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">{% if embedUrl %}<div class="overflow-hidden rounded-xl border border-border bg-black"><iframe class="aspect-video w-full" src="{{ embedUrl }}" title="Aperçu de {{ video.title }}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>{% else %}<div class="rounded-xl border border-border bg-muted/20 p-5"><p class="text-sm text-muted-foreground">Cette URL externe n’est pas intégrée dans l’interface.</p><a class="mt-2 inline-flex items-center gap-2 text-sm font-medium text-primary underline" href="{{ video.videoUrl }}" target="_blank" rel="noopener noreferrer"><twig:ux:icon name="lucide:external-link" class="size-4"/>Ouvrir la vidéo</a></div>{% endif %}{% if video.excerpt %}<p class="text-lg leading-8 text-muted-foreground">{{ video.excerpt }}</p>{% endif %}<div class="flex flex-wrap gap-2">{% for tag in video.tags %}<twig:Badge variant="outline">#{{ tag.name }}</twig:Badge>{% else %}<span class="text-sm text-muted-foreground">Aucun tag</span>{% endfor %}</div><div class="rich-content text-sm">{{ safeDescription|raw }}</div><dl class="grid gap-4 border-t border-border pt-5 sm:grid-cols-3"><div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Fournisseur</dt><dd class="mt-1">{{ video.provider.label }}</dd></div><div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Publication</dt><dd class="mt-1">{{ video.publishedAt ? video.publishedAt|date('d/m/Y H:i') : '—' }}</dd></div><div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Modification</dt><dd class="mt-1">{{ video.updatedAt ? video.updatedAt|date('d/m/Y H:i') : '—' }}</dd></div></dl></article></div></main>{% endblock %}
