<twig:AlertDialog id="bulk-editorial-video-category-delete">
    <twig:AlertDialog:Trigger><twig:Button type="button" variant="destructive" size="sm" data-bulk-selection-target="action" data-action="click->alert-dialog#open" data-alert-dialog-target="trigger" aria-haspopup="dialog"><twig:ux:icon name="lucide:trash-2" class="size-4"/>Supprimer</twig:Button></twig:AlertDialog:Trigger>
    <twig:AlertDialog:Content><twig:AlertDialog:Header><twig:AlertDialog:Title><span data-bulk-selection-target="confirmation">Supprimer les catégories sélectionnées ?</span></twig:AlertDialog:Title><twig:AlertDialog:Description><span data-bulk-selection-target="confirmationDescription">Les catégories utilisées par une vidéo seront refusées.</span></twig:AlertDialog:Description></twig:AlertDialog:Header><twig:AlertDialog:Footer><twig:AlertDialog:Cancel>Annuler</twig:AlertDialog:Cancel><twig:Button type="submit" form="{{ formId }}" variant="destructive">Supprimer les catégories</twig:Button></twig:AlertDialog:Footer></twig:AlertDialog:Content>
</twig:AlertDialog>
