{% extends 'layouts/base.html.twig' %}{% block title %}Catégories de vidéos{% endblock %}{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-7xl space-y-6"><section class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between"><div><p class="text-sm font-medium text-muted-foreground">Contenu · Vidéos</p><h1 class="mt-1 text-2xl font-semibold">Catégories de vidéos éditoriales</h1><p class="mt-2 text-sm text-muted-foreground">Organisez les vidéos publiques par thème éditorial.</p></div>{% if is_granted('CONTENT_VIDEO_CATEGORY_MANAGE') %}<a class="inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" href="{{ path('content_admin_video_category_new') }}"><twig:ux:icon name="lucide:plus" class="size-4"/>Nouvelle catégorie</a>{% endif %}</section><details class="group rounded-2xl border border-border bg-card shadow-sm" {% if app.request.query.all|length > 0 %}open{% endif %}><summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-sm font-medium"><span class="flex items-center gap-2"><twig:ux:icon name="lucide:list-filter" class="size-4 text-muted-foreground"/>Filtrer les catégories</span><twig:ux:icon name="lucide:chevron-down" class="size-4 text-muted-foreground transition-transform group-open:rotate-180"/></summary><div class="border-t border-border px-6 py-5">{{ form_start(filterForm, {attr: {class: 'flex flex-col gap-3 sm:flex-row', novalidate: true}}) }}{{ form_widget(filterForm.search, {attr: {class: 'flex h-10 min-w-0 flex-1 rounded-lg border border-input bg-background px-3 text-sm'}}) }}<button class="inline-flex h-10 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Appliquer</button><a class="inline-flex h-10 items-center justify-center rounded-lg px-3 text-sm text-muted-foreground" href="{{ path('content_admin_video_category_list') }}">Réinitialiser</a>{{ form_end(filterForm) }}</div></details><form id="editorial-video-category-bulk-delete" method="post" action="{{ path('content_admin_video_category_bulk_delete') }}"><input type="hidden" name="_token" value="{{ csrf_token('editorial-video-category-bulk-delete') }}"></form><twig:BulkSelection id="editorial-video-category-selection" inputName="ids[]" inputForm="editorial-video-category-bulk-delete" selectionLabelSingular="catégorie" selectionLabelPlural="catégories" confirmationTemplate="Supprimer {count} catégorie(s) ?" confirmationDescriptionTemplate="Les catégories utilisées par une vidéo seront refusées.">{% block actions %}{% if is_granted('CONTENT_VIDEO_CATEGORY_DELETE') %}{{ component('BulkDeleteEditorialVideoCategories', {formId: 'editorial-video-category-bulk-delete'}) }}{% endif %}{% endblock %}{% block content %}<section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm"><div class="flex items-center justify-between border-b border-border px-5 py-4"><div class="flex items-center gap-3"><label class="inline-flex size-9 items-center justify-center"><input type="checkbox" class="size-4 accent-primary" data-bulk-selection-target="master" aria-label="Sélectionner toutes les catégories"></label><div><h2 class="text-sm font-semibold">Référentiel des catégories</h2><p class="mt-1 text-sm text-muted-foreground">{{ categories.totalItemCount }} catégorie{{ categories.totalItemCount > 1 ? 's' : '' }}</p></div></div></div><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-muted/50 text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-5 py-3"><span class="sr-only">Sélection</span></th><th class="px-5 py-3">Nom</th><th class="px-5 py-3">Slug</th><th class="px-5 py-3 text-right">Actions</th></tr></thead><tbody class="divide-y divide-border">{% for category in categories.items %}<tr class="hover:bg-muted/40"><td class="px-5 py-4"><input type="checkbox" value="{{ category.id }}" class="size-4 accent-primary" data-bulk-selection-target="row" aria-label="Sélectionner la catégorie : {{ category.name }}"></td><td class="px-5 py-4 font-medium">{{ category.name }}</td><td class="px-5 py-4 text-muted-foreground">{{ category.slug }}</td><td class="px-5 py-4"><div class="flex justify-end">{{ component('EditorialVideoCategoryTableDropdown', {category: category, instanceId: 'category-' ~ category.id}) }}</div></td></tr>{% else %}<tr><td colspan="4" class="px-6 py-14 text-center text-muted-foreground">Aucune catégorie.</td></tr>{% endfor %}</tbody></table></div>{% include 'shared/views/_list_pagination.html.twig' with {pager: categories, route: 'content_admin_video_category_list'} only %}</section>{% endblock %}</twig:BulkSelection></div></main>{% endblock %}
