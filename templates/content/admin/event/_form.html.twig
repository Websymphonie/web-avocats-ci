{{ form_start(form, {attr: {class: 'space-y-6', novalidate: true, 'data-controller': 'event-form', 'data-action': 'change->event-form#formatChanged'}}) }}
<div class="space-y-2">{{ form_label(form.title, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.title, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(form.title) }}</div>
<div class="space-y-2">{{ form_label(form.excerpt, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.excerpt, {attr: {class: 'min-h-24 w-full rounded-lg border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(form.excerpt) }}</div>
<div class="space-y-2">{{ form_label(form.description, null, {label_attr: {class: 'text-sm font-medium'}}) }}
    <div {{ react_component('Content/RichTextEditor', {inputId: form.description.vars.id, label: 'Description', value: form.description.vars.value|default(''), placeholder: 'Présentez le programme et les informations utiles…', invalid: form.description.vars.errors|length > 0}) }}></div>
    {{ form_widget(form.description, {attr: {class: 'sr-only', tabindex: '-1', 'aria-hidden': 'true'}}) }}{{ form_errors(form.description) }}
    <p class="text-xs text-muted-foreground">Mise en forme disponible : titres, emphase, listes, citations et liens.</p>
</div>
<div class="grid gap-5 md:grid-cols-3">
    <div class="space-y-2">{{ form_label(form.format, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.format, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30', 'data-event-form-target': 'format'}}) }}{{ form_errors(form.format) }}</div>
    <div class="space-y-2">{{ form_label(form.startsAt, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.startsAt, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(form.startsAt) }}</div>
    <div class="space-y-2">{{ form_label(form.endsAt, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.endsAt, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(form.endsAt) }}</div>
</div>
<fieldset class="space-y-4 rounded-xl border border-border bg-muted/20 p-4">
    <legend class="px-1 text-sm font-semibold">Informations pratiques</legend>
    <div class="grid gap-5 md:grid-cols-2">
        <div class="space-y-2"
             data-event-form-target="physical">{{ form_label(form.venueName, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.venueName, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(form.venueName) }}</div>
        <div class="space-y-2"
             data-event-form-target="physical">{{ form_label(form.address, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.address, {attr: {class: 'min-h-24 w-full rounded-lg border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(form.address) }}</div>
    </div>
    <div class="space-y-2"
         data-event-form-target="online">{{ form_label(form.onlineUrl, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.onlineUrl, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(form.onlineUrl) }}</div>
</fieldset>
<div class="grid gap-5 md:grid-cols-2">
    <div class="space-y-2">{{ form_label(form.categories, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.categories) }}{{ form_errors(form.categories) }}</div>
    <div class="space-y-2">{{ form_label(form.tags, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.tags) }}{{ form_errors(form.tags) }}</div>
</div>
{% include 'content/admin/_cover_fields.html.twig' with {form: form, coverUrl: coverUrl|default(null), photoGallery: photoGallery|default(null)} only %}
<div class="flex flex-wrap items-center justify-end gap-3 border-t border-border pt-5"><a
            class="inline-flex h-10 items-center justify-center rounded-lg px-4 text-sm font-medium text-muted-foreground hover:bg-muted"
            href="{{ path('content_admin_event_list') }}">Annuler</a>
    <button class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90"
            type="submit">
        <twig:ux:icon name="lucide:save" class="size-4"/>
        Enregistrer le brouillon
    </button>
</div>
{{ form_end(form) }}
