<twig:ActionDropdown>
    {% if is_granted('CONTENT_EVENT_VIEW') %}<a href="{{ path('content_admin_event_show', {id: event.id}) }}"><twig:ux:icon name="lucide:eye" class="size-4"/>Voir</a>{% endif %}
    {% if is_granted('CONTENT_EVENT_MANAGE') %}<a href="{{ path('content_admin_event_edit', {id: event.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}
    {% if event.status.value == 'DRAFT' and is_granted('CONTENT_EVENT_PUBLISH') %}<form method="post" action="{{ path('content_admin_event_publish', {id: event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('event_publish_' ~ event.id) }}"><button type="submit"><twig:ux:icon name="lucide:send" class="size-4"/>Publier</button></form>{% elseif event.status.value == 'PUBLISHED' %}{% if is_granted('CONTENT_EVENT_CANCEL') %}<form method="post" action="{{ path('content_admin_event_cancel', {id: event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('event_cancel_' ~ event.id) }}"><button type="submit"><twig:ux:icon name="lucide:ban" class="size-4"/>Annuler</button></form>{% endif %}{% if is_granted('CONTENT_EVENT_PUBLISH') %}<form method="post" action="{{ path('content_admin_event_archive', {id: event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('event_archive_' ~ event.id) }}"><button type="submit"><twig:ux:icon name="lucide:archive" class="size-4"/>Archiver</button></form>{% endif %}{% elseif event.status.value == 'CANCELLED' and is_granted('CONTENT_EVENT_PUBLISH') %}<form method="post" action="{{ path('content_admin_event_archive', {id: event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('event_archive_' ~ event.id) }}"><button type="submit"><twig:ux:icon name="lucide:archive" class="size-4"/>Archiver</button></form>{% endif %}
    {% if is_granted('CONTENT_EVENT_DELETE') %}{{ component('DeleteFormComponent', {id: event.id, instanceId: instanceId, urlPath: path('content_admin_event_delete', {id: event.id}), csrfTokenId: 'delete', buttonLabel: 'Supprimer', description: 'L’événement « ' ~ event.title ~ ' » sera définitivement supprimé.'}) }}{% endif %}
</twig:ActionDropdown>
