{% extends 'layouts/base.html.twig' %}{% block title %}Modifier l’événement{% endblock %}{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-4xl space-y-6"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_event_list') }}">← Événements</a><div class="mt-3 flex flex-wrap items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">Modifier l’événement</h1><twig:Badge variant="{{ event.status.value == 'PUBLISHED' ? 'success' : (event.status.value == 'CANCELLED' ? 'danger' : (event.status.value == 'ARCHIVED' ? 'warning' : 'secondary')) }}">{{ event.status.label }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">Le slug reste stable après publication.</p></div><section class="rounded-2xl border border-border bg-card p-6 shadow-sm">{% include 'content/admin/event/_form.html.twig' %}</section></div></main>{% endblock %}
