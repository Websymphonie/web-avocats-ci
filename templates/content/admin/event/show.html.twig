{% extends 'layouts/base.html.twig' %}{% block title %}{{ event.title }}{% endblock %}{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-4xl space-y-6"><div class="flex flex-wrap items-start justify-between gap-4"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_event_list') }}">← Événements</a><div class="mt-3 flex flex-wrap items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">{{ event.title }}</h1><twig:Badge variant="{{ event.status.value == 'PUBLISHED' ? 'success' : (event.status.value == 'CANCELLED' ? 'danger' : (event.status.value == 'ARCHIVED' ? 'warning' : 'secondary')) }}">{{ event.status.label }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">{{ event.format.label }} · /{{ event.slug }}</p></div>{% if is_granted('CONTENT_EVENT_MANAGE') %}<a class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('content_admin_event_edit', {id: event.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}</div><article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8"><dl class="grid gap-4 border-b border-border pb-6 sm:grid-cols-2"><div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Début</dt><dd class="mt-1">{{ event.startsAt|date('d/m/Y H:i') }}</dd></div><div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Fin</dt><dd class="mt-1">{{ event.endsAt ? event.endsAt|date('d/m/Y H:i') : '—' }}</dd></div>{% if event.venueName %}<div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Lieu</dt><dd class="mt-1">{{ event.venueName }}<br>{{ event.address }}</dd></div>{% endif %}{% if event.onlineUrl %}<div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Participation en ligne</dt><dd class="mt-1"><a class="text-primary underline" href="{{ event.onlineUrl }}" target="_blank" rel="noopener">{{ event.onlineUrl }}</a></dd></div>{% endif %}</dl>{% if event.excerpt %}<p class="border-b border-border py-6 text-lg leading-8 text-muted-foreground">{{ event.excerpt }}</p>{% endif %}<div class="flex flex-wrap gap-2 py-6">{% for category in event.categories %}<twig:Badge variant="secondary">{{ category.name }}</twig:Badge>{% endfor %}{% for tag in event.tags %}<twig:Badge variant="outline">#{{ tag.name }}</twig:Badge>{% endfor %}</div><div class="rich-content text-sm">{{ safeDescription|raw }}</div></article></div></main>{% endblock %}
