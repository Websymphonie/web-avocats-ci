{% extends 'layouts/base.html.twig' %}
{% block title %}Modifier l’actualité{% endblock %}
{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-3xl space-y-6"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_news_list') }}">← Actualités</a><div class="mt-3 flex flex-wrap items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">Modifier l’actualité</h1><twig:Badge variant="{{ news.status.value == 'PUBLISHED' ? 'success' : (news.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ news.status.label }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">Le slug reste stable après publication.</p></div><section class="rounded-2xl border border-border bg-card p-6 shadow-sm">{% include 'content/admin/news/_form.html.twig' %}</section></div></main>{% endblock %}
