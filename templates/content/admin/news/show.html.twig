{% extends 'layouts/base.html.twig' %}
{% block title %}{{ news.title }}{% endblock %}
{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-4xl space-y-6"><div class="flex flex-wrap items-start justify-between gap-4"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_news_list') }}">← Actualités</a><div class="mt-3 flex flex-wrap items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">{{ news.title }}</h1><twig:Badge variant="{{ news.status.value == 'PUBLISHED' ? 'success' : (news.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ news.status.label }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">/{{ news.slug }} · Modifiée le {{ news.updatedAt ? news.updatedAt|date('d/m/Y H:i') : '—' }}</p></div>{% if is_granted('CONTENT_NEWS_MANAGE') %}<a class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('content_admin_news_edit', {id: news.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}</div><article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">{% if news.excerpt %}<p class="border-b border-border pb-6 text-lg leading-8 text-muted-foreground">{{ news.excerpt }}</p>{% endif %}<div class="mb-6 flex flex-wrap gap-2">{% for category in news.categories %}<twig:Badge variant="secondary">{{ category.name }}</twig:Badge>{% endfor %}{% for tag in news.tags %}<twig:Badge variant="outline">#{{ tag.name }}</twig:Badge>{% endfor %}</div><div class="rich-content pt-6 text-sm">{{ safeBody|raw }}</div></article></div></main>{% endblock %}
