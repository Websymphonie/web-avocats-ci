<fieldset data-collection-item class="rounded-xl border border-border bg-muted/20 p-4 sm:p-5">
    <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
        <div class="space-y-1.5">{{ form_label(group.title, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(group.title, {attr: {class: 'flex h-10 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}{{ form_errors(group.title) }}</div>
        <button type="button" data-action="collection#remove" class="inline-flex h-10 items-center justify-center rounded-lg px-3 text-sm font-medium text-destructive hover:bg-destructive/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Retirer le groupe</button>
    </div>
    {{ form_widget(group.key) }}
    <div class="mt-4 border-t border-border pt-3" data-controller="collection" data-collection-placeholder-value="__entry__" data-collection-prototype-value="{{ include('content/admin/page/_person_entry_form.html.twig', {entry: group.entries.vars.prototype, personPortraitUrls: personPortraitUrls|default({})})|e('html_attr') }}" data-collection-next-index-value="{{ group.entries|length }}">
        <details class="group rounded-lg border border-border bg-background" {% if expanded|default(false) %}open{% endif %}>
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm font-medium text-foreground hover:bg-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                <span class="flex min-w-0 items-center gap-2"><twig:ux:icon name="lucide:users" class="size-4 shrink-0 text-muted-foreground"/><span>Personnes</span><span class="text-xs font-normal text-muted-foreground" data-collection-target="count">{{ group.entries|length }} personne{{ group.entries|length == 1 ? '' : 's' }}</span></span>
                <twig:ux:icon name="lucide:chevron-down" class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"/>
            </summary>
            <div class="space-y-4 border-t border-border p-3 sm:p-4">
                <div class="max-w-xs space-y-1.5">{{ form_label(group.sortOrder, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(group.sortOrder, {attr: {class: 'flex h-10 w-full rounded-lg border border-input bg-background px-3 text-sm', min: 0}}) }}{{ form_errors(group.sortOrder) }}</div>
                <div class="flex flex-wrap items-center justify-between gap-3"><h3 class="text-sm font-semibold text-foreground">Liste des personnes</h3><button type="button" data-action="collection#add" class="inline-flex min-h-9 items-center justify-center gap-2 rounded-lg border border-border bg-background px-3 text-sm font-medium text-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><twig:ux:icon name="lucide:plus" class="size-4"/>Ajouter une personne</button></div>
                <div class="space-y-3" data-collection-target="items">
                    {% for entry in group.entries %}{% include 'content/admin/page/_person_entry_form.html.twig' with {entry: entry, personPortraitUrls: personPortraitUrls|default({})} only %}{% endfor %}
                </div>
                <div class="flex justify-end border-t border-border pt-3">
                    <button type="button" data-action="collection#add" class="inline-flex min-h-9 items-center justify-center gap-2 rounded-lg border border-border bg-background px-3 text-sm font-medium text-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                        <twig:ux:icon name="lucide:plus" class="size-4"/>Ajouter une personne à la suite
                    </button>
                </div>
            </div>
        </details>
    </div>
</fieldset>
