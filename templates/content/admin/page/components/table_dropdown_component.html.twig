<twig:ActionDropdown>
    {% if is_granted('CONTENT_PAGE_VIEW') %}<a href="{{ path('content_admin_page_show', {id: page.id}) }}"><twig:ux:icon name="lucide:eye" class="size-4"/>Voir</a>{% endif %}
    {% if is_granted('CONTENT_PAGE_MANAGE') %}<a href="{{ path('content_admin_page_edit', {id: page.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}
    {% if page.status.value == 'DRAFT' and is_granted('CONTENT_PAGE_PUBLISH') %}<form method="post" action="{{ path('content_admin_page_publish', {id: page.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('page_publish_' ~ page.id) }}"><button type="submit"><twig:ux:icon name="lucide:send" class="size-4"/>Publier</button></form>{% elseif page.status.value == 'PUBLISHED' and is_granted('CONTENT_PAGE_PUBLISH') %}<form method="post" action="{{ path('content_admin_page_unpublish', {id: page.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('page_unpublish_' ~ page.id) }}"><button type="submit"><twig:ux:icon name="lucide:undo-2" class="size-4"/>Dépublier</button></form>{% endif %}
    {% if is_granted('CONTENT_PAGE_DELETE') %}{{ component('DeleteFormComponent', {id: page.id, instanceId: instanceId, urlPath: path('content_admin_page_delete', {id: page.id}), csrfTokenId: 'delete', buttonLabel: 'Supprimer', description: 'La page « ' ~ page.title ~ ' » sera supprimée.'}) }}{% endif %}
</twig:ActionDropdown>
