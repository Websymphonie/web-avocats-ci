{% extends 'layouts/base.html.twig' %}{% block title %}Modifier la page{% endblock %}{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-4xl space-y-6"><div class="flex flex-wrap items-start justify-between gap-4"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_page_list') }}">← Pages statiques</a><div class="mt-3 flex items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">Modifier la page</h1><twig:Badge variant="{{ page.status.value == 'PUBLISHED' ? 'success' : 'secondary' }}">{{ page.status.label }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">Le contenu est nettoyé côté serveur avant persistence.</p></div><a class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('content_admin_page_show', {id: page.id}) }}"><twig:ux:icon name="lucide:eye" class="size-4"/>Voir</a></div><section class="rounded-2xl border border-border bg-card p-6 shadow-sm">{% include 'content/admin/page/_form.html.twig' %}</section></div></main>{% endblock %}
