{% extends 'layouts/base.html.twig' %}
{% block title %}{{ page.title }}{% endblock %}
{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="mx-auto max-w-4xl space-y-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_page_list') }}">← Pages statiques</a>
                <div class="mt-3 flex flex-wrap items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">{{ page.title }}</h1><twig:Badge variant="{{ page.status.value == 'PUBLISHED' ? 'success' : 'secondary' }}">{{ page.status.label }}</twig:Badge>{% if page.group %}<twig:Badge variant="outline">{{ page.group.label }}</twig:Badge>{% endif %}</div>
                <p class="mt-2 text-sm text-muted-foreground">/{{ page.slug }}{% if page.publishedAt %} · publiée le {{ page.publishedAt|date('d/m/Y H:i') }}{% endif %}</p>
            </div>
            {% if is_granted('CONTENT_PAGE_MANAGE') %}<a class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('content_admin_page_edit', {id: page.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}
        </div>
        <img class="aspect-[21/9] w-full rounded-2xl border border-border object-cover shadow-sm" src="{{ coverUrl|default(default_image_url)|imagine_filter('large') }}" alt="Couverture de {{ page.title }}">
        <article class="prose max-w-none rounded-2xl border border-border bg-card p-6 shadow-sm dark:prose-invert">{{ safeContent|raw }}</article>
    </div>
</main>
{% endblock %}
