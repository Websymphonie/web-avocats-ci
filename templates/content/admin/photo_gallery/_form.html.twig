{{ form_start(form, {attr: {class: 'space-y-6', novalidate: true}}) }}
<div class="space-y-2">{{ form_label(form.title, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.title, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(form.title) }}</div>
<div class="space-y-2">{{ form_label(form.description, null, {label_attr: {class: 'text-sm font-medium'}}) }}<div {{ react_component('Content/RichTextEditor', {inputId: form.description.vars.id, label: 'Description', value: form.description.vars.value|default(''), placeholder: 'Présentez cette galerie…', invalid: form.description.vars.errors|length > 0}) }}></div>{{ form_widget(form.description, {attr: {class: 'sr-only', tabindex: '-1', 'aria-hidden': 'true'}}) }}{{ form_errors(form.description) }}</div>
<div class="space-y-2">{{ form_label(form.tags, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.tags) }}{{ form_errors(form.tags) }}</div>
{% if form.images is defined %}<div class="space-y-3" data-controller="gallery-upload" data-action="dragover->gallery-upload#dragover dragleave->gallery-upload#dragleave drop->gallery-upload#drop"><div class="flex items-end justify-between gap-3"><div><h2 class="text-sm font-medium">{{ form.images.vars.label }}</h2><p class="mt-1 text-xs text-muted-foreground">JPEG, PNG ou WebP · 5 Mio maximum par image.</p></div><button type="button" class="inline-flex h-9 items-center gap-2 rounded-lg border border-input bg-background px-3 text-sm font-medium hover:bg-muted" data-action="gallery-upload#choose"><twig:ux:icon name="lucide:upload" class="size-4"/>Choisir</button></div><div class="rounded-xl border-2 border-dashed border-border bg-muted/20 p-5 text-center transition-colors"><p class="text-sm font-medium">Déposez vos images ici</p><p class="mt-1 text-xs text-muted-foreground">ou utilisez le bouton Choisir.</p>{{ form_widget(form.images, {attr: {class: 'sr-only', 'data-gallery-upload-target': 'input', 'data-action': 'change->gallery-upload#changed'}}) }}{{ form_errors(form.images) }}</div><ul class="grid gap-2 sm:grid-cols-2" data-gallery-upload-target="preview" aria-live="polite"></ul></div>{% endif %}
{% if gallery is defined and gallery.items is not empty %}<section class="space-y-3 border-t border-border pt-6"><div><h2 class="text-base font-semibold">Informations des images</h2><p class="mt-1 text-sm text-muted-foreground">Le texte alternatif est requis avant publication. La légende reste facultative.</p></div><div class="grid gap-4 md:grid-cols-2">{% for item in gallery.items %}<article class="rounded-xl border border-border bg-muted/20 p-4"><div class="flex gap-3">{% if mediaUrls[item.mediaId] is defined %}<img class="size-16 rounded-lg border border-border object-cover" src="{{ mediaUrls[item.mediaId]|imagine_filter('thumbnail') }}" alt="">{% endif %}<div class="min-w-0"><p class="font-medium">Image {{ item.position }}</p>{% if gallery.coverMediaId == item.mediaId %}<span class="mt-1 inline-flex rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">Couverture</span>{% endif %}</div></div><div class="mt-4 space-y-3"><div class="space-y-1"><label class="text-sm font-medium" for="gallery_alt_{{ item.mediaId }}">Texte alternatif</label><input id="gallery_alt_{{ item.mediaId }}" name="items[{{ item.mediaId }}][altText]" value="{{ item.altText }}" required class="flex h-10 w-full rounded-lg border border-input bg-background px-3 text-sm" aria-describedby="gallery_alt_hint_{{ item.mediaId }}"><p id="gallery_alt_hint_{{ item.mediaId }}" class="text-xs text-muted-foreground">Décrit l’image pour les lecteurs d’écran.</p></div><div class="space-y-1"><label class="text-sm font-medium" for="gallery_caption_{{ item.mediaId }}">Légende <span class="text-muted-foreground">(facultative)</span></label><textarea id="gallery_caption_{{ item.mediaId }}" name="items[{{ item.mediaId }}][caption]" rows="2" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">{{ item.caption }}</textarea></div></div></article>{% endfor %}</div></section>{% endif %}
<div class="flex flex-wrap items-center justify-end gap-3 border-t border-border pt-5"><a class="inline-flex h-10 items-center justify-center rounded-lg px-4 text-sm font-medium text-muted-foreground hover:bg-muted" href="{{ path('content_admin_gallery_list') }}">Annuler</a><button class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90" type="submit"><twig:ux:icon name="lucide:save" class="size-4"/>Enregistrer le brouillon</button></div>
{{ form_end(form) }}
