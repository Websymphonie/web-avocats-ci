<twig:ActionDropdown>
    {% if is_granted('CONTENT_GALLERY_VIEW') %}<a href="{{ path('content_admin_gallery_show', {id: gallery.id}) }}"><twig:ux:icon name="lucide:eye" class="size-4"/>Voir</a>{% endif %}
    {% if is_granted('CONTENT_GALLERY_MANAGE') %}<a href="{{ path('content_admin_gallery_edit', {id: gallery.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}
    {% if gallery.status.value == 'DRAFT' and is_granted('CONTENT_GALLERY_PUBLISH') %}<form method="post" action="{{ path('content_admin_gallery_publish', {id: gallery.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('gallery_publish_' ~ gallery.id) }}"><button type="submit"><twig:ux:icon name="lucide:send" class="size-4"/>Publier</button></form>{% elseif gallery.status.value == 'PUBLISHED' and is_granted('CONTENT_GALLERY_PUBLISH') %}<form method="post" action="{{ path('content_admin_gallery_archive', {id: gallery.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('gallery_archive_' ~ gallery.id) }}"><button type="submit"><twig:ux:icon name="lucide:archive" class="size-4"/>Archiver</button></form>{% endif %}
    {% if is_granted('CONTENT_GALLERY_DELETE') %}{{ component('DeleteFormComponent', {id: gallery.id, instanceId: instanceId, urlPath: path('content_admin_gallery_delete', {id: gallery.id}), csrfTokenId: 'delete', buttonLabel: 'Supprimer', description: 'La galerie « ' ~ gallery.title ~ ' » sera supprimée. Les médias seront conservés.'}) }}{% endif %}
</twig:ActionDropdown>
