{% extends 'layouts/base.html.twig' %}{% block title %}Modifier la galerie{% endblock %}{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-5xl space-y-6"><div class="flex flex-wrap items-start justify-between gap-4"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_gallery_list') }}">← Galeries photos</a><div class="mt-3 flex items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">Modifier la galerie</h1><twig:Badge variant="{{ gallery.status.value == 'PUBLISHED' ? 'success' : (gallery.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ gallery.status.value }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">Le statut, l’ordre et la couverture sont gérés par des actions dédiées.</p></div>{% if is_granted('CONTENT_GALLERY_VIEW') %}<a class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('content_admin_gallery_show', {id: gallery.id}) }}"><twig:ux:icon name="lucide:eye" class="size-4"/>Voir</a>{% endif %}</div><section class="rounded-2xl border border-border bg-card p-6 shadow-sm">{% include 'content/admin/photo_gallery/_form.html.twig' %}</section>{% if is_granted('CONTENT_GALLERY_MANAGE') %}<section class="rounded-2xl border border-border bg-card p-6 shadow-sm"><div class="mb-4"><h2 class="text-base font-semibold">Ajouter des images</h2><p class="mt-1 text-sm text-muted-foreground">Les nouvelles images sont ajoutées à la fin. Elles nécessitent un texte alternatif avant publication.</p></div>{{ form_start(uploadForm, {attr: {'data-controller': 'gallery-upload', 'data-action': 'dragover->gallery-upload#dragover dragleave->gallery-upload#dragleave drop->gallery-upload#drop'}}) }}<div class="rounded-xl border-2 border-dashed border-border bg-muted/20 p-5 text-center"><p class="text-sm font-medium">Déposez vos fichiers ici</p>{{ form_widget(uploadForm.images, {attr: {class: 'sr-only', 'data-gallery-upload-target': 'input', 'data-action': 'change->gallery-upload#changed'}}) }}<button type="button" class="mt-3 inline-flex h-9 items-center rounded-lg border border-input bg-background px-3 text-sm font-medium hover:bg-muted" data-action="gallery-upload#choose">Choisir des images</button></div><ul class="mt-3 grid gap-2 sm:grid-cols-2" data-gallery-upload-target="preview" aria-live="polite"></ul><div class="mt-4 flex justify-end"><button type="submit" class="inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground"><twig:ux:icon name="lucide:upload" class="size-4"/>Ajouter les images</button></div>{{ form_end(uploadForm) }}</section>{% endif %}{% if gallery.items is not empty %}<section class="rounded-2xl border border-border bg-card p-6 shadow-sm"><div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-base font-semibold">Ordre et couverture</h2><p class="mt-1 text-sm text-muted-foreground">Glissez les cartes ou utilisez Monter et Descendre. Enregistrez ensuite l’ordre.</p></div><form id="gallery-reorder" method="post" action="{{ path('content_admin_gallery_reorder', {id: gallery.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('gallery_reorder_' ~ gallery.id) }}"><button class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" type="submit"><twig:ux:icon name="lucide:arrow-down-up" class="size-4"/>Enregistrer l’ordre</button></form></div><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-controller="gallery-reorder">{% for item in gallery.items %}<article draggable="true" data-gallery-reorder-target="item" data-action="dragstart->gallery-reorder#start dragover->gallery-reorder#over drop->gallery-reorder#drop" class="rounded-xl border border-border bg-muted/20 p-3"><input type="hidden" form="gallery-reorder" name="mediaIds[]" value="{{ item.mediaId }}">{% if mediaUrls[item.mediaId] is defined %}<img class="aspect-[4/3] w-full rounded-lg object-cover" src="{{ mediaUrls[item.mediaId]|imagine_filter('thumbnail') }}" alt="{{ item.altText }}">{% endif %}<div class="mt-3 flex items-center justify-between gap-2"><span class="text-sm font-medium">Position {{ item.position }}</span><div class="flex gap-1"><button type="button" class="inline-flex size-8 items-center justify-center rounded-md hover:bg-muted" data-action="gallery-reorder#moveUp" aria-label="Monter l’image"><twig:ux:icon name="lucide:arrow-up" class="size-4"/></button><button type="button" class="inline-flex size-8 items-center justify-center rounded-md hover:bg-muted" data-action="gallery-reorder#moveDown" aria-label="Descendre l’image"><twig:ux:icon name="lucide:arrow-down" class="size-4"/></button></div></div><div class="mt-3 grid gap-2"><form method="post" action="{{ path('content_admin_gallery_set_cover', {id: gallery.id, mediaId: item.mediaId}) }}"><input type="hidden" name="_token" value="{{ csrf_token('gallery_cover_' ~ gallery.id ~ '_' ~ item.mediaId) }}"><button class="inline-flex h-9 w-full items-center justify-center gap-2 rounded-lg border border-input bg-background text-sm font-medium hover:bg-muted" type="submit">{% if gallery.coverMediaId == item.mediaId %}<twig:ux:icon name="lucide:badge-check" class="size-4"/>Couverture{% else %}<twig:ux:icon name="lucide:image-up" class="size-4"/>Définir comme couverture{% endif %}</button></form><form method="post" action="{{ path('content_admin_gallery_remove_item', {id: gallery.id, mediaId: item.mediaId}) }}"><input type="hidden" name="_token" value="{{ csrf_token('gallery_remove_' ~ gallery.id ~ '_' ~ item.mediaId) }}"><button class="inline-flex h-9 w-full items-center justify-center gap-2 rounded-lg text-sm font-medium text-destructive hover:bg-destructive/10" type="submit"><twig:ux:icon name="lucide:trash-2" class="size-4"/>Retirer</button></form></div></article>{% endfor %}</div></section>{% endif %}</div></main>{% endblock %}
