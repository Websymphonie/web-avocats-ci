{% extends 'layouts/base.html.twig' %}{% block title %}Galeries photos{% endblock %}{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-7xl space-y-6"><section class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between"><div><p class="text-sm font-medium text-muted-foreground">Contenu</p><h1 class="mt-1 text-2xl font-semibold tracking-[-0.03em]">Galeries photos</h1><p class="mt-2 text-sm text-muted-foreground">Images publiques éditoriales, sans médiathèque générale.</p></div>{% if is_granted('CONTENT_GALLERY_MANAGE') %}<a class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs hover:bg-primary/90" href="{{ path('content_admin_gallery_new') }}"><twig:ux:icon name="lucide:plus" class="size-4"/>Nouvelle galerie</a>{% endif %}</section><details class="group rounded-2xl border border-border bg-card shadow-sm" {% if app.request.query.all|length > 0 %}open{% endif %}><summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-sm font-medium"><span class="flex items-center gap-2"><twig:ux:icon name="lucide:list-filter" class="size-4 text-muted-foreground"/>Filtrer les galeries</span><twig:ux:icon name="lucide:chevron-down" class="size-4 text-muted-foreground transition-transform group-open:rotate-180"/></summary><div class="border-t border-border px-6 py-5">{{ form_start(filterForm, {attr: {class: 'grid gap-4 md:grid-cols-[minmax(0,1fr)_180px_180px_auto]', novalidate: true}}) }}{% for field in [filterForm.search, filterForm.status, filterForm.tagId] %}<div class="space-y-2">{{ form_label(field, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(field, {attr: {class: 'flex h-10 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}</div>{% endfor %}<div class="flex items-end gap-2"><button class="inline-flex h-10 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Appliquer</button><a class="inline-flex h-10 items-center justify-center rounded-lg px-3 text-sm font-medium text-muted-foreground" href="{{ path('content_admin_gallery_list') }}">Réinitialiser</a></div>{{ form_end(filterForm) }}</div></details><form id="photo-gallery-bulk-delete" method="post" action="{{ path('content_admin_gallery_bulk_delete') }}"><input type="hidden" name="_token" value="{{ csrf_token('photo-gallery-bulk-delete') }}"></form><twig:BulkSelection id="photo-gallery-selection" inputName="ids[]" inputForm="photo-gallery-bulk-delete" selectionLabelSingular="galerie" selectionLabelPlural="galeries" confirmationTemplate="Supprimer {count} galerie(s) ?" confirmationDescriptionTemplate="{count} galerie(s) seront supprimées. Les médias restent conservés.">{% block actions %}{% if is_granted('CONTENT_GALLERY_DELETE') %}{{ component('BulkDeletePhotoGalleries', {formId: 'photo-gallery-bulk-delete'}) }}{% endif %}{% endblock %}{% block content %}<section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm"><div class="flex items-center justify-between border-b border-border px-5 py-4 sm:px-6"><div class="flex items-start gap-3"><label class="mt-0.5 inline-flex size-9 items-center justify-center rounded-lg hover:bg-muted"><input type="checkbox" class="size-4 rounded border-input accent-primary" data-bulk-selection-target="master" aria-label="Sélectionner toutes les galeries de la page"></label><div><h2 class="text-sm font-semibold">Registre des galeries</h2><p class="mt-1 text-sm text-muted-foreground">{{ galleries.totalItemCount }} galerie{{ galleries.totalItemCount > 1 ? 's' : '' }}</p></div></div></div><div class="divide-y divide-border md:hidden">{% for gallery in galleries.items %}<article class="space-y-4 p-5"><div class="flex items-start gap-3"><label class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg hover:bg-muted"><input type="checkbox" value="{{ gallery.id }}" class="size-4 rounded border-input accent-primary" data-bulk-selection-target="row" aria-label="Sélectionner la galerie : {{ gallery.title }}"></label><div class="min-w-0 flex-1"><h3 class="font-medium">{{ gallery.title }}</h3><p class="mt-1 text-sm text-muted-foreground">{{ gallery.items|length }} image{{ gallery.items|length > 1 ? 's' : '' }}</p></div></div><div class="flex items-center justify-between border-y border-border py-3 text-sm"><span class="text-muted-foreground">Statut</span><twig:Badge variant="{{ gallery.status.value == 'PUBLISHED' ? 'success' : (gallery.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ gallery.status.value }}</twig:Badge></div><div class="flex justify-end">{{ component('PhotoGalleryTableDropdown', {gallery: gallery, instanceId: 'mobile-' ~ gallery.id}) }}</div></article>{% else %}<div class="px-6 py-14 text-center text-muted-foreground">Aucune galerie ne correspond à vos critères.</div>{% endfor %}</div><div class="hidden overflow-x-auto md:block"><table class="w-full text-left text-sm"><thead class="bg-muted/50 text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-5 py-3 font-medium"><span class="sr-only">Sélection</span></th><th class="px-5 py-3 font-medium">Couverture</th><th class="px-5 py-3 font-medium">Titre</th><th class="px-5 py-3 font-medium">Images</th><th class="px-5 py-3 font-medium">Statut</th><th class="px-5 py-3 font-medium">Publication</th><th class="px-5 py-3 text-right font-medium">Actions</th></tr></thead><tbody class="divide-y divide-border">{% for gallery in galleries.items %}<tr class="transition-colors hover:bg-muted/40"><td class="px-5 py-4"><label class="inline-flex size-9 items-center justify-center rounded-lg hover:bg-muted"><input type="checkbox" value="{{ gallery.id }}" class="size-4 rounded border-input accent-primary" data-bulk-selection-target="row" aria-label="Sélectionner la galerie : {{ gallery.title }}"></label></td><td class="px-5 py-4">{% if gallery.coverMediaId and mediaUrls[gallery.coverMediaId] is defined %}<img class="size-12 rounded-lg border border-border object-cover" src="{{ mediaUrls[gallery.coverMediaId]|imagine_filter('thumbnail') }}" alt="">{% else %}<span class="inline-flex size-12 items-center justify-center rounded-lg bg-muted text-muted-foreground"><twig:ux:icon name="lucide:image" class="size-5"/></span>{% endif %}</td><td class="px-5 py-4"><p class="font-medium">{{ gallery.title }}</p><p class="mt-1 text-xs text-muted-foreground">/{{ gallery.slug }}</p></td><td class="px-5 py-4">{{ gallery.items|length }}</td><td class="px-5 py-4"><twig:Badge variant="{{ gallery.status.value == 'PUBLISHED' ? 'success' : (gallery.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ gallery.status.value }}</twig:Badge></td><td class="px-5 py-4 text-muted-foreground">{{ gallery.publishedAt ? gallery.publishedAt|date('d/m/Y H:i') : '—' }}</td><td class="px-5 py-4"><div class="flex justify-end">{{ component('PhotoGalleryTableDropdown', {gallery: gallery, instanceId: 'desktop-' ~ gallery.id}) }}</div></td></tr>{% else %}<tr><td class="px-6 py-14 text-center text-muted-foreground" colspan="7">Aucune galerie ne correspond à vos critères.</td></tr>{% endfor %}</tbody></table></div>{% include 'shared/views/_list_pagination.html.twig' with {pager: galleries, route: 'content_admin_gallery_list'} only %}</section>{% endblock %}</twig:BulkSelection></div></main>{% endblock %}
