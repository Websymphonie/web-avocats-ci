{% extends 'layouts/base.html.twig' %}{% block title %}{{ gallery.title }}{% endblock %}{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-5xl space-y-6"><div class="flex flex-wrap items-start justify-between gap-4"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('content_admin_gallery_list') }}">← Galeries photos</a><div class="mt-3 flex items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">{{ gallery.title }}</h1><twig:Badge variant="{{ gallery.status.value == 'PUBLISHED' ? 'success' : (gallery.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ gallery.status.value }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">/{{ gallery.slug }} · {{ gallery.items|length }} image{{ gallery.items|length > 1 ? 's' : '' }}</p></div>{% if is_granted('CONTENT_GALLERY_MANAGE') %}<a class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('content_admin_gallery_edit', {id: gallery.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}</div><section class="rounded-2xl border border-border bg-card p-6 shadow-sm"><div class="rich-content text-sm">{{ safeDescription|raw }}</div>{% if gallery.tags is not empty %}<div class="mt-5 flex flex-wrap gap-2">{% for tag in gallery.tags %}<twig:Badge variant="outline">#{{ tag.name }}</twig:Badge>{% endfor %}</div>{% endif %}<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{% for item in gallery.items %}{% if mediaUrls[item.mediaId] is defined %}<figure class="overflow-hidden rounded-xl border border-border bg-muted/20"><img class="aspect-[4/3] w-full object-cover" src="{{ mediaUrls[item.mediaId]|imagine_filter('thumbnail') }}" alt="{{ item.altText }}">{% if item.caption %}<figcaption class="p-3 text-sm text-muted-foreground">{{ item.caption }}</figcaption>{% endif %}</figure>{% endif %}{% endfor %}</div></section></div></main>{% endblock %}
