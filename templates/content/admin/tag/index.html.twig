{% extends 'layouts/base.html.twig' %}
{% block title %}Tags{% endblock %}
{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-7xl space-y-6">
<section class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between"><div><p class="text-sm font-medium text-muted-foreground">Contenu</p><h1 class="mt-1 text-2xl font-semibold">Tags</h1><p class="mt-2 text-sm text-muted-foreground">Utilisez des mots-clés réutilisables pour qualifier les actualités.</p></div>{% if is_granted('CONTENT_TAG_MANAGE') %}<a class="inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" href="{{ path('content_admin_tag_new') }}"><twig:ux:icon name="lucide:plus" class="size-4"/>Nouveau tag</a>{% endif %}</section>
<details class="group rounded-2xl border border-border bg-card shadow-sm" {% if app.request.query.all|length > 0 %}open{% endif %}><summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-sm font-medium"><span class="flex items-center gap-2"><twig:ux:icon name="lucide:list-filter" class="size-4 text-muted-foreground"/>Filtrer les tags</span><twig:ux:icon name="lucide:chevron-down" class="size-4 transition-transform group-open:rotate-180"/></summary><div class="border-t border-border px-6 py-5">{{ form_start(filterForm, {attr: {class: 'flex flex-col gap-3 sm:flex-row', novalidate: true}}) }}{{ form_widget(filterForm.search, {attr: {class: 'flex h-10 min-w-0 flex-1 rounded-lg border border-input bg-background px-3 text-sm'}}) }}<button class="inline-flex h-10 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Appliquer</button><a class="inline-flex h-10 items-center justify-center rounded-lg px-3 text-sm text-muted-foreground" href="{{ path('content_admin_tag_list') }}">Réinitialiser</a>{{ form_end(filterForm) }}</div></details>
<form id="tag-bulk-delete" method="post" action="{{ path('content_admin_tag_bulk_delete') }}"><input type="hidden" name="_token" value="{{ csrf_token('tag-bulk-delete') }}"></form>
<twig:BulkSelection id="tag-selection" inputName="ids[]" inputForm="tag-bulk-delete" selectionLabelSingular="tag" selectionLabelPlural="tags" confirmationTemplate="Supprimer {count} tag(s) ?" confirmationDescriptionTemplate="Les tags utilisés par une actualité seront refusés.">{% block actions %}{% if is_granted('CONTENT_TAG_DELETE') %}{{ component('BulkDeleteTags', {formId: 'tag-bulk-delete'}) }}{% endif %}{% endblock %}{% block content %}<section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm"><div class="flex items-center justify-between border-b border-border px-5 py-4"><div class="flex items-center gap-3"><label class="inline-flex size-9 items-center justify-center"><input type="checkbox" class="size-4 accent-primary" data-bulk-selection-target="master" aria-label="Sélectionner tous les tags"></label><div><h2 class="text-sm font-semibold">Référentiel des tags</h2><p class="mt-1 text-sm text-muted-foreground">{{ tags.totalItemCount }} tag{{ tags.totalItemCount > 1 ? 's' : '' }}</p></div></div></div><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-muted/50 text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-5 py-3"><span class="sr-only">Sélection</span></th><th class="px-5 py-3">Nom</th><th class="px-5 py-3">Slug</th><th class="px-5 py-3 text-right">Actions</th></tr></thead><tbody class="divide-y divide-border">{% for tag in tags.items %}<tr class="hover:bg-muted/40"><td class="px-5 py-4"><input type="checkbox" value="{{ tag.id }}" class="size-4 accent-primary" data-bulk-selection-target="row" aria-label="Sélectionner le tag : {{ tag.name }}"></td><td class="px-5 py-4 font-medium">{{ tag.name }}</td><td class="px-5 py-4 text-muted-foreground">{{ tag.slug }}</td><td class="px-5 py-4"><div class="flex justify-end">{{ component('TagTableDropdown', {tag: tag, instanceId: 'tag-' ~ tag.id}) }}</div></td></tr>{% else %}<tr><td colspan="4" class="px-6 py-14 text-center text-muted-foreground">Aucun tag.</td></tr>{% endfor %}</tbody></table></div>{% include 'shared/views/_list_pagination.html.twig' with {pager: tags, route: 'content_admin_tag_list'} only %}</section>{% endblock %}</twig:BulkSelection>
</div></main>
{% endblock %}
