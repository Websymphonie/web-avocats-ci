{% extends 'emails/_layout.html.twig' %}

{% block email_title %}Alerte technique — {{ title }}{% endblock %}
{% block email_preheader %}Une erreur applicative nécessite votre attention.{% endblock %}

{% block email_content %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr><td style="font-size:13px;font-weight:700;color:#b91c1c;text-transform:uppercase;letter-spacing:0.08em;">Alerte technique</td></tr>
        <tr><td style="padding-top:10px;font-size:24px;line-height:1.3;font-weight:700;color:#18181b;letter-spacing:-0.02em;">{{ title }}</td></tr>
        <tr><td style="padding-top:18px;font-size:14px;line-height:1.65;color:#52525b;">Une erreur a été détectée par l’application. Les informations techniques disponibles sont présentées ci-dessous.</td></tr>
        <tr><td style="padding-top:22px;"><div style="border:1px solid #fecaca;border-radius:12px;background:#fef2f2;padding:16px;color:#7f1d1d;font-family:'Courier New',monospace;font-size:12px;line-height:1.65;white-space:pre-wrap;word-break:break-word;">{{ message|default('Aucun détail supplémentaire.') }}</div></td></tr>
        <tr><td style="padding-top:20px;font-size:12px;line-height:1.6;color:#71717a;">Cet email peut contenir des informations techniques sensibles. Ne le transférez qu’aux personnes chargées de la maintenance.</td></tr>
    </table>
{% endblock %}
