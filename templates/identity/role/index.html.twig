{% extends 'layouts/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <div class="mx-auto max-w-6xl space-y-6">
            {{ component('Breadcrumbs', {'breadcrumbs': breadcrumbs}) }}

            <section class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
                <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <p class="text-sm font-medium text-muted-foreground">Administration des accès</p>
                        <h1 class="mt-1 text-2xl font-semibold tracking-[-0.03em]">Rôles et permissions</h1>
                        <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Adaptez les actions autorisées pour
                            chaque rôle sans modifier les comptes existants.</p>
                    </div>
                    <a class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium shadow-xs transition-colors hover:bg-muted"
                       href="{{ path('app_user_index') }}">
                        <twig:ux:icon name="lucide:users-round" class="size-4" aria-hidden="true"/>
                        Comptes utilisateurs
                    </a>
                </div>

                <div class="mt-6 flex gap-3 rounded-xl border border-primary/20 bg-primary/5 p-4 text-sm text-muted-foreground">
                    <twig:ux:icon name="lucide:shield-check" class="mt-0.5 size-5 shrink-0 text-primary"
                                  aria-hidden="true"/>
                    <p>Le super administrateur conserve toujours tous les accès afin d’éviter tout verrouillage de
                        l’application.</p>
                </div>
            </section>

            <section class="grid gap-5 md:grid-cols-2" aria-label="Rôles configurables">
                {% for configuration in rolePermissions %}
                    {% set roleVisuals = {
                        'ROLE_AVOCAT': {'class': 'bg-violet-500/10 text-violet-700 dark:text-violet-300', 'icon': 'lucide:wallet-cards'},
                    } %}
                    {% set roleVisual = roleVisuals[configuration.role.value]|default({'class': 'bg-muted text-muted-foreground', 'icon': 'lucide:shield'}) %}
                    <article
                            class="flex flex-col rounded-2xl border border-border bg-card p-6 shadow-sm transition-shadow hover:shadow-md">
                        <div class="flex items-start justify-between gap-4">
                            <span class="flex size-11 items-center justify-center rounded-xl {{ roleVisual['class'] }}">
                                <twig:ux:icon name="{{ roleVisual['icon'] }}" class="size-5" aria-hidden="true"/>
                            </span>
                            <span class="rounded-full px-2.5 py-1 text-xs font-medium {{ configuration.id ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300' : 'bg-muted text-muted-foreground' }}">{{ configuration.id ? 'Personnalisé' : 'Configuration par défaut' }}</span>
                        </div>
                        <h2 class="mt-5 text-lg font-semibold">{{ configuration.role.label }}</h2>
                        <p class="mt-2 text-sm text-muted-foreground">{{ configuration.permissions|length }}
                            permission{{ configuration.permissions|length > 1 ? 's' : '' }} actuellement
                            accordée{{ configuration.permissions|length > 1 ? 's' : '' }}.</p>
                        <div class="mt-6 border-t border-border pt-5">
                            <a class="inline-flex h-10 w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90"
                               href="{{ path('app_role_permissions_update', {role: configuration.role.value}) }}">
                                <twig:ux:icon name="lucide:sliders-horizontal" class="size-4" aria-hidden="true"/>
                                Configurer les accès
                            </a>
                        </div>
                    </article>
                {% endfor %}
            </section>
        </div>
    </main>
{% endblock %}
