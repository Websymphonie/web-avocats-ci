{% extends 'layouts/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <div class="mx-auto max-w-3xl space-y-6">
            {{ component('Breadcrumbs', {'breadcrumbs': breadcrumbs}) }}
            <section class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
                <div class="border-b border-border pb-6">
                    <p class="text-sm font-medium text-muted-foreground">Administration</p>
                    <h1 class="mt-1 text-2xl font-semibold tracking-[-0.03em]">Modifier le compte</h1>
                    <p class="mt-2 text-sm text-muted-foreground">Mettez à jour l’adresse, le rôle et l’accès de {{ command.email }}.</p>
                </div>
                {{ form_start(form, {'attr': {'class': 'mt-7 space-y-6', 'data-loading-label': 'Enregistrement…'}}) }}
                {{ form_errors(form) }}
                <div class="space-y-2">
                    {{ form_label(form.name, null, {'label_attr': {'class': 'text-sm font-medium'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/30', 'autocomplete': 'name'}}) }}
                    <div class="text-sm text-destructive">{{ form_errors(form.name) }}</div>
                </div>
                <div class="space-y-2">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'text-sm font-medium'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}
                    <div class="text-sm text-destructive">{{ form_errors(form.email) }}</div>
                </div>
                <fieldset class="space-y-3">
                    <legend class="text-sm font-medium">{{ form.roles.vars.label }}</legend>
                    <div class="grid gap-3 sm:grid-cols-2">
                        {% for role in form.roles %}
                            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border p-4 hover:bg-muted/50" for="{{ role.vars.id }}">
                                {{ form_widget(role, {'attr': {'class': 'size-4 rounded border-input text-primary'}}) }}
                                <span class="text-sm font-medium">{{ role.vars.label }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
                <label class="flex items-start gap-3 rounded-xl border border-border p-4" for="{{ form.enabled.vars.id }}">
                    {{ form_widget(form.enabled, {'attr': {'class': 'mt-0.5 size-4 rounded border-input text-primary'}}) }}
                    <span><span class="block text-sm font-medium">Compte actif</span><span class="mt-1 block text-xs text-muted-foreground">Autoriser cet utilisateur à se connecter.</span></span>
                </label>
                <div class="flex flex-col-reverse gap-3 border-t border-border pt-6 sm:flex-row sm:justify-end">
                    <a class="inline-flex h-10 items-center justify-center rounded-lg border border-border px-4 text-sm font-medium hover:bg-muted" href="{{ path('app_user_index') }}">Annuler</a>
                    <button class="inline-flex h-10 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90" type="submit">Enregistrer</button>
                </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
