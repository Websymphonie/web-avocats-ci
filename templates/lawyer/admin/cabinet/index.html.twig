{% extends 'layouts/base.html.twig' %}

{% block title %}Gestion des cabinets{% endblock %}

{% block body %}
    <main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <div class="mx-auto max-w-7xl space-y-6">
            <section class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:p-8">
                <div>
                    <p class="text-sm font-medium text-muted-foreground">Espace professionnel</p>
                    <h1 class="mt-1 text-2xl font-semibold tracking-[-0.03em]">Gestion des cabinets</h1>
                    <p class="mt-2 text-sm text-muted-foreground">Gérez les cabinets proposés aux avocats lors de la complétion de leur profil.</p>
                </div>
                {% if is_granted('CABINET_CREATE') %}
                    <a href="{{ path('lawyer_admin_cabinet_new') }}" class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                        <twig:ux:icon name="lucide:plus" class="size-4" aria-hidden="true"/>Nouveau cabinet
                    </a>
                {% endif %}
            </section>

            <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
                <div class="flex items-center justify-between border-b border-border px-6 py-5 sm:px-8">
                    <div><h2 class="text-base font-semibold">Cabinets enregistrés</h2><p class="mt-1 text-sm text-muted-foreground">{{ cabinets|length }} cabinet{{ cabinets|length == 1 ? '' : 's' }} disponible{{ cabinets|length == 1 ? '' : 's' }}.</p></div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[760px] text-left text-sm">
                        <thead class="bg-muted/40 text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-6 py-3 sm:px-8">Cabinet</th><th class="px-6 py-3">Ville</th><th class="px-6 py-3">Contact</th><th class="px-6 py-3">Statut</th><th class="px-6 py-3 text-right sm:px-8">Actions</th></tr></thead>
                        <tbody class="divide-y divide-border">
                        {% for cabinet in cabinets %}
                            <tr class="transition-colors hover:bg-muted/40">
                                <td class="px-6 py-5 sm:px-8"><p class="font-medium">{{ cabinet.name }}</p>{% if cabinet.registrationNumber %}<p class="mt-1 text-xs text-muted-foreground">{{ cabinet.registrationNumber }}</p>{% endif %}</td>
                                <td class="px-6 py-5 text-muted-foreground">{{ cabinet.city ?: '—' }}</td>
                                <td class="px-6 py-5 text-muted-foreground">{{ cabinet.email ?: cabinet.phone ?: '—' }}</td>
                                <td class="px-6 py-5"><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium {{ cabinet.active ? 'bg-emerald-500/10 text-emerald-600' : 'bg-muted text-muted-foreground' }}">{{ cabinet.status == 'ACTIVE' ? 'Actif' : (cabinet.status == 'ARCHIVED' ? 'Archivé' : 'Inactif') }}</span></td>
                                <td class="px-6 py-5 text-right sm:px-8">{% if is_granted('CABINET_EDIT') %}<a href="{{ path('lawyer_admin_cabinet_edit', {id: cabinet.id}) }}" class="inline-flex h-9 items-center justify-center gap-2 rounded-lg border border-border px-3 text-sm font-medium transition hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><twig:ux:icon name="lucide:pencil" class="size-4" aria-hidden="true"/>Modifier</a>{% else %}<span class="text-muted-foreground">—</span>{% endif %}</td>
                            </tr>
                        {% else %}<tr><td colspan="5" class="px-6 py-16 text-center text-muted-foreground sm:px-8">Aucun cabinet enregistré.</td></tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
