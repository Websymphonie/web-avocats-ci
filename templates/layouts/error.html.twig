<!doctype html>
<html lang="{{ app.request.attributes.get('_locale') }}">
<head>
    <title>{{ reglageValue('app_title').value }} — {% block title %}Erreur{% endblock %}</title>
    <twig:SeoComponent/>

    <twig:ScriptComponent/>
    
    {{ encore_entry_link_tags('app') }}
</head>
<body class="min-h-svh bg-background text-foreground antialiased">
<main class="relative flex min-h-svh items-center justify-center overflow-hidden px-5 py-12 sm:px-8">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,color-mix(in_srgb,var(--color-primary)_12%,transparent),transparent_30%),radial-gradient(circle_at_85%_80%,color-mix(in_srgb,var(--color-muted-foreground)_10%,transparent),transparent_32%)]"></div>
    <div class="relative w-full max-w-4xl">
        <div class="mb-8 flex items-center justify-center gap-3">
            <span class="flex size-10 items-center justify-center rounded-xl bg-foreground text-sm font-bold text-background shadow-sm">
                {{ reglageValue('app_title').value|slice(0, 1)|upper }}
            </span>
            <span class="text-sm font-semibold tracking-tight">{{ reglageValue('app_title').value }}</span>
        </div>
        {% block error_content %}{% endblock %}
        <p class="mt-7 text-center text-xs text-muted-foreground">
            © {{ 'now'|date('Y') }} {{ reglageValue('app_title').value }} · Espace interne sécurisé
        </p>
    </div>
</main>
{{ encore_entry_script_tags('app') }}
</body>
</html>
