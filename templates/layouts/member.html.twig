<!DOCTYPE html>
<html lang="{{ app.request.attributes.get('_locale') }}">
<head>
    <title>{{ reglageValue('app_title').value }} - {% block title %}{% endblock %}</title>
    <twig:SeoComponent/>
    <twig:ScriptComponent/>
    {{ encore_entry_link_tags('web') }}
    {% block stylesheets %}{% endblock %}
</head>
<body class="min-h-svh bg-muted/30 text-foreground antialiased dark:bg-[#0c1625]"
      data-controller="sidebar"
      data-action="keydown.esc@window->sidebar#close resize@window->sidebar#handleResize">
<div id="memberShell" class="min-h-svh">
    {% set currentRoute = app.request.attributes.get('_route') %}
    {% set userName = app.user.name ?? app.user.userIdentifier %}

    <div class="fixed inset-0 z-40 hidden bg-slate-950/40 backdrop-blur-sm lg:hidden"
         data-sidebar-target="overlay"
         data-action="click->sidebar#close"></div>

    <aside class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col border-r border-white/10 bg-[#10233f] text-white shadow-2xl shadow-slate-950/20 transition-transform duration-200 ease-out lg:translate-x-0"
           data-sidebar-target="panel"
           aria-label="Navigation de l’espace avocat">
        <div class="flex h-20 shrink-0 items-center justify-between border-b border-white/10 px-5">
            <a href="{{ path('app_member') }}" class="flex min-w-0 items-center gap-3 rounded-xl outline-none focus-visible:ring-2 focus-visible:ring-[#d8b878]">
                <span class="flex size-10 shrink-0 items-center justify-center border border-[#d8b878]/70 text-xs font-semibold tracking-[0.16em] text-[#f1d59b]">AC</span>
                <span class="min-w-0">
                    <span class="block truncate text-sm font-semibold tracking-wide text-white">Avocat CI</span>
                    <span class="mt-0.5 block truncate text-[0.65rem] uppercase tracking-[0.18em] text-white/45">Espace avocat</span>
                </span>
            </a>

            <button class="inline-flex size-9 items-center justify-center rounded-lg text-white/60 transition hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#d8b878] lg:hidden"
                    type="button"
                    data-action="sidebar#close"
                    aria-label="Fermer la navigation">
                <twig:ux:icon name="lucide:x" class="size-5" aria-hidden="true"/>
            </button>
        </div>

        <nav class="flex-1 overflow-y-auto px-4 py-6" aria-label="Navigation membre">
            <p class="px-3 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-white/35">Mon espace</p>
            <div class="mt-3 space-y-1.5">
                <a href="{{ path('app_member') }}"
                   class="group flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium outline-none transition focus-visible:ring-2 focus-visible:ring-[#d8b878] {{ currentRoute == 'app_member' ? 'bg-[#d8b878] text-[#10233f] shadow-lg shadow-black/10' : 'text-white/70 hover:bg-white/10 hover:text-white' }}">
                    <twig:ux:icon name="lucide:layout-dashboard" class="size-[18px] shrink-0" aria-hidden="true"/>
                    <span>Tableau de bord</span>
                </a>
                <a href="{{ path('member_notifications_index') }}"
                   class="group relative flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium outline-none transition focus-visible:ring-2 focus-visible:ring-[#d8b878] {{ currentRoute starts with 'member_notifications_' ? 'bg-white/12 text-white' : 'text-white/70 hover:bg-white/10 hover:text-white' }}">
                    <twig:ux:icon name="lucide:bell" class="size-[18px] shrink-0" aria-hidden="true"/>
                    <span class="flex-1">Notifications</span>
                    {{ component('NotificationCount') }}
                </a>
                <a href="{{ path('member_profile') }}"
                   class="group flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium outline-none transition focus-visible:ring-2 focus-visible:ring-[#d8b878] {{ currentRoute == 'member_profile' ? 'bg-white/12 text-white' : 'text-white/70 hover:bg-white/10 hover:text-white' }}">
                    <twig:ux:icon name="lucide:user-round" class="size-[18px] shrink-0" aria-hidden="true"/>
                    <span>Mon profil</span>
                </a>
            </div>

            <div class="my-7 border-t border-white/10"></div>

            <p class="px-3 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-white/35">Accès public</p>
            <div class="mt-3">
                <a href="{{ path('app_home') }}"
                   class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/70 outline-none transition hover:bg-white/10 hover:text-white focus-visible:ring-2 focus-visible:ring-[#d8b878]">
                    <twig:ux:icon name="lucide:arrow-up-right" class="size-[18px] shrink-0" aria-hidden="true"/>
                    <span>Revenir au site</span>
                </a>
            </div>
        </nav>

        <div class="shrink-0 border-t border-white/10 p-4">
            <div class="mb-3 flex items-center gap-3 rounded-xl bg-white/[0.06] px-3 py-2.5">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-[#d8b878] text-sm font-semibold text-[#10233f]">{{ userName|slice(0, 1)|upper }}</span>
                <div class="min-w-0">
                    <p class="truncate text-sm font-medium text-white">{{ userName }}</p>
                    <p class="truncate text-xs text-white/45">{{ app.user.userIdentifier }}</p>
                </div>
            </div>
            <form method="post" action="{{ path('app_logout') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button class="flex min-h-10 w-full items-center gap-3 rounded-xl px-3 text-left text-sm font-medium text-white/55 outline-none transition hover:bg-red-400/10 hover:text-red-200 focus-visible:ring-2 focus-visible:ring-[#d8b878]"
                        type="submit">
                    <twig:ux:icon name="lucide:log-out" class="size-[18px] shrink-0" aria-hidden="true"/>
                    <span>Se déconnecter</span>
                </button>
            </form>
        </div>
    </aside>

    <header class="fixed inset-x-0 top-0 z-30 flex h-16 items-center justify-between border-b border-border bg-background/95 px-4 backdrop-blur supports-[backdrop-filter]:bg-background/80 sm:px-6 lg:left-72 lg:px-8">
        <div class="flex min-w-0 items-center gap-3">
            <button class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg border border-border bg-background text-muted-foreground transition hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring lg:hidden"
                    type="button"
                    data-action="sidebar#open"
                    aria-label="Ouvrir la navigation">
                <twig:ux:icon name="lucide:menu" class="size-5" aria-hidden="true"/>
            </button>
            <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-foreground">{% block member_page_title %}{{ title }}{% endblock %}</p>
                <p class="hidden truncate text-xs text-muted-foreground sm:block">Espace avocat</p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <button class="inline-flex size-10 items-center justify-center rounded-lg border border-border bg-background text-muted-foreground shadow-xs transition hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                    type="button"
                    data-controller="theme-toggle"
                    data-action="theme-toggle#toggle"
                    aria-label="Activer le mode sombre"
                    aria-pressed="false">
                <twig:ux:icon name="lucide:sun" class="size-4 dark:hidden" aria-hidden="true"/>
                <twig:ux:icon name="lucide:moon" class="hidden size-4 dark:block" aria-hidden="true"/>
                <span class="sr-only">Changer de thème</span>
            </button>
            <a class="relative inline-flex size-10 items-center justify-center rounded-lg border border-border bg-background text-muted-foreground shadow-xs transition hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
               href="{{ path('member_notifications_index') }}"
               aria-label="Voir les notifications">
                <twig:ux:icon name="lucide:bell" class="size-4" aria-hidden="true"/>
                {{ component('NotificationCount') }}
            </a>
            <details class="group relative">
                <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg p-1 outline-none transition hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring marker:hidden"
                         aria-haspopup="menu">
                    <span class="flex size-8 items-center justify-center rounded-md bg-[#10233f] text-xs font-semibold text-[#f1d59b] dark:bg-[#d8b878] dark:text-[#10233f]">{{ userName|slice(0, 1)|upper }}</span>
                    <span class="hidden max-w-40 truncate text-sm font-medium text-foreground md:block">{{ userName }}</span>
                    <twig:ux:icon name="lucide:chevron-down" class="hidden size-4 text-muted-foreground md:block" aria-hidden="true"/>
                </summary>
                <div class="absolute right-0 mt-2 w-64 rounded-xl border border-border bg-popover p-1 shadow-xl" role="menu">
                    <div class="border-b border-border px-3 py-2.5">
                        <p class="truncate text-sm font-medium text-popover-foreground">{{ userName }}</p>
                        <p class="mt-0.5 truncate text-xs text-muted-foreground">{{ app.user.userIdentifier }}</p>
                    </div>
                    <a class="mt-1 flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-popover-foreground transition hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                       href="{{ path('member_profile') }}"
                       role="menuitem">
                        <twig:ux:icon name="lucide:user-round" class="size-4 text-muted-foreground" aria-hidden="true"/>
                        Mon profil
                    </a>
                    <form class="mt-1" method="post" action="{{ path('app_logout') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm text-destructive transition hover:bg-destructive/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-destructive/40"
                                type="submit" role="menuitem">
                            <twig:ux:icon name="lucide:log-out" class="size-4" aria-hidden="true"/>
                            Se déconnecter
                        </button>
                    </form>
                </div>
            </details>
        </div>
    </header>

    <main class="min-h-svh pt-16 lg:pl-72">
        <div class="mx-auto min-w-0 max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8 lg:py-10">
            <twig:FlashToast/>
            {% block body %}{% endblock %}
        </div>
    </main>
</div>

{{ encore_entry_script_tags('web') }}
{% block javascripts %}{% endblock %}
</body>
</html>
