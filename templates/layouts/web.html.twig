<!DOCTYPE html>
<html lang="{{ app.request.attributes.get('_locale') }}">
<head>
    <title>{{ reglageValue('app_title').value }} - {% block title %}{% endblock %}</title>
    <twig:SeoComponent/>

    <twig:ScriptComponent/>

    {{ encore_entry_link_tags('web') }}
    {% block stylesheets %}{% endblock %}

</head>
<body class="min-h-svh bg-background text-foreground antialiased" data-controller="global-search" data-global-search-endpoint-value="{{ path('web_search_autocomplete') }}">
{% block web_header %}
    <twig:WebHeader title="{{ block('title')|striptags|trim }}"/>
{% endblock %}

{% include 'web/components/global_search_modal.html.twig' %}

<div id="pageWrapper" class="min-h-svh">
    <twig:FlashToast/>

    <div class="flex min-w-0 flex-1 flex-col">
        {% block body %}{% endblock %}
    </div>

    {% block web_footer %}
        <twig:WebFooter/>
    {% endblock %}
</div>

{{ encore_entry_script_tags('web') }}

{% block javascripts %}{% endblock %}
</body>
</html>
