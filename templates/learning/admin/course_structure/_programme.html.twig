<section class="space-y-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8" id="programme">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h2 class="text-lg font-semibold">Programme</h2>
            <p class="mt-1 text-sm text-muted-foreground">Construisez la structure du cours. Le contenu des leçons sera ajouté dans une étape ultérieure.</p>
        </div>
        {% if is_granted('LEARNING_TRAINING_MANAGE') %}<a class="inline-flex h-9 items-center justify-center gap-2 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary/90" href="{{ path('learning_admin_course_module_new', {trainingId: structure.training.id}) }}"><twig:ux:icon name="lucide:plus" class="size-4"/>Ajouter un module</a>{% endif %}
    </div>
    {% if structure.modules is empty %}
        <div class="rounded-xl border border-dashed border-border bg-muted/20 px-5 py-8 text-center"><p class="text-sm font-medium">Aucun module pour le moment.</p><p class="mt-1 text-sm text-muted-foreground">Commencez par créer le premier module du cours.</p>{% if is_granted('LEARNING_TRAINING_MANAGE') %}<a class="mt-4 inline-flex h-9 items-center justify-center rounded-lg border border-input bg-background px-3 text-sm font-medium hover:bg-muted" href="{{ path('learning_admin_course_module_new', {trainingId: structure.training.id}) }}">Ajouter le premier module</a>{% endif %}</div>
    {% else %}
        <form id="course-module-reorder" method="post" action="{{ path('learning_admin_course_module_reorder', {trainingId: structure.training.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('learning_course_module_reorder_' ~ structure.training.id) }}"></form>
        <div class="space-y-4" data-controller="ordered-list">
            {% for entry in structure.modules %}
                <article class="rounded-xl border border-border bg-muted/20 p-4" draggable="true" data-ordered-list-target="item" data-action="dragstart->ordered-list#start dragover->ordered-list#over drop->ordered-list#drop">
                    <input type="hidden" form="course-module-reorder" name="moduleIds[]" value="{{ entry.module.id }}">
                    <div class="flex items-start gap-3">
                        <span class="mt-1 cursor-grab text-muted-foreground" title="Déplacer le module"><twig:ux:icon name="lucide:grip-vertical" class="size-5"/></span>
                        <div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Module {{ entry.module.position }}</span><h3 class="font-semibold">{{ entry.module.title }}</h3></div>{% if entry.module.description %}<p class="mt-2 text-sm text-muted-foreground">{{ entry.module.description }}</p>{% endif %}</div>
                        <div class="flex shrink-0 items-center gap-1"><button type="button" class="inline-flex size-8 items-center justify-center rounded-md hover:bg-muted" data-action="ordered-list#moveUp" aria-label="Monter le module {{ entry.module.title }}"><twig:ux:icon name="lucide:arrow-up" class="size-4"/></button><button type="button" class="inline-flex size-8 items-center justify-center rounded-md hover:bg-muted" data-action="ordered-list#moveDown" aria-label="Descendre le module {{ entry.module.title }}"><twig:ux:icon name="lucide:arrow-down" class="size-4"/></button><details class="group relative"><summary class="flex size-8 cursor-pointer list-none items-center justify-center rounded-md border border-border hover:bg-muted" aria-label="Actions du module {{ entry.module.title }}"><twig:ux:icon name="lucide:ellipsis" class="size-4"/></summary><div class="absolute right-0 z-20 mt-1 min-w-48 rounded-xl border border-border bg-popover p-1.5 shadow-lg"><a class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-muted" href="{{ path('learning_admin_course_module_edit', {trainingId: structure.training.id, moduleId: entry.module.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a><a class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-muted" href="{{ path('learning_admin_lesson_new', {trainingId: structure.training.id, moduleId: entry.module.id}) }}"><twig:ux:icon name="lucide:plus" class="size-4"/>Ajouter une leçon</a>{% if is_granted('LEARNING_TRAINING_MANAGE') %}<twig:AlertDialog id="delete-module-{{ entry.module.id }}"><twig:AlertDialog:Trigger><button type="button" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm text-destructive hover:bg-destructive/10" data-action="click->alert-dialog#open" data-alert-dialog-target="trigger" aria-haspopup="dialog"><twig:ux:icon name="lucide:trash-2" class="size-4"/>Supprimer</button></twig:AlertDialog:Trigger><twig:AlertDialog:Content><twig:AlertDialog:Header><twig:AlertDialog:Title>Supprimer ce module ?</twig:AlertDialog:Title><twig:AlertDialog:Description>Les leçons de « {{ entry.module.title }} » seront également supprimées.</twig:AlertDialog:Description></twig:AlertDialog:Header><twig:AlertDialog:Footer><twig:AlertDialog:Cancel>Annuler</twig:AlertDialog:Cancel><form method="post" action="{{ path('learning_admin_course_module_delete', {trainingId: structure.training.id, moduleId: entry.module.id}) }}"><input type="hidden" name="_method" value="DELETE"><input type="hidden" name="_token" value="{{ csrf_token('learning_course_module_delete_' ~ structure.training.id ~ '_' ~ entry.module.id) }}"><button type="submit" class="inline-flex h-9 items-center justify-center rounded-lg bg-destructive px-3 text-sm font-medium text-destructive-foreground">Supprimer le module</button></form></twig:AlertDialog:Footer></twig:AlertDialog:Content></twig:AlertDialog>{% endif %}</div></details></div>
                    </div>
                    {% set lessonFormId = 'course-lesson-reorder-' ~ entry.module.id %}
                    {% if entry.lessons is not empty %}
                        <form id="{{ lessonFormId }}" method="post" action="{{ path('learning_admin_lesson_reorder', {trainingId: structure.training.id, moduleId: entry.module.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('learning_lesson_reorder_' ~ structure.training.id ~ '_' ~ entry.module.id) }}">
                        </form>
                    {% endif %}
                    <div class="mt-4 space-y-3 border-l-2 border-border pl-5" data-controller="ordered-list">
                        {% for lesson in entry.lessons %}<div class="flex items-center gap-3 rounded-lg border border-border bg-background px-3 py-2" draggable="true" data-ordered-list-target="item" data-action="dragstart->ordered-list#start dragover->ordered-list#over drop->ordered-list#drop"><input type="hidden" form="{{ lessonFormId }}" name="lessonIds[]" value="{{ lesson.id }}"><span class="cursor-grab text-muted-foreground" title="Déplacer la leçon"><twig:ux:icon name="lucide:grip-vertical" class="size-4"/></span><span class="min-w-0 flex-1 text-sm"><span class="mr-2 text-xs text-muted-foreground">{{ lesson.position }}.</span>{{ lesson.title }}{% if lesson.summary %}<span class="mt-0.5 block truncate text-xs text-muted-foreground">{{ lesson.summary }}</span>{% endif %}</span><div class="flex items-center gap-1"><button type="button" class="inline-flex size-7 items-center justify-center rounded-md hover:bg-muted" data-action="ordered-list#moveUp" aria-label="Monter la leçon {{ lesson.title }}"><twig:ux:icon name="lucide:arrow-up" class="size-3.5"/></button><button type="button" class="inline-flex size-7 items-center justify-center rounded-md hover:bg-muted" data-action="ordered-list#moveDown" aria-label="Descendre la leçon {{ lesson.title }}"><twig:ux:icon name="lucide:arrow-down" class="size-3.5"/></button><details class="group relative"><summary class="flex size-7 cursor-pointer list-none items-center justify-center rounded-md border border-border hover:bg-muted" aria-label="Actions de la leçon {{ lesson.title }}"><twig:ux:icon name="lucide:ellipsis" class="size-3.5"/></summary><div class="absolute right-0 z-20 mt-1 min-w-40 rounded-xl border border-border bg-popover p-1.5 shadow-lg"><a class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-muted" href="{{ path('learning_admin_lesson_edit', {trainingId: structure.training.id, moduleId: entry.module.id, lessonId: lesson.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a><twig:AlertDialog id="delete-lesson-{{ lesson.id }}"><twig:AlertDialog:Trigger><button type="button" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm text-destructive hover:bg-destructive/10" data-action="click->alert-dialog#open" data-alert-dialog-target="trigger" aria-haspopup="dialog"><twig:ux:icon name="lucide:trash-2" class="size-4"/>Supprimer</button></twig:AlertDialog:Trigger><twig:AlertDialog:Content><twig:AlertDialog:Header><twig:AlertDialog:Title>Supprimer cette leçon ?</twig:AlertDialog:Title><twig:AlertDialog:Description>La leçon « {{ lesson.title }} » sera supprimée du programme.</twig:AlertDialog:Description></twig:AlertDialog:Header><twig:AlertDialog:Footer><twig:AlertDialog:Cancel>Annuler</twig:AlertDialog:Cancel><form method="post" action="{{ path('learning_admin_lesson_delete', {trainingId: structure.training.id, moduleId: entry.module.id, lessonId: lesson.id}) }}"><input type="hidden" name="_method" value="DELETE"><input type="hidden" name="_token" value="{{ csrf_token('learning_lesson_delete_' ~ structure.training.id ~ '_' ~ lesson.id) }}"><button type="submit" class="inline-flex h-9 items-center justify-center rounded-lg bg-destructive px-3 text-sm font-medium text-destructive-foreground">Supprimer la leçon</button></form></twig:AlertDialog:Footer></twig:AlertDialog:Content></twig:AlertDialog></div></details></div></div>{% else %}<p class="rounded-lg border border-dashed border-border px-3 py-4 text-sm text-muted-foreground">Aucune leçon dans ce module.</p>{% endfor %}
                        {% if is_granted('LEARNING_TRAINING_MANAGE') %}<div class="flex flex-wrap items-center justify-between gap-3"><a class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline" href="{{ path('learning_admin_lesson_new', {trainingId: structure.training.id, moduleId: entry.module.id}) }}"><twig:ux:icon name="lucide:plus" class="size-4"/>Ajouter une leçon</a>{% if entry.lessons is not empty %}<button form="{{ lessonFormId }}" type="submit" class="inline-flex h-8 items-center justify-center gap-2 rounded-lg border border-input bg-background px-3 text-xs font-medium hover:bg-muted"><twig:ux:icon name="lucide:arrow-down-up" class="size-3.5"/>Enregistrer l’ordre</button>{% endif %}</div>{% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
        {% if is_granted('LEARNING_TRAINING_MANAGE') %}<div class="flex justify-end"><button form="course-module-reorder" type="submit" class="inline-flex h-9 items-center justify-center gap-2 rounded-lg border border-input bg-background px-3 text-sm font-medium hover:bg-muted"><twig:ux:icon name="lucide:arrow-down-up" class="size-4"/>Enregistrer l’ordre des modules</button></div>{% endif %}
        <p class="text-xs text-muted-foreground">Les leçons se réordonnent dans leur module. Le déplacement entre modules sera traité avec la future UX pédagogique.</p>
    {% endif %}
</section>
