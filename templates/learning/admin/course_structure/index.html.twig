{% extends 'layouts/base.html.twig' %}

{% block title %}Programme — {{ structure.training.title }}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
        <div>
            <a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('learning_admin_training_show', {id: structure.training.id}) }}">← Retour à la formation</a>
            <h1 class="mt-3 text-2xl font-semibold tracking-tight">Programme de {{ structure.training.title }}</h1>
            <p class="mt-1 text-sm text-muted-foreground">Gérez les modules et les leçons de cette formation COURSE.</p>
        </div>
        {% include 'learning/admin/course_structure/_programme.html.twig' with {structure: structure} only %}
    </div>
{% endblock %}
