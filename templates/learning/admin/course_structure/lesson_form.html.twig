{% extends 'layouts/base.html.twig' %}
{% block title %}{{ pageTitle }}{% endblock %}
{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="mx-auto max-w-4xl space-y-6">
        <div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('learning_admin_training_show', {id: trainingId}) }}#programme">← Programme</a><h1 class="mt-3 text-2xl font-semibold tracking-[-0.03em]">{{ pageTitle }}</h1><p class="mt-2 text-sm text-muted-foreground">Module : {{ module.title }}</p></div>
        <section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            {{ form_start(form, {attr: {class: 'space-y-6', novalidate: true}}) }}
            <div class="grid gap-5 md:grid-cols-2">
                <div class="space-y-2 md:col-span-2">{{ form_label(form.title, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.title, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}{{ form_errors(form.title) }}</div>
                <div class="space-y-2 md:col-span-2">{{ form_label(form.summary, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.summary, {attr: {class: 'min-h-24 w-full rounded-lg border border-input bg-background px-3 py-2 text-sm resize-none'}}) }}{{ form_errors(form.summary) }}</div>
            </div>
            <div class="space-y-2"><div class="text-sm font-medium">{{ form_label(form.content) }}</div><div {{ react_component('Content/RichTextEditor', {inputId: form.content.vars.id, label: 'Contenu pédagogique', value: form.content.vars.value|default(''), placeholder: 'Rédigez le contenu de cette leçon…', invalid: form.content.vars.errors|length > 0}) }}></div>{{ form_widget(form.content, {attr: {class: 'sr-only', tabindex: '-1', 'aria-hidden': 'true'}}) }}{{ form_errors(form.content) }}<p class="text-xs text-muted-foreground">Les iframes et scripts sont retirés automatiquement.</p></div>
            <div class="space-y-2">{{ form_label(form.videoUrl, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.videoUrl, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}{{ form_errors(form.videoUrl) }}<p class="text-xs text-muted-foreground">Formats acceptés : watch, youtu.be et embed.</p>{% if lesson is defined and lesson.videoEmbedUrl %}<div class="aspect-video max-w-xl overflow-hidden rounded-xl border border-border bg-muted"><iframe class="h-full w-full" src="{{ lesson.videoEmbedUrl }}" title="Aperçu vidéo YouTube" loading="lazy" allowfullscreen></iframe></div>{% endif %}</div>
            <div class="space-y-2 rounded-xl border border-dashed border-border bg-muted/20 p-4">{{ form_label(form.resourceFiles, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.resourceFiles, {attr: {class: 'block w-full cursor-pointer rounded-lg border border-input bg-background text-sm file:mr-4 file:border-0 file:bg-muted file:px-4 file:py-2 file:text-sm'}}) }}{{ form_errors(form.resourceFiles) }}<p class="text-xs text-muted-foreground">PDF, DOCX, XLSX ou PPTX · 20 Mio maximum par fichier. Vous pourrez modifier le titre et l’ordre après l’enregistrement.</p></div>
            <div class="flex justify-end gap-3 border-t border-border pt-5"><a class="inline-flex h-10 items-center rounded-lg px-4 text-sm font-medium text-muted-foreground hover:bg-muted" href="{{ path('learning_admin_training_show', {id: trainingId}) }}#programme">Annuler</a><button type="submit" class="inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground"><twig:ux:icon name="lucide:save" class="size-4"/>Enregistrer</button></div>
            {{ form_end(form) }}
        </section>

        {% if resources is not empty %}
            <section class="rounded-2xl border border-border bg-card p-6 shadow-sm" data-controller="ordered-list">
                <div class="flex items-start justify-between gap-4"><div><h2 class="text-base font-semibold">Ressources de la leçon</h2><p class="mt-1 text-sm text-muted-foreground">Renommez, téléchargez ou réorganisez les ressources.</p></div><span class="rounded-full bg-muted px-2.5 py-1 text-xs text-muted-foreground">{{ resources|length }}</span></div>
                <form id="lesson-resource-reorder" class="hidden" method="post" action="{{ path('learning_admin_lesson_resource_reorder', {trainingId: trainingId, moduleId: module.id, lessonId: lesson.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('learning_lesson_resource_reorder_' ~ trainingId ~ '_' ~ lesson.id) }}"></form>
                <div class="mt-4 space-y-2">
                    {% for resource in resources %}<div class="flex items-center gap-3 rounded-xl border border-border bg-background p-3" draggable="true" data-ordered-list-target="item" data-action="dragstart->ordered-list#start dragover->ordered-list#over drop->ordered-list#drop"><input type="hidden" form="lesson-resource-reorder" name="resourceIds[]" value="{{ resource.id }}"><span class="cursor-grab text-muted-foreground" title="Déplacer la ressource"><twig:ux:icon name="lucide:grip-vertical" class="size-4"/></span><div class="min-w-0 flex-1"><div class="truncate text-sm font-medium">{{ resource.title }}</div><div class="truncate text-xs text-muted-foreground">{{ resource.originalName }} · {{ (resource.size / 1024 / 1024)|number_format(2, ',', ' ') }} Mio</div></div><div class="flex shrink-0 items-center gap-1"><button type="button" class="inline-flex size-8 items-center justify-center rounded-md hover:bg-muted" data-action="ordered-list#moveUp" aria-label="Monter {{ resource.title }}"><twig:ux:icon name="lucide:arrow-up" class="size-4"/></button><button type="button" class="inline-flex size-8 items-center justify-center rounded-md hover:bg-muted" data-action="ordered-list#moveDown" aria-label="Descendre {{ resource.title }}"><twig:ux:icon name="lucide:arrow-down" class="size-4"/></button><a class="inline-flex size-8 items-center justify-center rounded-md hover:bg-muted" href="{{ path('learning_admin_lesson_resource_download', {trainingId: trainingId, moduleId: module.id, lessonId: lesson.id, resourceId: resource.id}) }}" aria-label="Télécharger {{ resource.title }}"><twig:ux:icon name="lucide:download" class="size-4"/></a><details class="group relative"><summary class="flex size-8 cursor-pointer list-none items-center justify-center rounded-md border border-border hover:bg-muted" aria-label="Actions pour {{ resource.title }}"><twig:ux:icon name="lucide:ellipsis" class="size-4"/></summary><div class="absolute right-0 z-20 mt-1 w-64 rounded-xl border border-border bg-popover p-3 shadow-lg"><form method="post" action="{{ path('learning_admin_lesson_resource_rename', {trainingId: trainingId, moduleId: module.id, lessonId: lesson.id, resourceId: resource.id}) }}" class="space-y-2"><input type="hidden" name="_token" value="{{ csrf_token('learning_lesson_resource_rename_' ~ trainingId ~ '_' ~ resource.id) }}"><label class="text-xs font-medium" for="resource-title-{{ resource.id }}">Nom</label><input id="resource-title-{{ resource.id }}" name="title" value="{{ resource.title }}" class="flex h-9 w-full rounded-md border border-input bg-background px-2 text-sm"><button class="inline-flex h-8 w-full items-center justify-center rounded-md bg-primary px-2 text-xs font-medium text-primary-foreground" type="submit">Enregistrer le nom</button></form><form method="post" action="{{ path('learning_admin_lesson_resource_delete', {trainingId: trainingId, moduleId: module.id, lessonId: lesson.id, resourceId: resource.id}) }}" class="mt-3 border-t border-border pt-3"><input type="hidden" name="_method" value="DELETE"><input type="hidden" name="_token" value="{{ csrf_token('learning_lesson_resource_delete_' ~ trainingId ~ '_' ~ resource.id) }}"><button class="inline-flex h-8 w-full items-center justify-center rounded-md text-xs font-medium text-destructive hover:bg-destructive/10" type="submit">Retirer la ressource</button></form></div></details></div></div>{% endfor %}
                    <div class="flex justify-end pt-2"><button form="lesson-resource-reorder" type="submit" class="inline-flex h-9 items-center gap-2 rounded-lg border border-input bg-background px-3 text-sm font-medium hover:bg-muted"><twig:ux:icon name="lucide:arrow-down-up" class="size-4"/>Enregistrer l’ordre</button></div>
                </div>
            </section>
        {% endif %}
    </div>
</main>
{% endblock %}
