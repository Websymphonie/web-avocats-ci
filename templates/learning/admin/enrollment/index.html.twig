{% extends 'layouts/base.html.twig' %}

{% block title %}Inscriptions — {{ training.title }}{% endblock %}

{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-6xl space-y-6">
  <div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('learning_admin_training_show', {id: training.id}) }}">← {{ training.title }}</a><h1 class="mt-2 text-2xl font-semibold">Inscriptions</h1><p class="mt-1 text-sm text-muted-foreground">L’accès au contenu exige une formation publiée et une inscription active.</p></div>
  {% if is_granted('LEARNING_ENROLLMENT_MANAGE') %}<section class="rounded-2xl border border-border bg-card p-5 shadow-sm"><h2 class="font-semibold">Accorder un accès</h2><form method="post" action="{{ path('learning_admin_enrollment_grant', {trainingId: training.id}) }}" class="mt-4 flex flex-wrap items-end gap-3"><input type="hidden" name="_token" value="{{ csrf_token('learning_enrollment_grant_' ~ training.id) }}"><label class="min-w-72 flex-1 text-sm font-medium">Utilisateur<select name="userId" required class="mt-1 block h-10 w-full rounded-lg border border-input bg-background px-3"><option value="">Sélectionner…</option>{% for user in users %}<option value="{{ user.id }}">{{ user.name }} · {{ user.email }}</option>{% endfor %}</select></label><button class="inline-flex h-10 items-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Accorder</button></form></section>{% endif %}
  <form method="get" class="flex flex-wrap items-end gap-3 rounded-2xl border border-border bg-card p-5"><label class="min-w-56 flex-1 text-sm font-medium">Rechercher<input name="search" value="{{ app.request.query.get('search', '') }}" class="mt-1 block h-10 w-full rounded-lg border border-input bg-background px-3" placeholder="Nom ou email"></label><label class="text-sm font-medium">Statut<select name="status" class="mt-1 block h-10 rounded-lg border border-input bg-background px-3"><option value="">Tous</option>{% for option in statusOptions %}<option value="{{ option.value }}" {{ app.request.query.get('status') == option.value ? 'selected' }}>{{ option.label }}</option>{% endfor %}</select></label><button class="h-10 rounded-lg border border-input px-4 text-sm font-medium" type="submit">Filtrer</button></form>
  <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-muted/60 text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-5 py-3">Utilisateur</th><th class="px-5 py-3">Source</th><th class="px-5 py-3">Statut</th><th class="px-5 py-3">Date d’accès</th><th class="px-5 py-3 text-right">Action</th></tr></thead><tbody class="divide-y divide-border">{% for item in view.items %}<tr><td class="px-5 py-4"><div class="font-medium">{{ item.user ? item.user.name : 'Utilisateur supprimé' }}</div><div class="text-muted-foreground">{{ item.user ? item.user.email : 'ID #' ~ item.enrollment.userId }}</div></td><td class="px-5 py-4">{{ item.enrollment.source.label }}</td><td class="px-5 py-4">{{ item.enrollment.status.label }}</td><td class="px-5 py-4">{{ item.enrollment.activatedAt ? item.enrollment.activatedAt|date('d/m/Y H:i') : '—' }}</td><td class="px-5 py-4 text-right">
  {% if is_granted('LEARNING_ENROLLMENT_MANAGE') and item.enrollment.isActive %}<twig:AlertDialog id="revoke-enrollment-{{ item.enrollment.id }}"><twig:AlertDialog:Trigger><button class="rounded-lg border border-destructive/40 px-3 py-2 text-destructive" type="button" data-action="click->alert-dialog#open" data-alert-dialog-target="trigger" aria-haspopup="dialog">Révoquer</button></twig:AlertDialog:Trigger><twig:AlertDialog:Content><twig:AlertDialog:Header><twig:AlertDialog:Title>Révoquer cet accès ?</twig:AlertDialog:Title><twig:AlertDialog:Description>L’utilisateur ne pourra plus consulter le contenu de cette formation.</twig:AlertDialog:Description></twig:AlertDialog:Header><twig:AlertDialog:Footer><twig:AlertDialog:Cancel>Annuler</twig:AlertDialog:Cancel><form method="post" action="{{ path('learning_admin_enrollment_revoke', {trainingId: training.id, enrollmentId: item.enrollment.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('learning_enrollment_revoke_' ~ item.enrollment.id) }}"><button class="inline-flex h-9 items-center rounded-lg bg-destructive px-3 text-sm font-medium text-destructive-foreground" type="submit">Révoquer l’accès</button></form></twig:AlertDialog:Footer></twig:AlertDialog:Content></twig:AlertDialog>{% elseif is_granted('LEARNING_ENROLLMENT_MANAGE') %}<form method="post" action="{{ path('learning_admin_enrollment_grant', {trainingId: training.id}) }}" class="inline"><input type="hidden" name="_token" value="{{ csrf_token('learning_enrollment_grant_' ~ training.id) }}"><input type="hidden" name="userId" value="{{ item.enrollment.userId }}"><button class="rounded-lg border border-input px-3 py-2" type="submit">Réactiver</button></form>{% endif %}
  </td></tr>{% else %}<tr><td colspan="5" class="px-5 py-10 text-center text-muted-foreground">Aucune inscription.</td></tr>{% endfor %}</tbody></table></section>
</div></main>
{% endblock %}
