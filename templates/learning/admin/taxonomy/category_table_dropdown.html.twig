<twig:ActionDropdown>{% if is_granted('LEARNING_CATEGORY_MANAGE') %}<a href="{{ path('learning_admin_category_edit', {id: category.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}{% if is_granted('LEARNING_CATEGORY_DELETE') %}{{ component('DeleteFormComponent', {id: category.id, instanceId: instanceId, urlPath: path('learning_admin_category_delete', {id: category.id}), csrfTokenId: 'delete', buttonLabel: 'Supprimer', description: 'La catégorie « ' ~ category.name ~ ' » sera supprimée si elle n’est utilisée par aucune formation.'}) }}{% endif %}</twig:ActionDropdown>
