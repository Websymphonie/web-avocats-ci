{% extends 'layouts/base.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-2xl space-y-6"><div><a class="text-sm text-muted-foreground" href="{{ path(backRoute) }}">← Retour</a><h1 class="mt-3 text-2xl font-semibold">{{ title }}</h1></div><section class="rounded-2xl border border-border bg-card p-6 shadow-sm">{{ form_start(form, {attr: {class: 'space-y-5', novalidate: true}}) }}<div class="space-y-2">{{ form_label(form.name, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.name, {attr: {class: 'h-11 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}{{ form_errors(form.name) }}<p class="text-xs text-muted-foreground">Le slug est généré automatiquement et reste propre à Learning.</p></div><div class="flex justify-end gap-3 border-t border-border pt-5"><a class="rounded-lg px-4 py-2 text-sm text-muted-foreground" href="{{ path(backRoute) }}">Annuler</a><button class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" type="submit">Enregistrer</button></div>{{ form_end(form) }}</section></div></main>{% endblock %}
