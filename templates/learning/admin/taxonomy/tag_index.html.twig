{% extends 'layouts/base.html.twig' %}
{% block title %}Tags de formations{% endblock %}
{% block body %}<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-7xl space-y-6"><section class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between"><div><p class="text-sm font-medium text-muted-foreground">Formations</p><h1 class="mt-1 text-2xl font-semibold">Tags de formations</h1><p class="mt-2 text-sm text-muted-foreground">Mots-clés éditoriaux propres à Learning.</p></div>{% if is_granted('LEARNING_TAG_MANAGE') %}<a class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" href="{{ path('learning_admin_tag_new') }}">+ Nouveau tag</a>{% endif %}</section><details class="rounded-2xl border border-border bg-card p-5" {% if app.request.query.all|length > 0 %}open{% endif %}><summary class="cursor-pointer text-sm font-medium">Filtrer les tags</summary><div class="mt-4">{{ form_start(filterForm, {attr: {class: 'flex gap-3'}}) }}{{ form_widget(filterForm.search, {attr: {class: 'h-10 flex-1 rounded-lg border border-input bg-background px-3 text-sm'}}) }}<button class="rounded-lg bg-primary px-4 text-sm text-primary-foreground" type="submit">Appliquer</button>{{ form_end(filterForm) }}</div></details><form id="training-tag-bulk-delete" method="post" action="{{ path('learning_admin_tag_bulk_delete') }}"><input type="hidden" name="_token" value="{{ csrf_token('training-tag-bulk-delete') }}"></form><twig:BulkSelection id="training-tag-selection" inputName="ids[]" inputForm="training-tag-bulk-delete" selectionLabelSingular="tag" selectionLabelPlural="tags" confirmationTemplate="Supprimer {count} tag(s) ?" confirmationDescriptionTemplate="Les tags utilisés seront conservés.">{% block actions %}{% if is_granted('LEARNING_TAG_DELETE') %}<twig:AlertDialog id="bulk-training-tag-delete"><twig:AlertDialog:Trigger><twig:Button type="button" variant="destructive" size="sm" data-bulk-selection-target="action" data-action="click->alert-dialog#open" data-alert-dialog-target="trigger">Supprimer</twig:Button></twig:AlertDialog:Trigger><twig:AlertDialog:Content><twig:AlertDialog:Header><twig:AlertDialog:Title>Supprimer les tags sélectionnés ?</twig:AlertDialog:Title><twig:AlertDialog:Description>Les tags utilisés ne seront pas supprimés.</twig:AlertDialog:Description></twig:AlertDialog:Header><twig:AlertDialog:Footer><twig:AlertDialog:Cancel>Annuler</twig:AlertDialog:Cancel><twig:Button type="submit" form="training-tag-bulk-delete" variant="destructive">Supprimer</twig:Button></twig:AlertDialog:Footer></twig:AlertDialog:Content></twig:AlertDialog>{% endif %}{% endblock %}{% block content %}<section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm"><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-muted/50 text-xs uppercase text-muted-foreground"><tr><th class="px-5 py-3"></th><th class="px-5 py-3">Nom</th><th class="px-5 py-3">Slug</th><th class="px-5 py-3 text-right">Actions</th></tr></thead><tbody class="divide-y divide-border">{% for tag in tags.items %}<tr><td class="px-5 py-4"><input type="checkbox" value="{{ tag.id }}" data-bulk-selection-target="row" aria-label="Sélectionner {{ tag.name }}"></td><td class="px-5 py-4 font-medium">{{ tag.name }}</td><td class="px-5 py-4 text-muted-foreground">{{ tag.slug }}</td><td class="px-5 py-4 text-right">{{ component('TrainingTagTableDropdown', {tag: tag, instanceId: 'tag-' ~ tag.id}) }}</td></tr>{% else %}<tr><td colspan="4" class="px-5 py-10 text-center text-muted-foreground">Aucun tag.</td></tr>{% endfor %}</tbody></table></div>{% include 'shared/views/_list_pagination.html.twig' with {pager: tags, route: 'learning_admin_tag_list'} only %}</section>{% endblock %}</twig:BulkSelection></div></main>{% endblock %}
