<twig:ActionDropdown>
    {% if is_granted('LEARNING_TRAINING_VIEW') %}<a href="{{ path('learning_admin_training_show', {id: training.id}) }}"><twig:ux:icon name="lucide:eye" class="size-4"/>Voir</a>{% endif %}
    {% if is_granted('LEARNING_TRAINING_MANAGE') %}<a href="{{ path('learning_admin_training_edit', {id: training.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}
    {% if training.status.value == 'DRAFT' and is_granted('LEARNING_TRAINING_PUBLISH') %}<form method="post" action="{{ path('learning_admin_training_publish', {id: training.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('training_publish_' ~ training.id) }}"><button type="submit"><twig:ux:icon name="lucide:send" class="size-4"/>Publier</button></form>{% elseif training.status.value == 'PUBLISHED' and is_granted('LEARNING_TRAINING_PUBLISH') %}<form method="post" action="{{ path('learning_admin_training_archive', {id: training.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('training_archive_' ~ training.id) }}"><button type="submit"><twig:ux:icon name="lucide:archive" class="size-4"/>Archiver</button></form>{% endif %}
    {% if is_granted('LEARNING_TRAINING_DELETE') %}{{ component('DeleteFormComponent', {id: training.id, instanceId: instanceId, urlPath: path('learning_admin_training_delete', {id: training.id}), csrfTokenId: 'delete', buttonLabel: 'Supprimer', description: 'La formation « ' ~ training.title ~ ' » sera définitivement supprimée.'}) }}{% endif %}
</twig:ActionDropdown>
