{% extends 'layouts/base.html.twig' %}

{% block title %}{{ trainingType.value == 'LIVE' ? 'Nouveau Live' : 'Nouvelle formation' }}{% endblock %}

{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="mx-auto max-w-4xl space-y-6">
        <div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('learning_admin_training_list') }}">← Formations</a><h1 class="mt-3 text-2xl font-semibold tracking-[-0.03em]">{{ trainingType.value == 'LIVE' ? 'Nouveau Live' : 'Nouvelle formation' }}</h1><p class="mt-2 text-sm text-muted-foreground">{{ trainingType.value == 'LIVE' ? 'Créez une session Live en brouillon.' : 'Créez un cours en brouillon. Les modules et leçons seront ajoutés dans une étape ultérieure.' }}</p></div>
        <section class="rounded-2xl border border-border bg-card p-6 shadow-sm">{% include 'learning/admin/training/_form.html.twig' with {coverUrl: null} %}</section>
    </div>
</main>
{% endblock %}
