{% extends 'layouts/base.html.twig' %}

{% block title %}Modifier {{ training.title }}{% endblock %}

{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="mx-auto max-w-4xl space-y-6">
        <div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('learning_admin_training_list') }}">← Formations</a><h1 class="mt-3 text-2xl font-semibold tracking-[-0.03em]">Modifier la formation</h1><p class="mt-2 text-sm text-muted-foreground">{{ training.title }} · {{ training.status.label }}</p></div>
        <section class="rounded-2xl border border-border bg-card p-6 shadow-sm">{% include 'learning/admin/training/_form.html.twig' %}</section>
        {% if structure %}{% include 'learning/admin/course_structure/_programme.html.twig' with {structure: structure} only %}{% endif %}
    </div>
</main>
{% endblock %}
