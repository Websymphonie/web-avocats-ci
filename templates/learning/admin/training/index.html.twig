{% extends 'layouts/base.html.twig' %}

{% block title %}Formations{% endblock %}

{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="mx-auto max-w-7xl space-y-6">
        <section class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-medium text-muted-foreground">Formations</p>
                <h1 class="mt-1 text-2xl font-semibold tracking-[-0.03em]">{{ isLiveListing ? 'Lives' : 'Formations' }}</h1>
                <p class="mt-2 text-sm text-muted-foreground">{{ isLiveListing ? 'Gérez les sessions Live et leurs accès inscrits.' : 'Gérez les formations et leurs parcours pédagogiques.' }}</p>
            </div>
            {% if is_granted('LEARNING_TRAINING_MANAGE') %}
                <details class="group relative"><summary class="inline-flex h-10 cursor-pointer list-none items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs hover:bg-primary/90"><twig:ux:icon name="lucide:plus" class="size-4"/>Nouvelle formation <twig:ux:icon name="lucide:chevron-down" class="size-4"/></summary><div class="absolute right-0 z-20 mt-2 min-w-48 rounded-xl border border-border bg-popover p-1.5 text-popover-foreground shadow-lg"><a class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-muted" href="{{ path('learning_admin_training_new') }}"><twig:ux:icon name="lucide:book-open" class="size-4"/>Cours</a><a class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-muted" href="{{ path('learning_admin_training_new_live') }}"><twig:ux:icon name="lucide:video" class="size-4"/>Live</a></div></details>
            {% endif %}
        </section>

        <details class="group rounded-2xl border border-border bg-card shadow-sm" {% if app.request.query.all|length > 0 %}open{% endif %}>
            <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-sm font-medium">
                <span class="flex items-center gap-2"><twig:ux:icon name="lucide:list-filter" class="size-4 text-muted-foreground"/>Filtrer les formations</span>
                <twig:ux:icon name="lucide:chevron-down" class="size-4 text-muted-foreground transition-transform group-open:rotate-180"/>
            </summary>
            <div class="border-t border-border px-6 py-5">
                {{ form_start(filterForm, {attr: {class: 'grid gap-4 md:grid-cols-[minmax(0,1fr)_repeat(6,minmax(0,160px))_auto]', novalidate: true}}) }}
                {% for field in [filterForm.search, filterForm.status, filterForm.visibility, filterForm.accessType, filterForm.type, filterForm.categoryId, filterForm.tagId] %}
                    <div class="space-y-2">{{ form_label(field, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(field, {attr: {class: 'flex h-10 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}</div>
                {% endfor %}
                <div class="flex items-end gap-2">
                    <button class="inline-flex h-10 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Appliquer</button>
                    <a class="inline-flex h-10 items-center justify-center rounded-lg px-3 text-sm font-medium text-muted-foreground" href="{{ path('learning_admin_training_list') }}">Réinitialiser</a>
                </div>
                {{ form_end(filterForm) }}
            </div>
        </details>

        <form id="training-bulk-delete" method="post" action="{{ path('learning_admin_training_bulk_delete') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('training-bulk-delete') }}">
        </form>
        <twig:BulkSelection id="training-selection" inputName="ids[]" inputForm="training-bulk-delete" selectionLabelSingular="formation" selectionLabelPlural="formations" confirmationTemplate="Supprimer {count} formation(s) ?" confirmationDescriptionTemplate="{count} formation(s) seront définitivement supprimée(s).">
            {% block actions %}
                {% if is_granted('LEARNING_TRAINING_DELETE') %}{{ component('BulkDeleteTrainings', {formId: 'training-bulk-delete'}) }}{% endif %}
            {% endblock %}
            {% block content %}
                <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
                    <div class="flex items-center justify-between border-b border-border px-5 py-4 sm:px-6">
                        <div class="flex items-start gap-3">
                            <label class="mt-0.5 inline-flex size-9 items-center justify-center rounded-lg hover:bg-muted"><input type="checkbox" class="size-4 rounded border-input accent-primary" data-bulk-selection-target="master" aria-label="Sélectionner toutes les formations de la page"></label>
                            <div><h2 class="text-sm font-semibold">Catalogue des formations</h2><p class="mt-1 text-sm text-muted-foreground">{{ trainings.totalItemCount }} formation{{ trainings.totalItemCount > 1 ? 's' : '' }}</p></div>
                        </div>
                    </div>
                    <div class="divide-y divide-border md:hidden">
                        {% for item in trainings.items %}
                            <article class="space-y-4 p-5">
                                <div class="flex items-start gap-3">
                                    <label class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg hover:bg-muted"><input type="checkbox" value="{{ item.id }}" class="size-4 rounded border-input accent-primary" data-bulk-selection-target="row" aria-label="Sélectionner la formation : {{ item.title }}"></label>
                                    {% if item.coverMediaId and mediaUrls[item.coverMediaId]|default(null) %}<img src="{{ mediaUrls[item.coverMediaId] }}" alt="" class="size-12 shrink-0 rounded-lg object-cover">{% else %}<span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-muted text-muted-foreground"><twig:ux:icon name="lucide:graduation-cap" class="size-5"/></span>{% endif %}
                                    <div class="min-w-0 flex-1"><h3 class="font-medium">{{ item.title }}</h3><p class="mt-1 text-sm text-muted-foreground">{{ item.type.label }} · {{ item.visibility.label }}</p></div>
                                </div>
                                <div class="flex flex-wrap items-center gap-2 text-sm"><twig:Badge variant="outline">{{ item.accessType.label }}</twig:Badge><twig:Badge variant="{{ item.status.value == 'PUBLISHED' ? 'success' : (item.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ item.status.label }}</twig:Badge></div>
                                <div class="flex justify-end">{{ component('TrainingTableDropdown', {training: item, instanceId: 'mobile-' ~ item.id}) }}</div>
                            </article>
                        {% else %}<div class="px-6 py-14 text-center text-muted-foreground">Aucune formation ne correspond à vos critères.</div>{% endfor %}
                    </div>
                    <div class="hidden overflow-x-auto md:block">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-muted/50 text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-5 py-3 font-medium"><span class="sr-only">Sélection</span></th><th class="px-5 py-3 font-medium">Image</th><th class="px-5 py-3 font-medium">Titre</th><th class="px-5 py-3 font-medium">Type</th><th class="px-5 py-3 font-medium">Visibilité</th><th class="px-5 py-3 font-medium">Accès</th><th class="px-5 py-3 font-medium">Statut</th><th class="px-5 py-3 text-right font-medium">Actions</th></tr></thead>
                            <tbody class="divide-y divide-border">
                            {% for item in trainings.items %}
                                <tr class="transition-colors hover:bg-muted/40">
                                    <td class="px-5 py-4"><label class="inline-flex size-9 items-center justify-center rounded-lg hover:bg-muted"><input type="checkbox" value="{{ item.id }}" class="size-4 rounded border-input accent-primary" data-bulk-selection-target="row" aria-label="Sélectionner la formation : {{ item.title }}"></label></td>
                                    <td class="px-5 py-4">{% if item.coverMediaId and mediaUrls[item.coverMediaId]|default(null) %}<img src="{{ mediaUrls[item.coverMediaId] }}" alt="" class="size-12 rounded-lg object-cover">{% else %}<span class="flex size-12 items-center justify-center rounded-lg bg-muted text-muted-foreground"><twig:ux:icon name="lucide:graduation-cap" class="size-5"/></span>{% endif %}</td>
                                    <td class="px-5 py-4"><p class="truncate font-medium">{{ item.title }}</p><p class="mt-1 truncate text-xs text-muted-foreground">/{{ item.slug }}</p></td>
                                    <td class="px-5 py-4"><div>{{ item.type.label }}</div>{% if item.liveDetails %}<div class="mt-1 text-xs text-muted-foreground">{{ item.liveDetails.startsAt|date('d/m/Y H:i') }}</div>{% endif %}</td>
                                    <td class="px-5 py-4">{{ item.visibility.label }}</td>
                                    <td class="px-5 py-4"><twig:Badge variant="outline">{{ item.accessType.label }}</twig:Badge></td>
                                    <td class="px-5 py-4"><twig:Badge variant="{{ item.status.value == 'PUBLISHED' ? 'success' : (item.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ item.status.label }}</twig:Badge></td>
                                    <td class="px-5 py-4"><div class="flex justify-end">{{ component('TrainingTableDropdown', {training: item, instanceId: 'desktop-' ~ item.id}) }}</div></td>
                                </tr>
                            {% else %}<tr><td class="px-6 py-14 text-center text-muted-foreground" colspan="8">Aucune formation ne correspond à vos critères.</td></tr>{% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% include 'shared/views/_list_pagination.html.twig' with {pager: trainings, route: 'learning_admin_training_list'} only %}
                </section>
            {% endblock %}
        </twig:BulkSelection>
    </div>
</main>
{% endblock %}
