{% extends 'layouts/base.html.twig' %}

{% block title %}{{ training.title }}{% endblock %}

{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="mx-auto max-w-4xl space-y-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('learning_admin_training_list') }}">← Formations</a><div class="mt-3 flex flex-wrap items-center gap-3"><h1 class="text-2xl font-semibold tracking-[-0.03em]">{{ training.title }}</h1><twig:Badge variant="{{ training.status.value == 'PUBLISHED' ? 'success' : (training.status.value == 'ARCHIVED' ? 'warning' : 'secondary') }}">{{ training.status.label }}</twig:Badge></div><p class="mt-2 text-sm text-muted-foreground">{{ training.type.label }} · {{ training.visibility.label }} · {{ training.accessType.label }} · /{{ training.slug }}</p></div>
            <div class="flex flex-wrap gap-2">{% if is_granted('LEARNING_ENROLLMENT_VIEW') %}<a class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('learning_admin_enrollment_list', {trainingId: training.id}) }}"><twig:ux:icon name="lucide:users" class="size-4"/>Inscriptions ({{ activeEnrollmentCount }})</a>{% endif %}{% if is_granted('LEARNING_TRAINING_MANAGE') %}<a class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-input bg-background px-4 text-sm font-medium hover:bg-muted" href="{{ path('learning_admin_training_edit', {id: training.id}) }}"><twig:ux:icon name="lucide:pencil" class="size-4"/>Modifier</a>{% endif %}</div>
        </div>
        <article class="space-y-6 rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
            {% if coverUrl %}<img src="{{ coverUrl }}" alt="Couverture de {{ training.title }}" class="max-h-72 w-full rounded-xl object-cover">{% endif %}
            <p class="text-lg leading-8 text-muted-foreground">{{ training.summary }}</p>
            <div class="rich-content text-sm">{{ safeDescription|raw }}</div>
            <dl class="grid gap-4 border-t border-border pt-5 sm:grid-cols-2 lg:grid-cols-4"><div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Visibilité</dt><dd class="mt-1">{{ training.visibility.label }}</dd></div><div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Accès</dt><dd class="mt-1">{{ training.accessType.label }}</dd></div><div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Publication</dt><dd class="mt-1">{{ training.publishedAt ? training.publishedAt|date('d/m/Y H:i') : '—' }}</dd></div>{% if training.liveDetails %}<div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Début</dt><dd class="mt-1">{{ training.liveDetails.startsAt|date('d/m/Y H:i') }}</dd></div><div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Fin</dt><dd class="mt-1">{{ training.liveDetails.endsAt|date('d/m/Y H:i') }}</dd></div><div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Mode</dt><dd class="mt-1">{{ training.liveDetails.deliveryMode.label }}</dd></div>{% if training.liveDetails.location %}<div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Lieu</dt><dd class="mt-1">{{ training.liveDetails.location }}</dd></div>{% endif %}{% if training.liveDetails.joinUrl %}<div><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Connexion</dt><dd class="mt-1"><a class="text-primary hover:underline" href="{{ training.liveDetails.joinUrl }}" target="_blank" rel="noopener noreferrer">Ouvrir le lien</a></dd></div>{% endif %}{% endif %}</dl>
            <div class="grid gap-4 border-t border-border pt-5 sm:grid-cols-2"><div><h2 class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Catégories</h2><p class="mt-2 text-sm">{{ categoryNames is not empty ? categoryNames|join(', ') : 'Aucune catégorie' }}</p></div><div><h2 class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Tags</h2><p class="mt-2 text-sm">{{ tagNames is not empty ? tagNames|join(', ') : 'Aucun tag' }}</p></div></div>
        </article>
        {% if structure %}{% include 'learning/admin/course_structure/_programme.html.twig' with {structure: structure} only %}{% else %}<section class="rounded-2xl border border-border bg-card p-6 shadow-sm"><h2 class="text-base font-semibold">Session Live</h2><p class="mt-1 text-sm text-muted-foreground">Cette formation synchrone utilise les inscriptions Learning et ses détails de session ci-dessus.</p></section>{% endif %}
    </div>
</main>
{% endblock %}
