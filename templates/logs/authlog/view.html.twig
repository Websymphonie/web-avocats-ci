{% extends 'layouts/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-4xl space-y-6">
        {{ component('Breadcrumbs', {'breadcrumbs': breadcrumbs}) }}
        <article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8"><div class="flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-start sm:justify-between"><div><p class="text-sm font-medium text-muted-foreground">Tentative #{{ authLog.id }}</p><h1 class="mt-2 text-2xl font-semibold tracking-[-0.03em]">{{ authLog.emailEntered }}</h1><p class="mt-2 text-sm text-muted-foreground">Depuis {{ authLog.userIP ?? 'une adresse inconnue' }}</p></div><span class="inline-flex w-fit rounded-full px-3 py-1 text-sm font-medium {{ authLog.isSuccessFulAuth ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300' : 'bg-destructive/10 text-destructive' }}">{{ authLog.isSuccessFulAuth ? 'Connexion réussie' : 'Connexion échouée' }}</span></div>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2"><div class="rounded-xl bg-muted/50 p-4"><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Tentative</dt><dd class="mt-2 text-sm font-medium">{{ authLog.authAttemptAt ? authLog.authAttemptAt|date('d/m/Y à H:i:s') : '—' }}</dd></div><div class="rounded-xl bg-muted/50 p-4"><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Session mémorisée</dt><dd class="mt-2 text-sm font-medium">{{ authLog.isRememberMeAuth ? 'Oui' : 'Non' }}</dd></div><div class="rounded-xl bg-muted/50 p-4"><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Déconnexion</dt><dd class="mt-2 text-sm font-medium">{{ authLog.deauthenticatedAt ? authLog.deauthenticatedAt|date('d/m/Y à H:i:s') : 'Non enregistrée' }}</dd></div><div class="rounded-xl bg-muted/50 p-4"><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Blocage</dt><dd class="mt-2 text-sm font-medium">{% if authLog.startOfBlackListing %}Du {{ authLog.startOfBlackListing|date('d/m/Y H:i') }}{% if authLog.endOfBlackListing %} au {{ authLog.endOfBlackListing|date('d/m/Y H:i') }}{% endif %}{% else %}Aucun{% endif %}</dd></div></dl>
        <div class="mt-7 flex gap-2 border-t border-border pt-6"><a class="inline-flex h-10 items-center rounded-lg border border-border px-4 text-sm font-medium hover:bg-muted" href="{{ path('app_auth_log_index') }}">Retour à l’historique</a>{% if is_granted('ROLE_DELETE') %}{{ component('DeleteFormComponent', {id: authLog.id, urlPath: path('app_auth_log_delete', {id: authLog.id}), description: 'Cette trace d’authentification sera définitivement supprimée.'}) }}{% endif %}</div></article>
    </div></main>
{% endblock %}
