{% extends 'layouts/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-5xl space-y-6">
        {{ component('Breadcrumbs', {'breadcrumbs': breadcrumbs}) }}
        <article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
            <div class="flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-start sm:justify-between"><div><p class="text-sm font-medium text-muted-foreground">Événement #{{ log.id }}</p><h1 class="mt-2 text-2xl font-semibold tracking-[-0.03em]">{{ log.message }}</h1><p class="mt-2 text-sm text-muted-foreground">{{ log.createdAt ? log.createdAt|date('d/m/Y à H:i:s') : 'Date inconnue' }}</p></div>{{ log_level_badge(log.level ?? 0, log.levelName ?? 'Inconnu') }}</div>
            <dl class="mt-6 grid gap-4 sm:grid-cols-3"><div class="rounded-xl bg-muted/50 p-4"><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Utilisateur</dt><dd class="mt-2 text-sm font-medium">{{ log.user ? log.user.email : 'Système' }}</dd></div><div class="rounded-xl bg-muted/50 p-4"><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Niveau numérique</dt><dd class="mt-2 text-sm font-medium">{{ log.level ?? '—' }}</dd></div><div class="rounded-xl bg-muted/50 p-4"><dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Identifiant</dt><dd class="mt-2 truncate font-mono text-xs">{{ log.uuid }}</dd></div></dl>
            <div class="mt-6 grid gap-6 lg:grid-cols-2"><section><h2 class="text-sm font-semibold">Contexte</h2><pre class="mt-3 max-h-96 overflow-auto rounded-xl border border-border bg-zinc-950 p-4 text-xs leading-6 text-zinc-100">{{ log.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></section><section><h2 class="text-sm font-semibold">Données supplémentaires</h2><pre class="mt-3 max-h-96 overflow-auto rounded-xl border border-border bg-zinc-950 p-4 text-xs leading-6 text-zinc-100">{{ log.extra|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></section></div>
            <div class="mt-7 flex flex-wrap gap-2 border-t border-border pt-6"><a class="inline-flex h-10 items-center rounded-lg border border-border px-4 text-sm font-medium hover:bg-muted" href="{{ path('app_log_index') }}">Retour aux logs</a>{% if is_granted('ROLE_DELETE') %}{{ component('DeleteFormComponent', {id: log.id, urlPath: path('app_log_delete', {id: log.id}), description: 'Cet événement technique sera définitivement supprimé.'}) }}{% endif %}</div>
        </article>
    </div></main>
{% endblock %}
