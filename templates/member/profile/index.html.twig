{% extends 'layouts/member.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block member_page_title %}{{ title }}{% endblock %}

{% block body %}
    <div class="space-y-8">
        <section class="flex flex-col justify-between gap-5 border-b border-border pb-7 sm:flex-row sm:items-end">
            <div>
                <p class="mb-2 flex items-center gap-2 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-[#a77d2e] dark:text-[#e0bf7d]">
                    <span class="h-px w-7 bg-[#c49b52] dark:bg-[#d8b878]"></span>
                    Mon espace
                </p>
                <h1 class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">Mon profil</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground sm:text-base">Gérez les informations utilisées pour votre espace avocat.</p>
            </div>
            <a href="{{ path('app_member') }}" class="inline-flex min-h-10 w-fit items-center gap-2 rounded-xl border border-border px-4 text-sm font-medium text-card-foreground transition hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                <twig:ux:icon name="lucide:arrow-left" class="size-4" aria-hidden="true"/>
                Retour au tableau de bord
            </a>
        </section>

        <section class="grid gap-5 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)]">
            <article class="rounded-2xl border border-border bg-[#10233f] p-6 text-white shadow-sm dark:bg-[#142b4b] sm:p-7">
                <span class="flex size-14 items-center justify-center rounded-2xl bg-[#d8b878] text-xl font-semibold text-[#10233f]">{{ command.email|slice(0, 1)|upper }}</span>
                <p class="mt-7 text-xs font-semibold uppercase tracking-[0.18em] text-[#f1d59b]">Compte professionnel</p>
                <h2 class="mt-2 text-xl font-semibold">{{ command.name }}</h2>
                <p class="mt-1 break-all text-sm text-white/60">{{ command.email }}</p>
                <div class="mt-8 flex items-center gap-2 text-xs text-emerald-200">
                    <span class="size-2 rounded-full bg-emerald-400"></span>
                    Accès membre actif
                </div>
            </article>

            <article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
                <div class="flex items-start gap-3 border-b border-border pb-5">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                        <twig:ux:icon name="lucide:user-round-pen" class="size-5" aria-hidden="true"/>
                    </span>
                    <div>
                        <h2 class="text-lg font-semibold text-card-foreground">Informations personnelles</h2>
                        <p class="mt-1 text-sm text-muted-foreground">Ces informations servent à personnaliser votre espace.</p>
                    </div>
                </div>

                {{ form_start(form, {'attr': {'class': 'mt-7 space-y-6', 'data-loading-label': 'Enregistrement…'}}) }}
                    <div class="space-y-2">
                        {{ form_label(form.name, null, {'label_attr': {'class': 'text-sm font-medium'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30', 'autocomplete': 'name'}}) }}
                        <div class="text-sm text-destructive">{{ form_errors(form.name) }}</div>
                    </div>
                    <div class="space-y-2">
                        {{ form_label(form.email, null, {'label_attr': {'class': 'text-sm font-medium'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30', 'autocomplete': 'email'}}) }}
                        <div class="text-sm text-destructive">{{ form_errors(form.email) }}</div>
                    </div>
                    <div class="flex justify-end border-t border-border pt-6">
                        <button class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-primary px-5 text-sm font-medium text-primary-foreground shadow-xs transition hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" type="submit">
                            <twig:ux:icon name="lucide:save" class="size-4" aria-hidden="true"/>
                            Enregistrer les modifications
                        </button>
                    </div>
                {{ form_end(form) }}
            </article>
        </section>

        {% if isLawyer and lawyerProfileForm %}
            <section class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
                <div class="flex items-start gap-3 border-b border-border pb-5">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                        <twig:ux:icon name="lucide:briefcase-business" class="size-5" aria-hidden="true"/>
                    </span>
                    <div><h2 class="text-lg font-semibold text-card-foreground">Profil professionnel</h2><p class="mt-1 text-sm text-muted-foreground">Présentez votre activité et rattachez votre profil à un cabinet.</p></div>
                </div>
                {{ form_start(lawyerProfileForm, {attr: {class: 'mt-7 space-y-6', novalidate: 'novalidate'}}) }}
                    <div class="grid gap-5 md:grid-cols-2">
                        <div class="space-y-2">{{ form_label(lawyerProfileForm.cabinet, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(lawyerProfileForm.cabinet, {attr: {class: 'flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(lawyerProfileForm.cabinet) }}</div>
                        <div class="space-y-2">{{ form_label(lawyerProfileForm.barNumber, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(lawyerProfileForm.barNumber, {attr: {class: 'flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(lawyerProfileForm.barNumber) }}</div>
                        <div class="space-y-2">{{ form_label(lawyerProfileForm.professionalStatus, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(lawyerProfileForm.professionalStatus, {attr: {class: 'flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(lawyerProfileForm.professionalStatus) }}</div>
                        <div class="space-y-2">{{ form_label(lawyerProfileForm.specializationSummary, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(lawyerProfileForm.specializationSummary, {attr: {class: 'flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_errors(lawyerProfileForm.specializationSummary) }}</div>
                        <div class="space-y-2">{{ form_label(lawyerProfileForm.professionalEmail, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(lawyerProfileForm.professionalEmail, {attr: {class: 'flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30', autocomplete: 'work email'}}) }}{{ form_errors(lawyerProfileForm.professionalEmail) }}</div>
                        <div class="space-y-2">{{ form_label(lawyerProfileForm.professionalPhone, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(lawyerProfileForm.professionalPhone, {attr: {class: 'flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30', autocomplete: 'work tel'}}) }}{{ form_errors(lawyerProfileForm.professionalPhone) }}</div>
                    </div>
                    <div class="rounded-xl border border-border bg-muted/30 p-4">
                        <div class="flex items-start gap-3">
                            {{ form_widget(lawyerProfileForm.directoryVisible, {attr: {class: 'mt-1 size-4 rounded border-input text-primary focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}
                            <div>
                                {{ form_label(lawyerProfileForm.directoryVisible, null, {label_attr: {class: 'text-sm font-medium'}}) }}
                                <p class="mt-1 text-sm text-muted-foreground">Seules vos coordonnées professionnelles seront destinées à l’annuaire. L’adresse email de votre compte reste privée.</p>
                                <div class="text-sm text-destructive">{{ form_errors(lawyerProfileForm.directoryVisible) }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="space-y-3">
                        {{ form_label(lawyerProfileForm.portrait, null, {label_attr: {class: 'text-sm font-medium'}}) }}
                        {% if portraitUrl %}<img src="{{ portraitUrl }}" alt="Portrait professionnel actuel" class="size-24 rounded-xl border border-border object-cover">{% endif %}
                        {{ form_widget(lawyerProfileForm.portrait, {attr: {class: 'block w-full rounded-xl border border-input bg-background px-3 py-2 text-sm text-foreground file:mr-3 file:rounded-md file:border-0 file:bg-primary/10 file:px-3 file:py-2 file:text-sm file:font-medium file:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}
                        <p class="text-xs text-muted-foreground">JPEG, PNG ou WebP · 5 Mio maximum.</p>
                        <div class="text-sm text-destructive">{{ form_errors(lawyerProfileForm.portrait) }}</div>
                        {% if portraitUrl %}
                            <div class="flex items-center gap-2">{{ form_widget(lawyerProfileForm.removePortrait, {attr: {class: 'size-4 rounded border-input text-primary focus-visible:ring-2 focus-visible:ring-ring/30'}}) }}{{ form_label(lawyerProfileForm.removePortrait, null, {label_attr: {class: 'text-sm text-muted-foreground'}}) }}</div>
                        {% endif %}
                    </div>
                    <div class="space-y-2">
                        {{ form_label(lawyerProfileForm.bio, null, {label_attr: {class: 'text-sm font-medium'}}) }}
                        <div {{ react_component('Content/RichTextEditor', {inputId: lawyerProfileForm.bio.vars.id, label: 'Présentation professionnelle', value: lawyerProfileForm.bio.vars.value|default(''), placeholder: 'Présentez votre parcours, vos domaines d’intervention et votre expérience…', invalid: lawyerProfileForm.bio.vars.errors|length > 0}) }}></div>
                        {{ form_widget(lawyerProfileForm.bio, {attr: {class: 'sr-only', tabindex: '-1', 'aria-hidden': 'true'}}) }}
                        <div class="text-sm text-destructive">{{ form_errors(lawyerProfileForm.bio) }}</div>
                        <p class="text-xs text-muted-foreground">La mise en forme est nettoyée côté serveur.</p>
                    </div>
                    <div class="flex justify-end border-t border-border pt-6"><button class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-primary px-5 text-sm font-medium text-primary-foreground shadow-xs transition hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" type="submit"><twig:ux:icon name="lucide:save" class="size-4"/>Enregistrer le profil professionnel</button></div>
                {{ form_end(lawyerProfileForm) }}
            </section>
        {% endif %}

        <section class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-start gap-3">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                        <twig:ux:icon name="lucide:lock-keyhole" class="size-5" aria-hidden="true"/>
                    </span>
                    <div>
                        <h2 class="text-lg font-semibold text-card-foreground">Sécurité du compte</h2>
                        <p class="mt-1 max-w-2xl text-sm text-muted-foreground">Modifiez régulièrement votre mot de passe et choisissez un mot de passe unique.</p>
                    </div>
                </div>
                <button type="button"
                        class="inline-flex min-h-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-border px-4 text-sm font-medium text-card-foreground transition hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                        data-controller="modal"
                        data-action="click->modal#open"
                        data-modal-id-param="member-change-password-{{ command.id }}">
                    <twig:ux:icon name="lucide:key-round" class="size-4" aria-hidden="true"/>
                    Modifier le mot de passe
                </button>
            </div>
        </section>

        {% if command.id %}
            {{ component('ProfilePasswordChangeModalFormComponent', {
                id: 'member-change-password-' ~ command.id,
                title: 'Modifier mon mot de passe',
                urlPath: path('app_user_profile_change_password', {id: command.id})
            }) }}
        {% endif %}
    </div>
{% endblock %}
