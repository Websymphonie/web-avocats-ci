{% set training = summary.training %}
{% set isLive = training.type.value == 'LIVE' %}
{% set liveDetails = training.liveDetails %}
{% set isUpcoming = isLive and liveDetails and liveDetails.startsAt > now %}
{% set isPast = isLive and liveDetails and liveDetails.endsAt <= now %}
{% set trainingImageUrl = coverUrl|default(default_image_url) %}
<article class="group overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
    <div class="relative aspect-[16/7] overflow-hidden bg-gradient-to-br from-[#10233f] via-[#183b63] to-[#d8b878]/70">
        <img src="{{ trainingImageUrl }}" alt="" class="size-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy">
        <div class="absolute inset-0 bg-gradient-to-t from-[#10233f]/85 via-[#10233f]/10 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-x-4 top-4 flex items-start justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-black/35 px-2.5 py-1 text-[11px] font-semibold text-white backdrop-blur-sm">
                <twig:ux:icon name="{{ isLive ? 'lucide:radio-tower' : 'lucide:book-open' }}" class="size-3.5" aria-hidden="true"/>
                {{ isLive ? 'Live' : 'Cours' }}
            </span>
            {% if summary.category %}
                <span class="max-w-[55%] truncate rounded-full bg-black/35 px-2.5 py-1 text-[11px] font-medium text-white/90 backdrop-blur-sm">{{ summary.category.name }}</span>
            {% endif %}
        </div>
    </div>

    <div class="p-5">
        <h3 class="line-clamp-2 text-base font-semibold leading-6 text-card-foreground">
            {% if isLive %}
                <a href="{{ path('learning_member_live_session', {uuid: training.uuid}) }}" class="transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ training.title }}</a>
            {% else %}
                {{ training.title }}
            {% endif %}
        </h3>

        {% if isLive and liveDetails %}
            <div class="mt-4 space-y-2 text-sm text-muted-foreground">
                <p class="flex items-start gap-2">
                    <twig:ux:icon name="lucide:calendar-clock" class="mt-0.5 size-4 shrink-0 text-primary" aria-hidden="true"/>
                    <span>{{ liveDetails.startsAt|format_datetime('long', 'short', locale='fr_FR') }}</span>
                </p>
                <p class="flex items-center gap-2">
                    <twig:ux:icon name="lucide:map-pin" class="size-4 shrink-0 text-primary" aria-hidden="true"/>
                    <span>{{ liveDetails.deliveryMode.label() }}{% if liveDetails.location %} · {{ liveDetails.location }}{% endif %}</span>
                </p>
            </div>
            <div class="mt-5 flex items-center justify-between gap-3">
                <span class="text-xs font-medium {{ isPast ? 'text-muted-foreground' : (isUpcoming ? 'text-amber-700 dark:text-amber-300' : 'text-emerald-700 dark:text-emerald-300') }}">
                    {{ isPast ? 'Session passée' : (isUpcoming ? 'À venir' : 'En cours') }}
                </span>
                {% if liveDetails %}
                    <a href="{{ path('learning_member_live_session', {uuid: training.uuid}) }}" class="inline-flex min-h-9 items-center gap-1.5 rounded-lg bg-primary px-3 text-xs font-semibold text-primary-foreground transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                        Voir le détail
                        <twig:ux:icon name="lucide:arrow-up-right" class="size-3.5" aria-hidden="true"/>
                    </a>
                {% endif %}
            </div>
        {% else %}
            {% set progress = summary.progress %}
            {% set coursePlayerUrl = progress.progressPercentage >= 100 or progress.lastAccessedLessonUuid is null or progress.lastAccessedLessonCompleted
                ? path('learning_member_course_player', {uuid: training.uuid})
                : path('learning_member_course_lesson', {uuid: training.uuid, lessonUuid: progress.lastAccessedLessonUuid}) %}
            <div class="mt-4">
                <div class="mb-2 flex items-center justify-between gap-3 text-xs font-medium">
                    <span class="text-muted-foreground">Progression</span>
                    <span class="text-card-foreground">{{ progress.progressPercentage }} %</span>
                </div>
                <div class="h-2 overflow-hidden rounded-full bg-muted" role="progressbar" aria-label="Progression de {{ training.title }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress.progressPercentage }}">
                    <div class="h-full rounded-full bg-primary transition-all" style="width: {{ progress.progressPercentage }}%"></div>
                </div>
                <p class="mt-2 text-xs text-muted-foreground">
                    {% if progress.progressPercentage >= 100 %}
                        Formation terminée
                    {% elseif progress.lastActivityAt %}
                        Dernière activité le {{ progress.lastActivityAt|format_datetime('short', locale='fr_FR') }}
                    {% else %}
                        Pas encore commencée
                    {% endif %}
                </p>
                <a href="{{ coursePlayerUrl }}" class="mt-4 inline-flex min-h-10 w-full items-center justify-center gap-2 rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                    {% if progress.progressPercentage >= 100 %}Revoir la formation{% elseif progress.startedLessons > 0 %}Reprendre le parcours{% else %}Commencer la formation{% endif %}
                    <twig:ux:icon name="lucide:arrow-right" class="size-4" aria-hidden="true"/>
                </a>
            </div>
        {% endif %}
    </div>
</article>
