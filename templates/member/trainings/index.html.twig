{% extends 'layouts/member.html.twig' %}

{% block title %}Mes formations{% endblock %}
{% block member_page_title %}Mes formations{% endblock %}

{% block body %}
    <div class="space-y-8">
        <section class="flex flex-col justify-between gap-5 border-b border-border pb-7 sm:flex-row sm:items-end">
            <div>
                <p class="mb-2 flex items-center gap-2 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-[#a77d2e] dark:text-[#e0bf7d]">
                    <span class="h-px w-7 bg-[#c49b52] dark:bg-[#d8b878]"></span>
                    Espace avocat
                </p>
                <h1 class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">Mes formations</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground sm:text-base">Retrouvez vos parcours accessibles et vos prochaines sessions.</p>
            </div>
            <span class="inline-flex w-fit items-center gap-2 rounded-full border border-border bg-card px-3 py-1.5 text-xs font-medium text-muted-foreground">
                <twig:ux:icon name="lucide:graduation-cap" class="size-4" aria-hidden="true"/>
                {{ allSummaries|length }} accès
            </span>
        </section>

        <nav class="flex gap-1 overflow-x-auto rounded-2xl border border-border bg-card p-1.5" aria-label="Filtrer mes formations">
            {% set tabs = {
                all: 'Toutes',
                current: 'En cours',
                upcoming: 'À venir',
                completed: 'Terminées'
            } %}
            {% for key, label in tabs %}
                <a href="{{ path('learning_member_training_list', {view: key}) }}"
                   class="inline-flex min-h-10 shrink-0 items-center gap-2 rounded-xl px-3.5 text-sm font-medium transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{ view == key ? 'bg-primary text-primary-foreground shadow-sm' : 'text-muted-foreground hover:bg-muted hover:text-foreground' }}"
                   {% if view == key %}aria-current="page"{% endif %}>
                    {{ label }}
                    <span class="rounded-full px-1.5 py-0.5 text-[11px] {{ view == key ? 'bg-primary-foreground/15 text-primary-foreground' : 'bg-muted text-muted-foreground' }}">{{ key == 'all' ? allSummaries|length : groups[key]|length }}</span>
                </a>
            {% endfor %}
        </nav>

        {% if allSummaries is empty %}
            <section class="rounded-2xl border border-dashed border-border bg-card px-6 py-16 text-center" aria-labelledby="empty-training-title">
                <span class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                    <twig:ux:icon name="lucide:graduation-cap" class="size-7" aria-hidden="true"/>
                </span>
                <h2 id="empty-training-title" class="mt-5 text-lg font-semibold text-card-foreground">Vous n’avez encore aucune formation accessible.</h2>
                <p class="mx-auto mt-2 max-w-lg text-sm leading-6 text-muted-foreground">Les formations auxquelles vous aurez accès apparaîtront automatiquement dans cet espace.</p>
            </section>
        {% elseif summaries is empty %}
            <section class="rounded-2xl border border-dashed border-border bg-card px-6 py-14 text-center" aria-labelledby="empty-filter-title">
                <span class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-muted text-muted-foreground">
                    <twig:ux:icon name="lucide:filter-x" class="size-6" aria-hidden="true"/>
                </span>
                <h2 id="empty-filter-title" class="mt-4 text-lg font-semibold text-card-foreground">Aucune formation dans cette catégorie.</h2>
                <a href="{{ path('learning_member_training_list') }}" class="mt-4 inline-flex min-h-10 items-center justify-center rounded-xl bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Voir toutes les formations</a>
            </section>
        {% else %}
            {% set sections = view == 'all' ? {
                current: 'En cours',
                upcoming: 'À venir',
                completed: 'Terminées'
            } : { (view): tabs[view] } %}
            {% for groupKey, groupLabel in sections %}
                {% set items = view == 'all' ? groups[groupKey] : summaries %}
                {% if items is not empty %}
                    <section aria-labelledby="training-section-{{ groupKey }}">
                        <div class="mb-4 flex items-center justify-between gap-4">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Mon espace</p>
                                <h2 id="training-section-{{ groupKey }}" class="mt-1 text-xl font-semibold tracking-tight text-foreground">{{ groupLabel }}</h2>
                            </div>
                            <span class="text-sm text-muted-foreground">{{ items|length }} formation{{ items|length > 1 ? 's' : '' }}</span>
                        </div>
                        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                            {% for summary in items %}
                                {% include 'member/trainings/_card.html.twig' with {summary: summary, coverUrl: coverUrls[summary.training.coverMediaId]|default(null), now: date('now') } only %}
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
