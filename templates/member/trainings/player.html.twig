{% extends 'layouts/member.html.twig' %}

{% set training = player.training %}
{% set activeLesson = player.activeLesson %}
{% set currentPath = path('learning_member_course_lesson', {uuid: training.uuid, lessonUuid: activeLesson.lesson.uuid}) %}

{% block title %}{{ training.title }}{% endblock %}
{% block member_page_title %}{{ training.title }}{% endblock %}

{% block body %}
    <div class="space-y-6">
        <header class="flex flex-col gap-5 border-b border-border pb-6 lg:flex-row lg:items-end lg:justify-between">
            <div class="min-w-0">
                <a href="{{ path('learning_member_training_list') }}" class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                    <twig:ux:icon name="lucide:arrow-left" class="size-4" aria-hidden="true"/>
                    Mes formations
                </a>
                <div class="mt-4 flex items-start gap-4">
                    {% if coverUrl %}
                        <img src="{{ coverUrl }}" alt="" class="hidden size-16 shrink-0 rounded-xl object-cover shadow-sm sm:block">
                    {% else %}
                        <span class="hidden size-16 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary sm:flex"><twig:ux:icon name="lucide:book-open" class="size-7" aria-hidden="true"/></span>
                    {% endif %}
                    <div class="min-w-0">
                        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">{{ player.category ? player.category.name : 'Formation' }}</p>
                        <h1 class="mt-1 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">{{ training.title }}</h1>
                    </div>
                </div>
            </div>
            <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-4 shadow-sm lg:w-72">
                <div class="flex items-center justify-between gap-3 text-sm">
                    <span class="font-medium text-card-foreground">Votre progression</span>
                    <span class="font-semibold text-primary">{{ player.progress.progressPercentage }} %</span>
                </div>
                <div class="mt-3 h-2 overflow-hidden rounded-full bg-muted" role="progressbar" aria-label="Progression de {{ training.title }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ player.progress.progressPercentage }}">
                    <div class="h-full rounded-full bg-primary transition-all" style="width: {{ player.progress.progressPercentage }}%"></div>
                </div>
                <p class="mt-2 text-xs text-muted-foreground">{{ player.progress.completedLessons }} / {{ player.progress.totalLessons }} leçon{{ player.progress.totalLessons > 1 ? 's' : '' }} terminée{{ player.progress.totalLessons > 1 ? 's' : '' }}</p>
            </div>
        </header>

        <div class="lg:hidden">
            <details class="group rounded-2xl border border-border bg-card shadow-sm">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-4 font-semibold text-card-foreground marker:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                    <span class="flex items-center gap-2"><twig:ux:icon name="lucide:list-tree" class="size-4 text-primary" aria-hidden="true"/>Programme</span>
                    <twig:ux:icon name="lucide:chevron-down" class="size-4 text-muted-foreground transition group-open:rotate-180" aria-hidden="true"/>
                </summary>
                <div class="border-t border-border p-3">
                    {% include 'member/trainings/_player_navigation.html.twig' with {player: player, compact: true} only %}
                </div>
            </details>
        </div>

        <div class="grid gap-6 lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] xl:grid-cols-[minmax(0,21rem)_minmax(0,1fr)]">
            <aside class="hidden h-fit rounded-2xl border border-border bg-card p-4 shadow-sm lg:block lg:sticky lg:top-24">
                <div class="mb-4 flex items-center justify-between gap-3">
                    <h2 class="font-semibold text-card-foreground">Programme</h2>
                    <span class="text-xs text-muted-foreground">{{ player.progress.totalLessons }} leçon{{ player.progress.totalLessons > 1 ? 's' : '' }}</span>
                </div>
                {% include 'member/trainings/_player_navigation.html.twig' with {player: player, compact: false} only %}
            </aside>

            <article class="min-w-0 rounded-2xl border border-border bg-card shadow-sm">
                <div class="border-b border-border px-5 py-5 sm:px-7">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
                            <twig:ux:icon name="lucide:play-circle" class="size-3.5" aria-hidden="true"/>
                            Leçon {{ activeLesson.lesson.position }}
                        </span>
                        {% if activeLesson.isCompleted() %}
                            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-300"><twig:ux:icon name="lucide:check-circle-2" class="size-4" aria-hidden="true"/>Terminée</span>
                        {% elseif activeLesson.isStarted() %}
                            <span class="text-xs font-medium text-amber-700 dark:text-amber-300">En cours</span>
                        {% else %}
                            <span class="text-xs font-medium text-muted-foreground">À commencer</span>
                        {% endif %}
                    </div>
                    <h2 class="mt-4 text-2xl font-semibold tracking-tight text-card-foreground">{{ activeLesson.lesson.title }}</h2>
                    {% if activeLesson.lesson.summary %}<p class="mt-2 text-sm leading-6 text-muted-foreground">{{ activeLesson.lesson.summary }}</p>{% endif %}
                </div>

                <div class="space-y-7 px-5 py-6 sm:px-7 sm:py-8">
                    {% if activeLesson.lesson.content is not empty %}
                        <div class="rich-content max-w-none text-sm leading-7 text-card-foreground sm:text-base">{{ activeLesson.lesson.content|raw }}</div>
                    {% endif %}

                    {% if activeLesson.lesson.videoEmbedUrl %}
                        <div class="aspect-video overflow-hidden rounded-2xl border border-border bg-muted shadow-sm">
                            <iframe class="size-full" src="{{ activeLesson.lesson.videoEmbedUrl }}" title="Vidéo de la leçon {{ activeLesson.lesson.title }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                        </div>
                    {% endif %}

                    {% if activeLesson.resources is not empty %}
                        <section class="rounded-2xl border border-border bg-muted/30 p-4 sm:p-5" aria-labelledby="lesson-resources-title">
                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <h3 id="lesson-resources-title" class="font-semibold text-card-foreground">Ressources</h3>
                                    <p class="mt-1 text-xs text-muted-foreground">Documents utiles pour cette leçon.</p>
                                </div>
                                <twig:ux:icon name="lucide:paperclip" class="size-5 text-primary" aria-hidden="true"/>
                            </div>
                            <ul class="mt-4 space-y-2">
                                {% for resource in activeLesson.resources %}
                                    <li>
                                        <a href="{{ path('learning_member_resource_download', {resourceUuid: resource.uuid}) }}" class="flex items-center gap-3 rounded-xl border border-border bg-card px-3 py-3 text-sm transition hover:border-primary/50 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                                            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary"><twig:ux:icon name="lucide:file-down" class="size-4" aria-hidden="true"/></span>
                                            <span class="min-w-0 flex-1"><span class="block truncate font-medium text-card-foreground">{{ resource.title }}</span><span class="mt-0.5 block truncate text-xs text-muted-foreground">{{ resource.originalName }}</span></span>
                                            <twig:ux:icon name="lucide:download" class="size-4 shrink-0 text-muted-foreground" aria-hidden="true"/>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}

                    <div class="flex flex-col gap-3 border-t border-border pt-5 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex gap-2">
                            {% if player.previousLesson %}
                                <a href="{{ path('learning_member_course_lesson', {uuid: training.uuid, lessonUuid: player.previousLesson.lesson.uuid}) }}" class="inline-flex min-h-10 items-center gap-2 rounded-xl border border-border bg-background px-3.5 text-sm font-medium text-foreground transition hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><twig:ux:icon name="lucide:arrow-left" class="size-4" aria-hidden="true"/>Précédente</a>
                            {% endif %}
                        </div>
                        <div class="flex flex-wrap justify-end gap-2">
                            {% if not activeLesson.isStarted() %}
                                <form method="post" action="{{ path('learning_member_lesson_start', {uuid: activeLesson.lesson.uuid}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('learning_member_lesson_start_' ~ activeLesson.lesson.uuid) }}">
                                    <input type="hidden" name="_return_to" value="{{ currentPath }}">
                                    <button type="submit" class="inline-flex min-h-10 items-center gap-2 rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Commencer la leçon<twig:ux:icon name="lucide:play" class="size-4" aria-hidden="true"/></button>
                                </form>
                            {% elseif not activeLesson.isCompleted() %}
                                <form method="post" action="{{ path('learning_member_lesson_complete', {uuid: activeLesson.lesson.uuid}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('learning_member_lesson_complete_' ~ activeLesson.lesson.uuid) }}">
                                    <input type="hidden" name="_return_to" value="{{ currentPath }}">
                                    <button type="submit" class="inline-flex min-h-10 items-center gap-2 rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Marquer comme terminée<twig:ux:icon name="lucide:check" class="size-4" aria-hidden="true"/></button>
                                </form>
                            {% endif %}
                            {% if player.nextLesson %}
                                <a href="{{ path('learning_member_course_lesson', {uuid: training.uuid, lessonUuid: player.nextLesson.lesson.uuid}) }}" class="inline-flex min-h-10 items-center gap-2 rounded-xl border border-primary/30 bg-primary/5 px-3.5 text-sm font-medium text-primary transition hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Suivante<twig:ux:icon name="lucide:arrow-right" class="size-4" aria-hidden="true"/></a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </div>
{% endblock %}
