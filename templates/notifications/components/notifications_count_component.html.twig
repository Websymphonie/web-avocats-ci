{% if this.count > 0 %}
    <span class="absolute -right-1 -top-1 inline-flex min-w-4 items-center justify-center rounded-full bg-primary px-1 text-[10px] font-semibold leading-4 text-primary-foreground"
          aria-label="{{ this.count }} notification{{ this.count > 1 ? 's' : '' }} non lue{{ this.count > 1 ? 's' : '' }}">
        {{ this.count > 99 ? '99+' : this.count }}
    </span>
{% endif %}
