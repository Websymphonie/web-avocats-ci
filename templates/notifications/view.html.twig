{% extends 'layouts/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <div class="mx-auto max-w-3xl">
            <a class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
               href="{{ path('app_notifications_index') }}">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     aria-hidden="true">
                    <path d="m15 18-6-6 6-6"></path>
                </svg>
                Retour aux notifications
            </a>

            <article class="mt-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8"
                     aria-labelledby="notification-title">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground">{{ notification.type ? notification.type.label() : 'Information' }}</span>
                    <span class="rounded-full border border-border bg-background px-2.5 py-1 text-xs font-medium text-muted-foreground">{{ notification.action ? notification.action.label() : 'Mise à jour' }}</span>
                    <span class="rounded-full border border-border bg-background px-2.5 py-1 text-xs font-medium text-muted-foreground">{{ notification.readAt ? 'Lue' : 'Non lue' }}</span>
                </div>

                <h1 id="notification-title" class="mt-6 text-2xl font-semibold tracking-[-0.03em] text-foreground">
                    {{ notification.title ?? 'Détails de la notification' }}</h1>
                <p class="mt-2 text-sm text-muted-foreground">{{ notification.createdAt ? notification.createdAt|date('d/m/Y à H:i') : '' }}</p>

                <div class="mt-7 border-t border-border pt-6 text-sm leading-7 text-foreground">
                    {{ notification.message }}
                </div>

            </article>
        </div>
    </main>
{% endblock %}
