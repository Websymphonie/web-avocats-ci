{% extends 'layouts/base.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier le tarif' : 'Nouveau tarif' }}{% endblock %}

{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="mx-auto max-w-3xl space-y-6">
        <div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('payment_admin_offer_list') }}">← Tarifs des formations</a><h1 class="mt-3 text-2xl font-semibold tracking-[-0.03em]">{{ isEdit ? 'Modifier le tarif' : 'Nouveau tarif' }}</h1><p class="mt-2 text-sm text-muted-foreground">Le montant est enregistré côté serveur et sera utilisé comme référence du paiement.</p></div>
        <section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            {{ form_start(form, {attr: {class: 'space-y-6', novalidate: true}}) }}
            <div class="space-y-2">{{ form_label(form.trainingId, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.trainingId, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}{{ form_errors(form.trainingId) }}</div>
            <div class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_10rem]">
                <div class="space-y-2">{{ form_label(form.amount, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.amount, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm'}}) }}{{ form_errors(form.amount) }}</div>
                <div class="space-y-2">{{ form_label(form.currency, null, {label_attr: {class: 'text-sm font-medium'}}) }}{{ form_widget(form.currency, {attr: {class: 'flex h-11 w-full rounded-lg border border-input bg-background px-3 text-sm uppercase'}}) }}{{ form_errors(form.currency) }}</div>
            </div>
            <div class="flex items-start gap-3 rounded-xl border border-border bg-muted/20 p-4">{{ form_widget(form.active, {attr: {class: 'mt-1 size-4 accent-primary'}}) }}<div>{{ form_label(form.active, null, {label_attr: {class: 'text-sm font-medium'}}) }}<p class="mt-1 text-xs text-muted-foreground">Un seul tarif est conservé par formation. Désactivez-le pour empêcher toute nouvelle initiation.</p></div></div>
            {{ form_errors(form) }}
            <div class="flex flex-wrap justify-end gap-3 border-t border-border pt-5"><a class="inline-flex h-10 items-center justify-center rounded-lg px-4 text-sm font-medium text-muted-foreground hover:bg-muted" href="{{ path('payment_admin_offer_list') }}">Annuler</a><button class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90" type="submit"><twig:ux:icon name="lucide:save" class="size-4"/>Enregistrer</button></div>
            {{ form_end(form) }}
        </section>
    </div>
</main>
{% endblock %}
