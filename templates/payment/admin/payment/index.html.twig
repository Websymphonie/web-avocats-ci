{% extends 'layouts/base.html.twig' %}

{% block title %}Paiements{% endblock %}

{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="mx-auto max-w-7xl space-y-6">
        <section class="flex flex-col gap-4 rounded-2xl border border-border bg-card p-6 sm:flex-row sm:items-center sm:justify-between"><div><p class="text-sm font-medium text-muted-foreground">Paiements</p><h1 class="mt-1 text-2xl font-semibold tracking-[-0.03em]">Historique des paiements</h1><p class="mt-2 text-sm text-muted-foreground">Consultation en lecture seule des transactions initiées par les membres.</p></div><div class="flex flex-wrap gap-2"><a class="inline-flex h-10 items-center justify-center gap-2 self-start rounded-lg border border-border px-4 text-sm font-medium hover:bg-muted" href="{{ path('payment_admin_payment_list', pendingFulfillmentOnly ? {} : {pendingFulfillment: 1}) }}"><twig:ux:icon name="lucide:triangle-alert" class="size-4"/>{{ pendingFulfillmentOnly ? 'Voir tous les paiements' : 'Accès à traiter' }}</a><a class="inline-flex h-10 items-center justify-center gap-2 self-start rounded-lg border border-border px-4 text-sm font-medium hover:bg-muted" href="{{ path('payment_admin_offer_list') }}"><twig:ux:icon name="lucide:settings-2" class="size-4"/>Tarifs</a></div></section>
        <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm"><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-muted/50 text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-5 py-3 font-medium">Référence</th><th class="px-5 py-3 font-medium">Utilisateur</th><th class="px-5 py-3 font-medium">Formation</th><th class="px-5 py-3 font-medium">Montant</th><th class="px-5 py-3 font-medium">Fournisseur</th><th class="px-5 py-3 font-medium">Statut</th><th class="px-5 py-3 font-medium">Date</th><th class="px-5 py-3 text-right font-medium">Action</th></tr></thead><tbody class="divide-y divide-border">
        {% for item in items %}{% set fulfillmentPending = item.payment.status.value == 'CONFIRMED' and (item.payment.fulfillmentStatus is null or item.payment.fulfillmentStatus.value == 'PENDING') %}<tr class="transition-colors hover:bg-muted/40"><td class="px-5 py-4"><p class="font-medium">{{ item.payment.providerReference|default('—') }}</p><p class="mt-1 text-xs text-muted-foreground">{{ item.payment.uuid }}</p></td><td class="px-5 py-4">{{ item.user.email|default('Utilisateur #' ~ item.payment.userId) }}</td><td class="px-5 py-4">{{ item.training ? item.training.title : 'Formation indisponible' }}</td><td class="px-5 py-4 font-medium">{{ item.payment.amount|number_format(0, ',', ' ') }} {{ item.payment.currency }}</td><td class="px-5 py-4">{{ item.payment.provider.label }}</td><td class="px-5 py-4"><twig:Badge variant="{{ item.payment.status.value == 'CONFIRMED' ? 'success' : (item.payment.status.value == 'FAILED' ? 'destructive' : 'secondary') }}">{{ item.payment.status.label }}</twig:Badge></td><td class="px-5 py-4"><twig:Badge variant="{{ fulfillmentPending ? 'warning' : (item.payment.fulfillmentStatus.value|default('') == 'COMPLETED' ? 'success' : 'secondary') }}">{{ fulfillmentPending ? 'À traiter' : (item.payment.fulfillmentStatus.value|default('') == 'COMPLETED' ? 'Accès activé' : '—') }}</twig:Badge></td><td class="px-5 py-4">{{ item.payment.createdAt ? item.payment.createdAt|date('d/m/Y H:i') : '—' }}</td><td class="px-5 py-4 text-right"><a class="inline-flex h-9 items-center gap-2 rounded-lg border border-border px-3 text-sm font-medium hover:bg-muted" href="{{ path('payment_admin_payment_show', {uuid: item.payment.uuid}) }}"><twig:ux:icon name="lucide:eye" class="size-4"/>Voir</a></td></tr>{% else %}<tr><td class="px-6 py-14 text-center text-muted-foreground" colspan="9">Aucun paiement enregistré.</td></tr>{% endfor %}
        </tbody></table></div></section>
    </div>
</main>
{% endblock %}
