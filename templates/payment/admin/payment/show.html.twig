{% extends 'layouts/base.html.twig' %}

{% block title %}Détail du paiement{% endblock %}

{% block body %}
<main class="flex-1 bg-muted/30 px-4 py-6 sm:px-6 lg:px-8 lg:py-8"><div class="mx-auto max-w-3xl space-y-6"><div><a class="text-sm text-muted-foreground hover:text-foreground" href="{{ path('payment_admin_payment_list') }}">← Paiements</a><h1 class="mt-3 text-2xl font-semibold tracking-[-0.03em]">Détail du paiement</h1><p class="mt-2 text-sm text-muted-foreground">Les paiements ne peuvent pas être confirmés ou modifiés manuellement.</p></div><section class="rounded-2xl border border-border bg-card p-6 shadow-sm"><dl class="grid gap-5 sm:grid-cols-2"><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Référence fournisseur</dt><dd class="mt-1 font-medium">{{ payment.providerReference|default('—') }}</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Statut</dt><dd class="mt-1"><twig:Badge variant="{{ payment.status.value == 'CONFIRMED' ? 'success' : (payment.status.value == 'FAILED' ? 'destructive' : 'secondary') }}">{{ payment.status.label }}</twig:Badge></dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Traitement d’accès</dt><dd class="mt-1"><twig:Badge variant="{{ payment.status.value == 'CONFIRMED' and (payment.fulfillmentStatus is null or payment.fulfillmentStatus.value == 'PENDING') ? 'warning' : (payment.fulfillmentStatus.value|default('') == 'COMPLETED' ? 'success' : 'secondary') }}">{{ payment.status.value == 'CONFIRMED' and (payment.fulfillmentStatus is null or payment.fulfillmentStatus.value == 'PENDING') ? 'À traiter' : (payment.fulfillmentStatus.value|default('') == 'COMPLETED' ? 'Accès activé' : '—') }}</twig:Badge></dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Tentatives de traitement</dt><dd class="mt-1">{{ payment.fulfillmentAttempts }}</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Dernière tentative</dt><dd class="mt-1">{{ payment.lastFulfillmentAttemptAt ? payment.lastFulfillmentAttemptAt|date('d/m/Y H:i') : '—' }}</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Utilisateur</dt><dd class="mt-1">{{ user.email|default('Utilisateur #' ~ payment.userId) }}</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Formation</dt><dd class="mt-1">{{ training.title|default('Formation #' ~ payment.trainingId) }}</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Montant snapshot</dt><dd class="mt-1 font-medium">{{ payment.amount|number_format(0, ',', ' ') }} {{ payment.currency }}</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Fournisseur</dt><dd class="mt-1">{{ payment.provider.label }}</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Clé d’idempotence</dt><dd class="mt-1 break-all text-sm">{{ payment.idempotencyKey }}</dd></div><div><dt class="text-xs uppercase tracking-wide text-muted-foreground">UUID</dt><dd class="mt-1 break-all text-sm">{{ payment.uuid }}</dd></div></dl><div class="mt-6 flex justify-end border-t border-border pt-5"><a class="inline-flex h-10 items-center justify-center rounded-lg border border-border px-4 text-sm font-medium hover:bg-muted" href="{{ path('payment_admin_payment_list') }}">Retour à la liste</a></div></section></div></main>
{% endblock %}
