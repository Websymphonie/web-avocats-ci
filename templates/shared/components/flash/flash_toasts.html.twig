<div class="pointer-events-none fixed inset-x-4 top-4 z-[9999] flex max-h-[calc(100svh-2rem)] flex-col gap-3 overflow-y-auto overscroll-contain sm:inset-x-auto sm:right-5 sm:top-5 sm:w-full sm:max-w-sm"
     aria-label="Notifications">
    {% for type, messages in app.flashes %}
        {% set typeIndex = loop.index0 %}
        {% for message in messages %}
            {% set toastId = 'flash-toast-' ~ typeIndex ~ '-' ~ loop.index0 %}
            <div class="pointer-events-auto relative flex items-start gap-3 overflow-hidden rounded-2xl border p-4 shadow-lg shadow-black/10 animate-in slide-in-from-right duration-300 motion-reduce:animate-none {{ this.getClasses(type) }}"
                 data-controller="toast"
                 data-toast-timeout-value="5000"
                 data-action="mouseenter->toast#pause mouseleave->toast#resume focusin->toast#pause focusout->toast#resume"
                 role="{{ this.getRole(type) }}"
                 aria-live="{{ this.getAriaLive(type) }}"
                 aria-atomic="true"
                 aria-labelledby="{{ toastId }}-title"
                 aria-describedby="{{ toastId }}-message">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-xl {{ this.getIconClasses(type) }}" aria-hidden="true">
                    <twig:ux:icon name="{{ this.getIcon(type) }}" class="size-5"/>
                </span>

                <div class="min-w-0 flex-1 pt-0.5">
                    <p id="{{ toastId }}-title" class="text-sm font-semibold">{{ this.getLabel(type) }}</p>
                    <p id="{{ toastId }}-message" class="mt-0.5 break-words text-sm leading-5 opacity-80">{{ message }}</p>
                </div>

                <button class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg opacity-60 outline-none transition hover:bg-black/5 hover:opacity-100 focus-visible:ring-2 focus-visible:ring-current dark:hover:bg-white/10"
                        type="button"
                        data-action="toast#close"
                        aria-label="Fermer la notification"
                        title="Fermer">
                    <twig:ux:icon name="lucide:x" class="size-4" aria-hidden="true"/>
                </button>
            </div>
        {% endfor %}
    {% endfor %}
</div>
