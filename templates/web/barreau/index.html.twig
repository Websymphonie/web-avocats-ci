{% extends 'layouts/web.html.twig' %}

{% set isCarpa = section|default('BAR') == 'CARPA' %}
{% set sectionName = isCarpa ? 'La CARPA' : 'Le Barreau' %}
{% set sectionEyebrow = isCarpa ? 'La Caisse Autonome de Règlement Pécuniaire des Avocats' : "Le Barreau de Côte d'Ivoire" %}
{% set sectionDescription = isCarpa ? 'Missions, fonctionnement et informations de la CARPA.' : 'Repères institutionnels et informations publiées par le Barreau.' %}
{% set detailRoute = isCarpa ? 'web_carpa_page_detail' : 'web_bar_page_detail' %}
{% set sectionTitle = isCarpa ? 'Découvrir la CARPA' : 'Découvrir le Barreau' %}
{% set sectionLabel = isCarpa ? 'CARPA' : 'Barreau' %}

{% block title %}{{ sectionName }}{% endblock %}

{% block body %}
    <main class="min-h-[calc(100svh-9rem)] bg-muted/20">
        <section class="relative isolate overflow-hidden bg-[#10233f] text-white" aria-labelledby="institution-title">
            <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_80%_20%,rgba(216,184,120,0.2),transparent_36%),linear-gradient(115deg,#10233f_0%,#172d4d_58%,#10233f_100%)]"></div>
            <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-11">
                <nav class="flex flex-wrap items-center gap-2 text-sm text-white/65" aria-label="Fil d’Ariane">
                    <a href="{{ path('app_home') }}" class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Accueil</a>
                    <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true"/>
                    <span class="text-white" aria-current="page">{{ sectionName }}</span>
                </nav>
                <div class="mt-6 max-w-3xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.26em] text-[#f1d59b]">{{ sectionEyebrow }}</p>
                    <h1 id="institution-title" class="mt-3 text-4xl font-semibold leading-[1.04] tracking-[-0.05em] sm:text-5xl">{{ sectionName }}</h1>
                    <p class="mt-4 max-w-2xl text-base leading-7 text-white/70 sm:text-lg">{{ sectionDescription }}</p>
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16" aria-labelledby="institution-sections-title">
            <div class="border-b border-border pb-6">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-primary">Repères institutionnels</p>
                <h2 id="institution-sections-title" class="mt-2 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">{{ sectionTitle }}</h2>
            </div>

            {% if pages is empty %}
                <div class="mt-8 border-y border-dashed border-border py-14 text-center">
                    <p class="text-lg font-medium text-foreground">{{ isCarpa ? 'Les contenus de la CARPA seront publiés prochainement.' : 'Les contenus institutionnels seront publiés prochainement.' }}</p>
                    <p class="mt-2 text-sm text-muted-foreground">Aucune rubrique de {{ sectionLabel }} n’est disponible pour le moment.</p>
                </div>
            {% else %}
                {% set featuredPage = pages|first %}
                {% set featuredCoverUrl = featuredPage.coverMediaId is not null ? coverUrls[featuredPage.coverMediaId]|default(null) : null %}
                <div class="mt-7 grid gap-4 {{ pages|length > 1 ? 'lg:grid-cols-[minmax(0,1.08fr)_minmax(20rem,0.92fr)]' : '' }}">
                    <a href="{{ path(detailRoute, {slug: featuredPage.slug}) }}" class="group relative isolate flex min-h-64 items-end overflow-hidden rounded-2xl bg-[#10233f] p-6 text-white shadow-sm transition-[box-shadow,transform] duration-300 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:min-h-72 sm:p-8 {{ pages|length > 1 ? 'lg:min-h-[25rem]' : 'lg:min-h-72' }}">
                        {% if featuredCoverUrl %}
                            <img src="{{ featuredCoverUrl }}" alt="" aria-hidden="true" class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy">
                        {% endif %}
                        <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(16,35,63,0.12)_0%,rgba(16,35,63,0.34)_35%,rgba(16,35,63,0.96)_100%)]"></div>
                        {% if not featuredCoverUrl %}<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_82%_18%,rgba(216,184,120,0.24),transparent_36%),linear-gradient(125deg,#10233f_0%,#1b3558_58%,#10233f_100%)]"></div>{% endif %}
                        <div class="max-w-xl">
                            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#f1d59b]">{{ isCarpa ? 'La CARPA' : 'Le Barreau de Côte d’Ivoire' }}</p>
                            <h3 class="mt-3 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{{ featuredPage.title }}</h3>
                            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white">Découvrir <twig:ux:icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true"/></span>
                        </div>
                    </a>

                    {% if pages|length > 1 %}
                        <nav class="flex flex-col gap-3" aria-label="Autres rubriques de {{ sectionLabel }}">
                            {% for page in pages|slice(1) %}
                                <a href="{{ path(detailRoute, {slug: page.slug}) }}" class="group flex min-h-20 flex-1 items-center justify-between gap-5 rounded-xl border border-border bg-card px-5 py-4 transition-colors hover:border-primary/40 hover:bg-muted/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:px-6">
                                    <h3 class="text-lg font-semibold leading-snug text-foreground transition-colors group-hover:text-primary sm:text-xl">{{ page.title }}</h3>
                                    <twig:ux:icon name="lucide:arrow-up-right" class="size-5 shrink-0 text-muted-foreground transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary" aria-hidden="true"/>
                                </a>
                            {% endfor %}
                        </nav>
                    {% endif %}
                </div>
            {% endif %}
        </section>
    </main>
{% endblock %}
