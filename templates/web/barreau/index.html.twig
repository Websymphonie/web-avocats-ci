{% extends 'layouts/web.html.twig' %}

{% set isCarpa = section|default('BAR') == 'CARPA' %}
{% set sectionName = isCarpa ? 'La CARPA' : 'Le Barreau' %}
{% set sectionEyebrow = isCarpa ? 'La Caisse Autonome de Règlement Pécuniaire des Avocats' : "Le Barreau de Côte d'Ivoire" %}
{% set sectionDescription = isCarpa ? 'Missions, fonctionnement et informations de la CARPA.' : 'Repères institutionnels et informations publiées par le Barreau.' %}
{% set detailRoute = isCarpa ? 'web_carpa_page_detail' : 'web_bar_page_detail' %}
{% set sectionTitle = isCarpa ? 'Les rubriques de la CARPA' : 'Les rubriques du Barreau' %}
{% set sectionLabel = isCarpa ? 'CARPA' : 'Barreau' %}

{% block title %}{{ sectionName }}{% endblock %}

{% block body %}
    <main class="min-h-[calc(100svh-9rem)] bg-muted/20">
        <section class="relative isolate overflow-hidden bg-[#10233f] text-white" aria-labelledby="institution-title">
            <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_80%_20%,rgba(216,184,120,0.2),transparent_36%),linear-gradient(115deg,#10233f_0%,#172d4d_58%,#10233f_100%)]"></div>
            <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-11">
                <nav class="flex flex-wrap items-center gap-2 text-sm text-white/65" aria-label="Fil d’Ariane">
                    <a href="{{ path('app_home') }}" class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Accueil</a>
                    <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true"/>
                    <span class="text-white" aria-current="page">{{ sectionName }}</span>
                </nav>
                <div class="mt-6 max-w-3xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.26em] text-[#f1d59b]">{{ sectionEyebrow }}</p>
                    <h1 id="institution-title" class="mt-3 text-4xl font-semibold leading-[1.04] tracking-[-0.05em] sm:text-5xl">{{ sectionName }}</h1>
                    <p class="mt-4 max-w-2xl text-base leading-7 text-white/70 sm:text-lg">{{ sectionDescription }}</p>
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16" aria-labelledby="institution-sections-title">
            <div class="flex flex-col gap-3 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-primary">Navigation institutionnelle</p>
                    <h2 id="institution-sections-title" class="mt-2 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">{{ sectionTitle }}</h2>
                </div>
                {% if pages is not empty %}<p class="text-sm text-muted-foreground">{{ pages|length }} rubrique{{ pages|length > 1 ? 's' : '' }}</p>{% endif %}
            </div>

            {% if pages is empty %}
                <div class="mt-8 border-y border-dashed border-border py-14 text-center">
                    <p class="text-lg font-medium text-foreground">{{ isCarpa ? 'Les contenus de la CARPA seront publiés prochainement.' : 'Les contenus institutionnels seront publiés prochainement.' }}</p>
                    <p class="mt-2 text-sm text-muted-foreground">Aucune rubrique de {{ sectionLabel }} n’est disponible pour le moment.</p>
                </div>
            {% else %}
                <div class="divide-y divide-border border-b border-border">
                    {% for page in pages %}
                        {% set coverUrl = page.coverMediaId is not null ? coverUrls[page.coverMediaId]|default(null) : null %}
                        <a href="{{ path(detailRoute, {slug: page.slug}) }}" class="group grid gap-6 py-7 transition-colors hover:bg-muted/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset sm:grid-cols-[minmax(0,1fr)_10rem] sm:items-center lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-10 lg:py-8">
                            <div class="min-w-0">
                                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Rubrique institutionnelle</p>
                                <h3 class="mt-2 max-w-3xl text-2xl font-semibold leading-tight tracking-tight text-foreground transition-colors group-hover:text-primary sm:text-3xl">{{ page.title }}</h3>
                                <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary">Consulter la rubrique <twig:ux:icon name="lucide:arrow-up-right" class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true"/></span>
                            </div>
                            {% if coverUrl %}
                                <figure class="order-first overflow-hidden rounded-xl bg-muted sm:order-none"><img src="{{ coverUrl }}" alt="" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy"></figure>
                            {% else %}
                                <div class="order-first hidden h-full min-h-24 items-center justify-center rounded-xl border border-dashed border-border bg-muted/30 text-muted-foreground sm:order-none sm:flex" aria-hidden="true"><twig:ux:icon name="lucide:scale" class="size-7 opacity-50"/></div>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </main>
{% endblock %}
