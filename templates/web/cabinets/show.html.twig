{% extends 'layouts/web.html.twig' %}

{% block title %}{{ cabinet.name }} — Annuaire des cabinets{% endblock %}

{% block body %}
    <main class="min-h-[calc(100svh-9rem)] bg-muted/20">
        <section class="relative isolate overflow-hidden bg-[#10233f] text-white" aria-labelledby="cabinet-title">
            <div class="absolute -right-24 -top-32 size-[28rem] rounded-full border border-white/10" aria-hidden="true"></div>
            <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
                <nav class="flex flex-wrap items-center gap-2 text-sm text-white/65" aria-label="Fil d’Ariane">
                    <a href="{{ path('app_home') }}" class="hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Accueil</a>
                    <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
                    <a href="{{ path('web_lawyer_directory_list') }}" class="hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Trouver un avocat</a>
                    <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
                    <span class="max-w-full break-words text-white" aria-current="page">{{ cabinet.name }}</span>
                </nav>
                <p class="mt-8 text-xs font-semibold uppercase tracking-[0.24em] text-[#f1d59b]">Annuaire professionnel</p>
                <h1 id="cabinet-title" class="mt-3 max-w-4xl break-words text-3xl font-semibold leading-tight tracking-[-0.045em] sm:text-4xl lg:text-5xl">{{ cabinet.name }}</h1>
                {% if cabinet.city or cabinet.country %}<p class="mt-4 flex items-center gap-2 text-sm text-white/75"><twig:ux:icon name="lucide:map-pin" class="size-4 shrink-0" aria-hidden="true" />{{ [cabinet.city, cabinet.country]|filter(v => v)|join(', ') }}</p>{% endif %}
            </div>
        </section>

        <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
            <a id="directory-back" href="{{ path('web_lawyer_directory_list') }}" class="mb-7 inline-flex w-fit items-center gap-2 text-sm font-semibold text-primary underline decoration-transparent underline-offset-4 hover:decoration-current focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><twig:ux:icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />Retour à l’annuaire</a>
            <div class="grid gap-8 {{ (cabinet.phone or cabinet.email or cabinet.websiteUrl) ? 'lg:grid-cols-[minmax(0,1fr)_19rem]' : '' }}">
                <article class="min-w-0">
                    {% if cabinet.description %}<section aria-labelledby="cabinet-about-title"><h2 id="cabinet-about-title" class="text-2xl font-semibold tracking-[-0.035em] text-foreground">Présentation</h2><p class="mt-4 whitespace-pre-line break-words text-base leading-7 text-muted-foreground">{{ cabinet.description }}</p></section>{% endif %}
                    {% if cabinet.address or cabinet.city or cabinet.country %}
                        <section class="mt-8 border-t border-border pt-7" aria-labelledby="cabinet-address-title"><h2 id="cabinet-address-title" class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Adresse</h2><address class="mt-3 not-italic text-base leading-7 text-foreground">{% if cabinet.address %}{{ cabinet.address }}<br>{% endif %}{{ [cabinet.city, cabinet.country]|filter(v => v)|join(', ') }}</address></section>
                    {% endif %}
                </article>

                {% if cabinet.phone or cabinet.email or cabinet.websiteUrl %}
                    <aside class="h-fit rounded-xl border border-border bg-card p-5 sm:p-6" aria-labelledby="cabinet-contact-title">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Coordonnées</p><h2 id="cabinet-contact-title" class="mt-2 text-xl font-semibold text-card-foreground">Contacter le cabinet</h2>
                        <dl class="mt-5 space-y-4 text-sm">
                            {% if cabinet.email %}<div><dt class="text-muted-foreground">Email</dt><dd class="mt-1 break-all font-medium"><a href="mailto:{{ cabinet.email }}" class="underline decoration-border underline-offset-4 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ cabinet.email }}</a></dd></div>{% endif %}
                            {% if cabinet.phone %}<div><dt class="text-muted-foreground">Téléphone</dt><dd class="mt-1 break-words font-medium">{% if phoneHref %}<a href="{{ phoneHref }}" class="underline decoration-border underline-offset-4 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ cabinet.phone }}</a>{% else %}{{ cabinet.phone }}{% endif %}</dd></div>{% endif %}
                            {% if cabinet.websiteUrl %}<div><dt class="text-muted-foreground">Site internet</dt><dd class="mt-1 break-all font-medium">{% if websiteHref %}<a href="{{ websiteHref }}" target="_blank" rel="noopener noreferrer" class="underline decoration-border underline-offset-4 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ cabinet.websiteUrl }}</a>{% else %}{{ cabinet.websiteUrl }}{% endif %}</dd></div>{% endif %}
                        </dl>
                    </aside>
                {% endif %}
            </div>

            {% if cabinet.members is not empty %}
                <section class="mt-12 border-t border-border pt-8 sm:mt-14 sm:pt-10" aria-labelledby="cabinet-members-title">
                    <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Équipe</p><h2 id="cabinet-members-title" class="mt-2 text-2xl font-semibold tracking-[-0.04em] text-foreground sm:text-3xl">Avocats du cabinet</h2></div><p class="text-sm text-muted-foreground">{{ cabinet.members|length }} profil{{ cabinet.members|length > 1 ? 's' : '' }} public{{ cabinet.members|length > 1 ? 's' : '' }}</p></div>
                    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                        {% for member in cabinet.members %}
                            {% set portraitUrl = member.portraitMediaId ? memberMediaUrls[member.portraitMediaId]|default(null) : null %}
                            <a href="{{ path('web_lawyer_directory_profile', {uuid: member.publicUuid}) }}" class="flex min-w-0 items-center gap-4 rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                                {% if portraitUrl %}<img src="{{ portraitUrl }}" alt="" class="size-14 shrink-0 rounded-full border border-border object-cover">{% else %}<span class="inline-flex size-14 shrink-0 items-center justify-center rounded-full border border-primary/20 bg-primary/5 text-lg font-semibold uppercase text-primary" aria-hidden="true">{{ member.name|first }}</span>{% endif %}
                                <span class="min-w-0"><span class="block break-words font-semibold text-card-foreground">{{ member.name }}</span><span class="mt-1 inline-flex items-center gap-1 text-sm text-primary">Voir le profil <twig:ux:icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" /></span></span>
                            </a>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </div>
    </main>
{% endblock %}
