{% extends 'layouts/web.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
    <main class="min-h-[calc(100svh-9rem)] bg-muted/20">
        <section class="relative isolate overflow-hidden bg-[#10233f] text-white" aria-labelledby="contact-title">
            <div class="absolute inset-0 -z-10 bg-[linear-gradient(115deg,rgba(16,35,63,0.98)_0%,rgba(16,35,63,0.9)_52%,rgba(16,35,63,0.78)_100%)]"></div>
            <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
                <nav class="flex flex-wrap items-center gap-2 text-sm text-white/65" aria-label="Fil d’Ariane">
                    <a href="{{ path('app_home') }}" class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Accueil</a>
                    <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true"/>
                    <span class="text-white" aria-current="page">Contact</span>
                </nav>
                <div class="mt-6 max-w-3xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.26em] text-[#f1d59b]">Le Barreau de Côte d'Ivoire</p>
                    <h1 id="contact-title" class="mt-3 text-4xl font-semibold leading-[1.04] tracking-[-0.05em] sm:text-5xl">Nous contacter</h1>
                    <p class="mt-4 max-w-2xl text-base leading-7 text-white/70 sm:text-lg">Une question, une demande d’information ou un besoin d’orientation ? Écrivez-nous, notre équipe vous répondra dans les meilleurs délais.</p>
                </div>
            </div>
        </section>

        <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16">
            <div class="grid gap-8 lg:grid-cols-[minmax(15rem,0.72fr)_minmax(0,1.28fr)] lg:gap-14">
                <aside class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8" aria-labelledby="contact-details-title">
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Coordonnées</p>
                    <h2 id="contact-details-title" class="mt-3 text-2xl font-semibold tracking-tight">Le Barreau à votre écoute</h2>
                    <div class="mt-8 space-y-6">
                        {% if contactSettings.address %}
                            <div class="flex gap-3"><twig:ux:icon name="lucide:map-pin" class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true"/><div><p class="text-sm font-semibold">Adresse</p><p class="mt-1 whitespace-pre-line text-sm leading-6 text-muted-foreground">{{ contactSettings.address }}</p></div></div>
                        {% endif %}
                        {% if contactSettings.phone %}
                            <div class="flex gap-3"><twig:ux:icon name="lucide:phone" class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true"/><div><p class="text-sm font-semibold">Téléphone</p><div class="mt-1 flex flex-col items-start gap-1">{% for phoneNumber in contactSettings.phone|split(' / ') %}<a href="tel:{{ phoneNumber|replace({' ': '', '.': '', '-': ''}) }}" class="text-sm text-muted-foreground transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ phoneNumber }}</a>{% endfor %}</div></div></div>
                        {% endif %}
                        {% if contactSettings.email %}
                            <div class="flex gap-3"><twig:ux:icon name="lucide:mail" class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true"/><div><p class="text-sm font-semibold">Email</p><a href="mailto:{{ contactSettings.email }}" class="mt-1 inline-block break-all text-sm text-muted-foreground transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ contactSettings.email }}</a></div></div>
                        {% endif %}
                        {% if contactSettings.hours %}
                            <div class="flex gap-3"><twig:ux:icon name="lucide:clock-3" class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true"/><div><p class="text-sm font-semibold">Horaires</p><p class="mt-1 whitespace-pre-line text-sm leading-6 text-muted-foreground">{{ contactSettings.hours }}</p></div></div>
                        {% endif %}
                        {% if not contactSettings.address and not contactSettings.phone and not contactSettings.email and not contactSettings.hours %}
                            <p class="text-sm leading-6 text-muted-foreground">Les coordonnées seront bientôt publiées ici.</p>
                        {% endif %}
                    </div>
                </aside>

                <section class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8" aria-labelledby="contact-form-title">
                    <div class="max-w-2xl">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Message</p>
                        <h2 id="contact-form-title" class="mt-3 text-2xl font-semibold tracking-tight">Parlons de votre demande</h2>
                        <p class="mt-2 text-sm leading-6 text-muted-foreground">Les champs marqués d’un astérisque sont obligatoires.</p>
                    </div>

                    {% set contactInputClass = 'flex min-h-11 w-full rounded-xl border border-input bg-background px-3 text-sm text-foreground shadow-xs outline-none transition placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30' %}
                    {% set contactLabelClass = 'text-sm font-medium text-foreground' %}
                    {{ form_start(form, {attr: {class: 'mt-8 space-y-6', novalidate: true}}) }}
                        <div class="grid gap-5 sm:grid-cols-2">
                            {{ form_row(form.fullName, {row_attr: {class: 'space-y-2'}, label_attr: {class: contactLabelClass}, attr: {class: contactInputClass}}) }}
                            {{ form_row(form.email, {row_attr: {class: 'space-y-2'}, label_attr: {class: contactLabelClass}, attr: {class: contactInputClass}}) }}
                            {{ form_row(form.phone, {row_attr: {class: 'space-y-2'}, label_attr: {class: contactLabelClass}, attr: {class: contactInputClass}}) }}
                            {{ form_row(form.subject, {row_attr: {class: 'space-y-2'}, label_attr: {class: contactLabelClass}, attr: {class: contactInputClass}}) }}
                        </div>
                        {{ form_row(form.message, {row_attr: {class: 'space-y-2'}, label_attr: {class: contactLabelClass}, attr: {class: contactInputClass ~ ' min-h-36 py-3'}}) }}
                        <div class="rounded-xl border border-border bg-muted/30 p-4">{{ form_row(form.consent, {row_attr: {class: 'flex items-start gap-3'}, label_attr: {class: 'text-sm leading-6 text-muted-foreground'}, attr: {class: 'mt-1 size-4 shrink-0 rounded border-input accent-primary'}}) }}</div>
                        {{ form_widget(form.antispam) }}
                        <button type="submit" class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-primary px-5 text-sm font-semibold text-primary-foreground shadow-sm transition hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                            Envoyer le message
                            <twig:ux:icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true"/>
                        </button>
                    {{ form_end(form) }}
                </section>
            </div>
        </div>
    </main>
{% endblock %}
