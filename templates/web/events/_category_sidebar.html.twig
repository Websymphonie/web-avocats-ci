<aside class="h-fit lg:sticky lg:top-6" aria-label="Navigation des événements">
    <div class="border border-border bg-card p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Explorer</p>
        <h2 class="mt-2 text-xl font-semibold tracking-[-0.03em] text-card-foreground">Catégories</h2>
        <div data-controller="list-filter">
            {% include 'web/components/_filterable_list_search.html.twig' with {
                searchId: 'event-category-search',
                placeholder: 'Filtrer les catégories',
                clearLabel: 'Effacer le filtre des catégories'
            } only %}
            <nav class="mt-3" aria-label="Catégories d’événements">
            <ul class="max-h-[28rem] space-y-1 overflow-y-auto overscroll-contain pr-1">
                <li>
                    <a href="{{ path('web_events_list') }}" class="flex items-center justify-between border-l-2 px-3 py-2.5 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{ selectedCategory is null ? 'border-primary bg-primary/10 font-semibold text-primary' : 'border-transparent text-muted-foreground hover:border-border hover:bg-muted hover:text-foreground' }}" {% if selectedCategory is null %}aria-current="page"{% endif %}>
                        <span>Tous les événements</span>
                    </a>
                </li>
                {% for category in categories %}
                    <li data-list-filter-target="item" data-list-filter-name="{{ category.name }}">
                        <a href="{{ path('web_events_list', {categorie: category.slug}) }}" class="flex items-center justify-between border-l-2 px-3 py-2.5 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{ selectedCategory and selectedCategory.id == category.id ? 'border-primary bg-primary/10 font-semibold text-primary' : 'border-transparent text-muted-foreground hover:border-border hover:bg-muted hover:text-foreground' }}" {% if selectedCategory and selectedCategory.id == category.id %}aria-current="page"{% endif %}>
                            <span>{{ category.name }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
                <p hidden data-list-filter-target="empty" class="hidden px-3 py-4 text-sm text-muted-foreground">Aucune catégorie ne correspond à cette recherche.</p>
            </nav>
        </div>
    </div>
    <div class="mt-6 border-l-2 border-primary bg-card px-5 py-4">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Agenda du Barreau</p>
        <p class="mt-2 text-sm leading-6 text-card-foreground">Retrouvez les rendez-vous qui font vivre la profession.</p>
    </div>
</aside>
