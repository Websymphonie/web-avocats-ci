{% extends 'layouts/web.html.twig' %}

{% block title %}Événements{% endblock %}

{% block body %}
    {% set leadEvent = upcomingEvents|first %}
    {% if leadEvent is null %}{% set leadEvent = pastEvents|first %}{% endif %}
    {% set heroImage = leadEvent and leadEvent.coverMediaId ? mediaUrls[leadEvent.coverMediaId]|default(default_image_url) : default_image_url %}
    {% set secondaryUpcoming = upcomingEvents|slice(1, 50) %}

    <main class="min-h-[calc(100svh-9rem)] bg-muted/20">
        <section class="relative isolate overflow-hidden bg-[#10233f] text-white" aria-labelledby="events-page-title">
            <img src="{{ heroImage }}" alt="" class="absolute inset-0 -z-20 size-full object-cover opacity-35" aria-hidden="true">
            <div class="absolute inset-0 -z-10 bg-[linear-gradient(115deg,rgba(16,35,63,0.98)_0%,rgba(16,35,63,0.86)_42%,rgba(16,35,63,0.54)_100%)]"></div>
            <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14">
                <div class="max-w-4xl">
                    <nav class="flex flex-wrap items-center gap-2 text-sm text-white/65" aria-label="Fil d’Ariane">
                        <a href="{{ path('app_home') }}" class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Accueil</a>
                        <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true"/>
                        <span class="text-white" aria-current="page">Événements</span>
                    </nav>
                    <p class="mt-6 text-xs font-semibold uppercase tracking-[0.26em] text-[#f1d59b]">Le Barreau de Côte d'Ivoire</p>
                    <h1 id="events-page-title" class="mt-3 max-w-3xl text-4xl font-semibold leading-[0.98] tracking-[-0.055em] sm:text-5xl lg:text-6xl">Événements</h1>
                    <p class="mt-4 max-w-2xl text-sm leading-6 text-white/75 sm:text-base">Les rendez-vous, rencontres et temps forts de la profession d’avocat.</p>
                </div>
            </div>
        </section>

        <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16">
            <div class="grid gap-10 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-14 xl:grid-cols-[19rem_minmax(0,1fr)]">
                {% include 'web/events/_category_sidebar.html.twig' with {categories: categories, selectedCategory: selectedCategory} only %}

                <section aria-labelledby="events-results-title">
                    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border pb-5">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Agenda du Barreau</p>
                            <h2 id="events-results-title" class="mt-2 text-3xl font-semibold tracking-[-0.04em] text-foreground sm:text-4xl">Les prochains rendez-vous</h2>
                        </div>
                        <p class="text-sm text-muted-foreground">{{ events.totalItemCount }} événement{{ events.totalItemCount > 1 ? 's' : '' }}</p>
                    </div>

                    {% if leadEvent %}
                        {% set leadIsUpcoming = leadEvent in upcomingEvents %}
                        <article class="group mt-7 overflow-hidden rounded-2xl border border-border bg-card shadow-sm sm:mt-8">
                            <div class="grid gap-7 md:grid-cols-[minmax(0,1.08fr)_minmax(17rem,0.92fr)] md:items-stretch md:gap-9">
                                <a href="{{ path('web_events_detail', {slug: leadEvent.slug}) }}" class="relative block aspect-[16/10] overflow-hidden bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset md:h-full md:min-h-[28rem] md:aspect-auto" aria-label="Voir l’événement : {{ leadEvent.title }}">
                                    <img src="{{ leadEvent.coverMediaId ? mediaUrls[leadEvent.coverMediaId]|default(default_image_url) : default_image_url }}" alt="Couverture de {{ leadEvent.title }}" class="size-full object-cover transition duration-500 group-hover:scale-[1.025]">
                                    <span class="absolute left-4 top-4 inline-flex items-center gap-2 bg-[#d8b878] px-3 py-1.5 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#10233f] shadow-sm">{{ leadIsUpcoming ? 'À venir' : 'Dernier événement' }}</span>
                                </a>
                                <div class="border-t-2 border-primary px-6 py-7 sm:px-8 sm:py-8 md:border-l-2 md:border-t-0 md:py-9 lg:px-10">
                                    <div class="flex flex-wrap items-start gap-4">
                                        <div class="min-w-[4.6rem] border-r border-border pr-4 text-center">
                                            <p class="text-3xl font-semibold leading-none tracking-[-0.05em] text-primary">{{ leadEvent.startsAt|date('d') }}</p>
                                            <p class="mt-1 text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground">{{ leadEvent.startsAt|format_datetime(pattern='MMM')|upper }}</p>
                                            <p class="mt-1 text-xs text-muted-foreground">{{ leadEvent.startsAt|date('Y') }}</p>
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium uppercase tracking-[0.13em] text-muted-foreground">
                                                <span>{{ leadEvent.categories|first ? leadEvent.categories|first.name : 'Événement' }}</span>
                                                <span class="h-px w-4 bg-border" aria-hidden="true"></span>
                                                <span class="text-primary">{{ leadEvent.format.label }}</span>
                                            </div>
                                            <h3 class="mt-4 text-3xl font-semibold leading-[1.05] tracking-[-0.04em] text-card-foreground sm:text-4xl"><a href="{{ path('web_events_detail', {slug: leadEvent.slug}) }}" class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ leadEvent.title }}</a></h3>
                                        </div>
                                    </div>
                                    {% if leadEvent.excerpt %}<p class="mt-5 text-base leading-7 text-muted-foreground">{{ leadEvent.excerpt }}</p>{% endif %}
                                    <div class="mt-6 space-y-2 text-sm text-muted-foreground">
                                        <p class="flex items-start gap-2"><twig:ux:icon name="lucide:clock-3" class="mt-0.5 size-4 shrink-0 text-primary" aria-hidden="true"/>{{ leadEvent.startsAt|format_datetime(pattern='d MMMM Y à HH:mm') }}{% if leadEvent.endsAt %} — {{ leadEvent.endsAt|format_datetime(pattern='HH:mm') }}{% endif %}</p>
                                        {% if leadEvent.venueName %}<p class="flex items-start gap-2"><twig:ux:icon name="lucide:map-pin" class="mt-0.5 size-4 shrink-0 text-primary" aria-hidden="true"/>{{ leadEvent.venueName }}{% if leadEvent.address %}, {{ leadEvent.address }}{% endif %}</p>{% endif %}
                                    </div>
                                    <a href="{{ path('web_events_detail', {slug: leadEvent.slug}) }}" class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primary/75 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Voir l’événement <twig:ux:icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true"/></a>
                                </div>
                            </div>
                        </article>
                    {% endif %}

                    {% if secondaryUpcoming is not empty %}
                        <section class="mt-12" aria-labelledby="upcoming-events-title">
                            <div class="flex items-end justify-between gap-4 border-b border-border pb-4">
                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">À l’agenda</p>
                                    <h3 id="upcoming-events-title" class="mt-2 text-2xl font-semibold tracking-[-0.035em] text-foreground">À venir</h3>
                                </div>
                            </div>
                            <div class="mt-5 space-y-4">
                                {% for event in secondaryUpcoming %}
                                    <article class="group rounded-xl border border-border bg-card p-4 shadow-sm transition-shadow hover:shadow-md sm:p-5">
                                        <div class="grid gap-5 sm:grid-cols-[5.4rem_minmax(0,1fr)] sm:items-center sm:gap-7">
                                            <a href="{{ path('web_events_detail', {slug: event.slug}) }}" class="flex aspect-square flex-col items-center justify-center border border-primary/30 bg-primary/5 text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label="Voir l’événement : {{ event.title }}">
                                                <span class="text-2xl font-semibold leading-none tracking-[-0.05em] text-primary">{{ event.startsAt|date('d') }}</span>
                                                <span class="mt-1 text-[0.65rem] font-bold uppercase tracking-[0.14em] text-muted-foreground">{{ event.startsAt|format_datetime(pattern='MMM')|upper }}</span>
                                            </a>
                                            <div class="min-w-0">
                                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium uppercase tracking-[0.13em] text-muted-foreground">
                                                    <span class="text-primary">{{ event.format.label }}</span>
                                                    {% if event.venueName %}<span class="h-px w-4 bg-border" aria-hidden="true"></span><span>{{ event.venueName }}</span>{% endif %}
                                                </div>
                                                <h4 class="mt-2 text-2xl font-semibold leading-tight tracking-[-0.035em] text-card-foreground"><a href="{{ path('web_events_detail', {slug: event.slug}) }}" class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ event.title }}</a></h4>
                                                <p class="mt-2 text-sm text-muted-foreground">{{ event.startsAt|format_datetime(pattern='d MMMM Y à HH:mm') }}</p>
                                            </div>
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                    {% if pastEvents is not empty %}
                        <section class="mt-12" aria-labelledby="past-events-title">
                            <div class="flex items-end justify-between gap-4 border-b border-border pb-4">
                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Les archives</p>
                                    <h3 id="past-events-title" class="mt-2 text-2xl font-semibold tracking-[-0.035em] text-foreground">Événements passés</h3>
                                </div>
                            </div>
                            <div class="mt-5 space-y-4">
                                {% for event in pastEvents %}
                                    <article class="group rounded-xl border border-border bg-card p-4 shadow-sm transition-shadow hover:shadow-md sm:p-5">
                                        <div class="grid gap-5 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-center sm:gap-7 lg:grid-cols-[15rem_minmax(0,1fr)]">
                                            <a href="{{ path('web_events_detail', {slug: event.slug}) }}" class="block overflow-hidden bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset" aria-label="Voir l’événement : {{ event.title }}">
                                                <img src="{{ event.coverMediaId ? mediaUrls[event.coverMediaId]|default(default_image_url) : default_image_url }}" alt="Couverture de {{ event.title }}" class="aspect-[16/10] w-full object-cover grayscale-[0.15] transition duration-500 group-hover:scale-[1.025]">
                                            </a>
                                            <div class="min-w-0">
                                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium uppercase tracking-[0.13em] text-muted-foreground">
                                                    <span>{{ event.format.label }}</span><span class="h-px w-4 bg-border" aria-hidden="true"></span><time datetime="{{ event.startsAt|date('Y-m-d') }}">{{ event.startsAt|format_datetime(pattern='d MMMM Y') }}</time>
                                                </div>
                                                <h4 class="mt-2 text-2xl font-semibold leading-tight tracking-[-0.035em] text-card-foreground"><a href="{{ path('web_events_detail', {slug: event.slug}) }}" class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ event.title }}</a></h4>
                                                {% if event.excerpt %}<p class="mt-2 line-clamp-2 max-w-2xl text-sm leading-6 text-muted-foreground">{{ event.excerpt }}</p>{% endif %}
                                            </div>
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>
                        </section>
                    {% elseif not leadEvent %}
                        <div class="border-b border-border px-6 py-20 text-center" aria-labelledby="events-empty-title">
                            <twig:ux:icon name="lucide:calendar-days" class="mx-auto size-10 text-muted-foreground" aria-hidden="true"/>
                            <h3 id="events-empty-title" class="mt-4 text-lg font-semibold text-foreground">Aucun événement publié</h3>
                            <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted-foreground">Les prochains rendez-vous du Barreau apparaîtront ici.</p>
                        </div>
                    {% endif %}

                    <div class="mt-8 border-t border-border pt-1">
                        {% include 'shared/views/_list_pagination.html.twig' with {pager: events, route: 'web_events_list'} only %}
                    </div>
                </section>
            </div>
        </div>
    </main>
{% endblock %}
