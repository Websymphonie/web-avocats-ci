{% set allParams = {} %}
{% if filters.name %}{% set allParams = allParams|merge({name: filters.name}) %}{% endif %}
{% if filters.location %}{% set allParams = allParams|merge({location: filters.location}) %}{% endif %}

<div data-controller="list-filter">
    {% include 'web/components/_filterable_list_search.html.twig' with {
        searchId: searchId,
        placeholder: 'Rechercher un cabinet',
        clearLabel: 'Effacer la recherche de cabinet'
    } only %}

    <nav class="mt-3" aria-label="Filtrer par cabinet">
        <ul class="max-h-[28rem] space-y-1 overflow-y-auto overscroll-contain pr-1">
            <li>
                <a href="{{ path('web_lawyer_directory_list', allParams) }}"
                   {% if filters.cabinet == '' %}aria-current="page"{% endif %}
                   class="flex min-h-10 items-center rounded-lg border-l-2 px-3 py-2 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{ filters.cabinet == '' ? 'border-primary bg-primary/5 font-semibold text-primary' : 'border-transparent text-foreground hover:bg-muted' }}">
                    Tous les avocats
                </a>
            </li>
            {% for cabinet in cabinetOptions %}
                {% set isActive = filters.cabinet == cabinet.publicUuid %}
                {% set cabinetParams = allParams|merge({cabinet: cabinet.publicUuid}) %}
                <li data-list-filter-target="item" data-list-filter-name="{{ cabinet.name }}">
                    <a href="{{ path('web_lawyer_directory_list', cabinetParams) }}"
                       {% if isActive %}aria-current="page"{% endif %}
                       class="flex min-h-10 items-center justify-between gap-2 rounded-lg border-l-2 px-3 py-2 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{ isActive ? 'border-primary bg-primary/5 font-semibold text-primary' : 'border-transparent text-foreground hover:bg-muted' }}">
                        <span class="min-w-0 break-words">{{ cabinet.name }}</span>
                        {% if isActive %}<twig:ux:icon name="lucide:check" class="size-4 shrink-0" aria-hidden="true"/>{% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
        <p hidden data-list-filter-target="empty" class="hidden px-3 py-4 text-sm text-muted-foreground">Aucun cabinet ne correspond à cette recherche.</p>
    </nav>
</div>
