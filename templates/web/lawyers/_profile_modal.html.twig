<div data-lawyer-profile-fragment data-lawyer-name="{{ lawyer.name }}">
    <div class="flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-center">
        {% if portraitUrl %}
            <img src="{{ portraitUrl }}" alt="Portrait professionnel de {{ lawyer.name }}" class="size-20 shrink-0 rounded-full border border-border object-cover sm:size-24">
        {% else %}
            <span class="inline-flex size-20 shrink-0 items-center justify-center rounded-full border border-primary/20 bg-primary/5 text-2xl font-semibold uppercase text-primary sm:size-24" aria-hidden="true">{{ lawyer.name|first }}</span>
        {% endif %}
        {% if lawyer.barNumber %}<p class="text-sm text-muted-foreground">Numéro au Barreau : <span class="font-medium text-foreground">{{ lawyer.barNumber }}</span></p>{% endif %}
    </div>

    {% include 'web/lawyers/_profile_details.html.twig' with {lawyer: lawyer, professionalPhoneHref: professionalPhoneHref} only %}
</div>
