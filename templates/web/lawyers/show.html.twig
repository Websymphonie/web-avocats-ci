{% extends 'layouts/web.html.twig' %}

{% block title %}{{ lawyer.name }} — Annuaire des avocats{% endblock %}

{% block body %}
    <main class="min-h-[calc(100svh-9rem)] bg-muted/20">
        <section class="relative isolate overflow-hidden bg-[#10233f] text-white" aria-labelledby="lawyer-title">
            <div class="absolute -right-24 -top-32 size-[28rem] rounded-full border border-white/10" aria-hidden="true"></div>
            <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
                <nav class="flex flex-wrap items-center gap-2 text-sm text-white/65" aria-label="Fil d’Ariane">
                    <a href="{{ path('app_home') }}" class="hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Accueil</a>
                    <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
                    <a href="{{ path('web_lawyer_directory_list') }}" class="hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Trouver un avocat</a>
                    <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
                    <span class="max-w-full break-words text-white" aria-current="page">{{ lawyer.name }}</span>
                </nav>
                <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-center">
                    {% if portraitUrl %}
                        <img src="{{ portraitUrl }}" alt="Portrait professionnel de {{ lawyer.name }}" class="size-24 shrink-0 rounded-full border-2 border-white/20 object-cover sm:size-28">
                    {% else %}
                        <span class="inline-flex size-24 shrink-0 items-center justify-center rounded-full border-2 border-white/20 bg-white/10 text-3xl font-semibold uppercase text-[#f1d59b] sm:size-28" aria-hidden="true">{{ lawyer.name|first }}</span>
                    {% endif %}
                    <div class="min-w-0">
                        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#f1d59b]">Annuaire professionnel</p>
                        <h1 id="lawyer-title" class="mt-2 break-words text-3xl font-semibold leading-tight tracking-[-0.045em] sm:text-4xl lg:text-5xl">{{ lawyer.name }}</h1>
                        {% if lawyer.barNumber %}<p class="mt-3 text-sm text-white/75">Numéro au Barreau : {{ lawyer.barNumber }}</p>{% endif %}
                    </div>
                </div>
            </div>
        </section>

        <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 sm:py-10 {{ (lawyer.professionalPhone or lawyer.professionalEmail) ? 'lg:grid-cols-[minmax(0,1fr)_19rem]' : '' }} lg:px-8 lg:py-12">
            <a id="directory-back" href="{{ path('web_lawyer_directory_list') }}" class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-primary underline decoration-transparent underline-offset-4 hover:decoration-current focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring lg:col-span-2"><twig:ux:icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />Retour à l’annuaire</a>
            <article class="min-w-0 space-y-8">
                {% if lawyer.specializationSummary %}
                    <section class="border-b border-border pb-7" aria-labelledby="lawyer-specialties-title">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Domaines d’intervention</p>
                        <h2 id="lawyer-specialties-title" class="mt-3 text-xl font-semibold tracking-[-0.03em] text-foreground">{{ lawyer.specializationSummary }}</h2>
                    </section>
                {% endif %}
                {% if lawyer.biography %}
                    <section aria-labelledby="lawyer-biography-title">
                        <h2 id="lawyer-biography-title" class="text-2xl font-semibold tracking-[-0.035em] text-foreground">Présentation</h2>
                        <p class="mt-4 whitespace-pre-line break-words text-base leading-7 text-muted-foreground">{{ lawyer.biography }}</p>
                    </section>
                {% endif %}
                {% if lawyer.cabinetName %}
                    <section class="border-t border-border pt-7" aria-labelledby="lawyer-cabinet-title">
                        <h2 id="lawyer-cabinet-title" class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Cabinet</h2>
                        {% if lawyer.publicCabinetUuid %}
                            <a href="{{ path('web_cabinet_directory_profile', {uuid: lawyer.publicCabinetUuid}) }}" class="mt-3 inline-flex flex-wrap items-center gap-2 text-lg font-semibold text-foreground underline decoration-border underline-offset-4 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ lawyer.cabinetName }}<twig:ux:icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" /></a>
                            {% if lawyer.publicCabinetCity %}<p class="mt-1 text-sm text-muted-foreground">{{ lawyer.publicCabinetCity }}</p>{% endif %}
                        {% else %}
                            <p class="mt-3 text-lg font-semibold text-foreground">{{ lawyer.cabinetName }}</p>
                        {% endif %}
                    </section>
                {% endif %}
            </article>

            {% if lawyer.professionalPhone or lawyer.professionalEmail %}
                <aside class="h-fit rounded-xl border border-border bg-card p-5 sm:p-6" aria-labelledby="lawyer-contact-title">
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Contact professionnel</p>
                    <h2 id="lawyer-contact-title" class="mt-2 text-xl font-semibold text-card-foreground">Coordonnées</h2>
                    <dl class="mt-5 space-y-4 text-sm">
                        {% if lawyer.professionalEmail %}<div><dt class="text-muted-foreground">Email professionnel</dt><dd class="mt-1 break-all font-medium text-card-foreground"><a class="underline decoration-border underline-offset-4 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" href="mailto:{{ lawyer.professionalEmail }}">{{ lawyer.professionalEmail }}</a></dd></div>{% endif %}
                        {% if lawyer.professionalPhone %}<div><dt class="text-muted-foreground">Téléphone professionnel</dt><dd class="mt-1 break-words font-medium text-card-foreground">{% if professionalPhoneHref %}<a class="underline decoration-border underline-offset-4 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" href="{{ professionalPhoneHref }}">{{ lawyer.professionalPhone }}</a>{% else %}{{ lawyer.professionalPhone }}{% endif %}</dd></div>{% endif %}
                    </dl>
                </aside>
            {% endif %}
        </div>
    </main>
{% endblock %}
