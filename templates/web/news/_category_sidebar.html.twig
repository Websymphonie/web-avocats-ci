<aside class="h-fit lg:sticky lg:top-6" aria-label="Navigation des actualités">
    <div class="border border-border bg-card p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Explorer</p>
        <h2 class="mt-2 text-xl font-semibold tracking-[-0.025em] text-card-foreground">Catégories</h2>
        <nav class="mt-5" aria-label="Filtrer les actualités par catégorie">
            <ul class="divide-y divide-border border-y border-border">
                <li>
                    <a href="{{ path('web_news_list') }}" class="group flex items-center justify-between gap-3 py-3 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{ selectedCategory is null ? 'font-semibold text-primary' : 'text-muted-foreground hover:text-foreground' }}" {% if selectedCategory is null %}aria-current="page"{% endif %}>
                        <span>Toutes les actualités</span>
                        <twig:ux:icon name="lucide:chevron-right" class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"/>
                    </a>
                </li>
                {% for category in categories %}
                    <li>
                        <a href="{{ path('web_news_list', {categorie: category.slug}) }}" class="group flex items-center justify-between gap-3 py-3 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{ selectedCategory and selectedCategory.id == category.id ? 'font-semibold text-primary' : 'text-muted-foreground hover:text-foreground' }}" {% if selectedCategory and selectedCategory.id == category.id %}aria-current="page"{% endif %}>
                            <span>{{ category.name }}</span>
                            <twig:ux:icon name="lucide:chevron-right" class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"/>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </div>

    <div class="mt-6 border-l-2 border-primary bg-card px-5 py-5 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Le regard du Barreau</p>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Retrouvez les repères qui font vivre la profession, les initiatives de l’Ordre et les évolutions du droit.</p>
    </div>
</aside>
