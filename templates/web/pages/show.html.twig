{% extends 'layouts/web.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}

{% block body %}
    <main class="min-h-[calc(100svh-9rem)] bg-muted/20">
        <section class="relative isolate overflow-hidden bg-[#10233f] text-white" aria-labelledby="page-title">
            {% if coverUrl %}
                <img src="{{ coverUrl }}" alt="" class="absolute inset-0 -z-20 size-full object-cover opacity-25" aria-hidden="true">
            {% endif %}
            <div class="absolute inset-0 -z-10 bg-[linear-gradient(115deg,rgba(16,35,63,0.98)_0%,rgba(16,35,63,0.9)_52%,rgba(16,35,63,0.7)_100%)]"></div>
            <div class="mx-auto max-w-7xl px-4 py-9 sm:px-6 sm:py-11 lg:px-8 lg:py-12">
                <nav class="flex flex-wrap items-center gap-2 text-sm text-white/65" aria-label="Fil d’Ariane">
                    <a href="{{ path('app_home') }}" class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Accueil</a>
                    <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true"/>
                    {% if page.group and page.group.value == 'BAR' %}
                        <a href="{{ path('web_barreau_index') }}" class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Le Barreau</a>
                    {% elseif page.group and page.group.value == 'CARPA' %}
                        <a href="{{ path('web_carpa_index') }}" class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">La CARPA</a>
                    {% else %}
                        <span>Informations</span>
                    {% endif %}
                    <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true"/>
                    <span class="max-w-[18rem] truncate text-white" aria-current="page">{{ page.title }}</span>
                </nav>
                <div class="mt-7 max-w-4xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.26em] text-[#f1d59b]">{{ page.group and page.group.value == 'CARPA' ? 'La Caisse Autonome de Règlement Pécuniaire des Avocats' : "Le Barreau de Côte d'Ivoire" }}</p>
                    <h1 id="page-title" class="mt-3 text-4xl font-semibold leading-[1.04] tracking-[-0.05em] sm:text-5xl lg:text-6xl">{{ page.title }}</h1>
                    {% if page.publishedAt %}
                        <p class="mt-5 text-sm text-white/65">Publié le {{ page.publishedAt|format_datetime(pattern='d MMMM Y') }}</p>
                    {% endif %}
                </div>
            </div>
        </section>

        <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16">
            {% set hasContextualSidebar = contextualPages is not empty %}
            <div class="grid gap-10 {{ hasContextualSidebar ? 'lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-14 xl:grid-cols-[19rem_minmax(0,1fr)]' }}">
                {% if hasContextualSidebar %}
                    {% include 'web/pages/_contextual_sidebar.html.twig' with {pages: contextualPages, currentPage: page} only %}
                {% endif %}

                <article class="{{ hasContextualSidebar ? 'max-w-4xl' : 'mx-auto max-w-4xl' }}" aria-labelledby="page-title">
                {% if coverUrl %}
                    <figure class="overflow-hidden rounded-2xl bg-muted">
                        <img src="{{ coverUrl }}" alt="Couverture de {{ page.title }}" class="aspect-[2/1] w-full object-cover">
                    </figure>
                {% endif %}

                {% if councilMembers is not empty %}
                    <section class="mt-10 sm:mt-12" aria-labelledby="council-title">
                        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border pb-5">
                            <div><p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">Composition actuelle</p><h2 id="council-title" class="mt-2 text-2xl font-semibold tracking-[-0.03em] sm:text-3xl">Le Conseil de l’Ordre</h2></div>
                        </div>
                        <div class="mt-7 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
                            {% for member in councilMembers %}
                                {% set memberPortraitUrl = councilPortraitUrls[member.portraitMediaId]|default(null) %}
                                <article class="overflow-hidden rounded-2xl border border-border bg-card">
                                    {% if memberPortraitUrl %}<img src="{{ memberPortraitUrl }}" alt="Portrait de {{ member.fullName }}" class="aspect-[4/5] w-full object-cover">{% else %}<div class="flex aspect-[4/5] items-center justify-center bg-muted text-muted-foreground" aria-hidden="true"><twig:ux:icon name="lucide:user-round" class="size-14 opacity-40"/></div>{% endif %}
                                    <div class="p-5"><h3 class="text-lg font-semibold tracking-[-0.02em]">{{ member.fullName }}</h3><p class="mt-1 text-sm leading-6 text-muted-foreground">{{ member.function }}</p></div>
                                </article>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                {% if mandate %}
                    <section class="mt-10 overflow-hidden rounded-2xl border border-border bg-card sm:mt-12" aria-labelledby="batonnier-profile-title">
                        <div class="grid md:grid-cols-[11rem_minmax(0,1fr)]">
                            {% if portraitUrl %}
                                <img src="{{ portraitUrl }}" alt="Portrait de {{ mandate.fullName }}" class="h-64 w-full object-cover md:h-full md:min-h-64">
                            {% endif %}
                            <div class="p-6 sm:p-8">
                                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">Le Bâtonnier</p>
                                <h2 id="batonnier-profile-title" class="mt-3 text-2xl font-semibold tracking-[-0.03em]">{{ mandate.fullName }}</h2>
                                <p class="mt-2 text-sm text-muted-foreground">Mandat depuis {{ mandate.mandateStartedAt|date('Y') }} · En cours</p>
                                {% if mandate.summary %}<p class="mt-5 whitespace-pre-line text-base leading-7 text-muted-foreground">{{ mandate.summary }}</p>{% endif %}
                            </div>
                        </div>
                    </section>
                {% endif %}

                <div class="rich-content mt-10 max-w-3xl text-base leading-8 text-foreground sm:mt-12 sm:text-lg">
                    {{ safeContent|raw }}
                </div>

                {% if page.slug == 'fonds-de-solidarite' %}
                    <section class="mt-10 rounded-2xl border border-border bg-card p-6 sm:mt-12 sm:p-8" aria-labelledby="fund-resources-title">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Ressources réservées aux avocats</p>
                        <h2 id="fund-resources-title" class="mt-2 text-xl font-semibold tracking-[-0.02em] text-foreground sm:text-2xl">Consultez les ressources disponibles dans votre espace professionnel</h2>
                        <a href="{{ path('member_fund_resources_index') }}" class="mt-5 inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                            Accéder aux ressources
                            <twig:ux:icon name="lucide:arrow-right" class="size-4" aria-hidden="true"/>
                        </a>
                    </section>
                {% endif %}

                <div class="mt-12 border-t border-border pt-6">
                    <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primary/75 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                        <twig:ux:icon name="lucide:arrow-left" class="size-4" aria-hidden="true"/>
                        Retour à l'accueil
                    </a>
                </div>
                </article>
            </div>
        </div>
    </main>
{% endblock %}
