<aside class="h-fit lg:sticky lg:top-6" aria-label="Navigation des formations">
    <div class="border border-border bg-card p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Explorer</p>
        <h2 class="mt-2 text-xl font-semibold tracking-[-0.03em] text-card-foreground">Catégories</h2>
        <nav class="mt-5" aria-label="Catégories de formations">
            <ul class="space-y-1">
                <li>
                    <a href="{{ path('web_trainings_list') }}" class="flex items-center border-l-2 px-3 py-2.5 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{ selectedCategory is null ? 'border-primary bg-primary/10 font-semibold text-primary' : 'border-transparent text-muted-foreground hover:border-border hover:bg-muted hover:text-foreground' }}" {% if selectedCategory is null %}aria-current="page"{% endif %}>
                        Toutes les formations
                    </a>
                </li>
                {% for category in categories %}
                    <li>
                        <a href="{{ path('web_trainings_list', {categorie: category.slug}) }}" class="flex items-center border-l-2 px-3 py-2.5 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{ selectedCategory and selectedCategory.id == category.id ? 'border-primary bg-primary/10 font-semibold text-primary' : 'border-transparent text-muted-foreground hover:border-border hover:bg-muted hover:text-foreground' }}" {% if selectedCategory and selectedCategory.id == category.id %}aria-current="page"{% endif %}>
                            {{ category.name }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </div>
    <div class="mt-6 border-l-2 border-primary bg-card px-5 py-4">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Se former</p>
        <p class="mt-2 text-sm leading-6 text-card-foreground">Des parcours et des rendez-vous conçus pour accompagner la pratique professionnelle.</p>
    </div>
</aside>
