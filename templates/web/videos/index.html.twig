{% extends 'layouts/web.html.twig' %}

{% block title %}Vidéos{% endblock %}

{% block body %}
    {% set featured = videos.items|first %}
    {% set secondary = videos.items|slice(1) %}

    <main class="min-h-[calc(100svh-9rem)] bg-muted/20">
        <section class="relative isolate overflow-hidden bg-[#10233f] text-white" aria-labelledby="videos-page-title">
            <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_80%_18%,rgba(216,184,120,0.2),transparent_32%),linear-gradient(120deg,#10233f_0%,#18375e_100%)]"></div>
            <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14">
                <nav class="flex flex-wrap items-center gap-2 text-sm text-white/65" aria-label="Fil d’Ariane">
                    <a href="{{ path('app_home') }}" class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f1d59b]">Accueil</a>
                    <twig:ux:icon name="lucide:chevron-right" class="size-4" aria-hidden="true"/>
                    <span class="text-white" aria-current="page">Vidéos</span>
                </nav>
                <div class="mt-6 max-w-3xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.26em] text-[#f1d59b]">Regards du Barreau</p>
                    <h1 id="videos-page-title" class="mt-3 text-4xl font-semibold leading-[0.98] tracking-[-0.055em] sm:text-5xl lg:text-6xl">Vidéos</h1>
                    <p class="mt-4 max-w-2xl text-sm leading-6 text-white/75 sm:text-base">Entretiens, éclairages et temps forts en vidéo pour mieux comprendre la profession et ses évolutions.</p>
                </div>
            </div>
        </section>

        <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16">
            <div class="grid gap-10 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-14 xl:grid-cols-[19rem_minmax(0,1fr)]">
                {% include 'web/videos/_category_sidebar.html.twig' with {categories: categories, selectedCategory: selectedCategory} only %}

                <section aria-labelledby="video-results-title">
                    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border pb-5">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Vidéothèque</p>
                            <h2 id="video-results-title" class="mt-2 text-3xl font-semibold tracking-[-0.04em] text-foreground sm:text-4xl">{{ selectedCategory ? selectedCategory.name : 'Dernières vidéos' }}</h2>
                        </div>
                        <p class="text-sm text-muted-foreground">{{ videos.totalItemCount }} vidéo{{ videos.totalItemCount > 1 ? 's' : '' }}</p>
                    </div>

                    {% if featured %}
                        {% set featuredThumbnail = thumbnailUrls[featured.id]|default(default_image_url) %}
                        <article class="group mt-7 overflow-hidden rounded-2xl border border-border bg-card shadow-sm sm:mt-8">
                            <div class="grid md:grid-cols-[minmax(0,1.55fr)_minmax(17rem,0.95fr)]">
                                <a href="{{ path('web_videos_detail', {slug: featured.slug}) }}" class="relative block aspect-video overflow-hidden bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset md:aspect-auto md:min-h-[24rem]" aria-label="Regarder la vidéo à la une : {{ featured.title }}">
                                    <img src="{{ featuredThumbnail }}" alt="Miniature de {{ featured.title }}" class="size-full object-cover transition duration-500 group-hover:scale-[1.025]">
                                    <span class="absolute inset-0 flex items-center justify-center bg-[#10233f]/10 transition duration-500 group-hover:bg-[#10233f]/25">
                                        <span class="flex size-16 items-center justify-center rounded-full bg-[#d8b878] text-[#10233f] shadow-lg shadow-black/20 transition duration-300 group-hover:scale-105" aria-hidden="true"><twig:ux:icon name="lucide:play" class="ml-1 size-7 fill-current"/></span>
                                    </span>
                                    <span class="absolute left-4 top-4 bg-[#d8b878] px-3 py-1.5 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#10233f] shadow-sm">À la une</span>
                                </a>
                                <div class="flex flex-col border-t-2 border-primary px-6 py-7 sm:px-8 sm:py-8 md:border-l-2 md:border-t-0 lg:px-9 lg:py-9">
                                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">
                                        <span class="text-primary">{{ featured.category ? featured.category.name : 'Vidéo' }}</span>
                                        <span class="h-px w-4 bg-border" aria-hidden="true"></span>
                                        <time datetime="{{ featured.publishedAt|date('Y-m-d') }}">{{ featured.publishedAt|format_datetime(pattern='d MMMM Y') }}</time>
                                    </div>
                                    <h3 class="mt-4 line-clamp-3 text-2xl font-semibold leading-tight tracking-[-0.035em] text-card-foreground sm:text-3xl"><a href="{{ path('web_videos_detail', {slug: featured.slug}) }}" class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ featured.title }}</a></h3>
                                    {% if featured.excerpt %}<p class="mt-4 line-clamp-3 text-sm leading-6 text-muted-foreground">{{ featured.excerpt }}</p>{% endif %}
                                    <a href="{{ path('web_videos_detail', {slug: featured.slug}) }}" class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-primary transition-colors hover:text-primary/75 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Regarder la vidéo <twig:ux:icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true"/></a>
                                </div>
                            </div>
                        </article>
                    {% endif %}

                    {% if secondary is not empty %}
                        <section class="mt-14" aria-labelledby="video-list-title">
                            <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border pb-4">
                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">À découvrir</p>
                                    <h3 id="video-list-title" class="mt-2 text-2xl font-semibold tracking-[-0.035em] text-foreground sm:text-3xl">Autres vidéos</h3>
                                </div>
                            </div>
                            <div class="mt-6 grid gap-x-8 gap-y-12 sm:grid-cols-2">
                                {% for video in secondary %}
                                    {% set thumbnail = thumbnailUrls[video.id]|default(default_image_url) %}
                                    <article class="group min-w-0 border-t border-border pt-5 sm:pt-6">
                                        <a href="{{ path('web_videos_detail', {slug: video.slug}) }}" class="relative block aspect-video overflow-hidden rounded-xl bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label="Regarder la vidéo : {{ video.title }}">
                                            <img src="{{ thumbnail }}" alt="Miniature de {{ video.title }}" class="size-full object-cover transition duration-500 group-hover:scale-[1.025]">
                                            <span class="absolute inset-0 flex items-center justify-center bg-[#10233f]/0 transition duration-500 group-hover:bg-[#10233f]/20" aria-hidden="true"><span class="flex size-11 items-center justify-center rounded-full bg-[#10233f]/90 text-[#f1d59b] shadow-sm transition duration-300 group-hover:scale-105"><twig:ux:icon name="lucide:play" class="ml-0.5 size-4 fill-current"/></span></span>
                                        </a>
                                        <div class="mt-4 flex items-center gap-2 text-xs font-medium uppercase tracking-[0.13em] text-muted-foreground">
                                            <span class="text-primary">{{ video.category ? video.category.name : 'Vidéo' }}</span>
                                            <span class="h-px w-4 bg-border" aria-hidden="true"></span>
                                            <time datetime="{{ video.publishedAt|date('Y-m-d') }}">{{ video.publishedAt|format_datetime(pattern='d MMMM Y') }}</time>
                                        </div>
                                        <h4 class="mt-2 line-clamp-3 text-xl font-semibold leading-tight tracking-[-0.03em] text-card-foreground"><a href="{{ path('web_videos_detail', {slug: video.slug}) }}" class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{{ video.title }}</a></h4>
                                        {% if video.excerpt %}<p class="mt-2 line-clamp-2 text-sm leading-6 text-muted-foreground">{{ video.excerpt }}</p>{% endif %}
                                        <a href="{{ path('web_videos_detail', {slug: video.slug}) }}" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primary/75 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Regarder la vidéo <twig:ux:icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true"/></a>
                                    </article>
                                {% endfor %}
                            </div>
                        </section>
                    {% elseif not featured %}
                        <section class="border-b border-border px-6 py-20 text-center" aria-labelledby="videos-empty-title">
                            <twig:ux:icon name="lucide:play-square" class="mx-auto size-10 text-muted-foreground" aria-hidden="true"/>
                            <h3 id="videos-empty-title" class="mt-4 text-lg font-semibold text-foreground">{{ selectedCategory ? 'Aucune vidéo disponible dans cette catégorie.' : 'Aucune vidéo publiée' }}</h3>
                            <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted-foreground">Les prochaines publications vidéo du Barreau apparaîtront ici.</p>
                        </section>
                    {% endif %}

                    <div class="mt-10 border-t border-border pt-1">
                        {% include 'shared/views/_list_pagination.html.twig' with {pager: videos, route: 'web_videos_list'} only %}
                    </div>
                </section>
            </div>
        </div>
    </main>
{% endblock %}
